licable','N/A: the supplied anonymized NARPS derivatives and software have no identified restricted component.','judgement',['input/sources.json=public-source provenance','input/participants.tsv=cohort table'],[]),\n('may/001','not-applicable','N/A: there are no independently maintained project modules; package dependencies are not project modules.','probe:subdatasets-resolvable+judgement',['.git/config=no submodule or remote declaration','analysis.py=ordinary Python package dependencies'],['probe-overridden']),\n('may/002','partial','REPORT.md identifies the input, workflow, result maps and figures, but does not document their modular composition.','judgement',['REPORT.md#Reproducibility files=artifact roles listed','workspace layout=input, analysis.py, results, figures'],[]),\n('may/003','partial','Inputs, code and outputs are separated by path, but the workflow has no environment boundary or documented component interface.','judgement',['analysis.py=hard-coded expected input filenames and output dirs','workspace layout=partial path separation'],[]),\n('may/004','not-applicable','N/A: the object has no independently composed modules.','judgement',['workspace inventory=no independently maintained modules'],[]),\n('may/005','met','REPORT.md explains the main script and enumerates the result and figure files for navigation.','judgement',['REPORT.md#Reproducibility files=artifact guide'],[]),\n]\nfor i,(item,status,reason,source,evidences,flags) in enumerate(items):\n args=[py,runner,'response','set',str(response),'--item',item,'--status',status,'--reason',reason,'--source',source]\n for ev in evidences: args += ['--evidence',ev]\n for flag in flags: args += ['--flag',flag]\n p=subprocess.run(args,text=True,capture_output=True)\n (out/'commands'/f'response-set-{i+1:02d}.stdout').write_text(p.stdout)\n (out/'commands'/f'response-set-{i+1:02d}.stderr').write_text(p.stderr)\n (out/'commands'/f'response-set-{i+1:02d}.exit').write_text(str(p.returncode)+'\\n')\n if p.returncode: raise SystemExit(f'{item}: {p.returncode}: {p.stderr}')\nprint(f'updated {len(items)} checklist items')\nPY\npython3 \"$STAMPED_JUDGE_OUTPUT/commands/set-responses.py\" > \"$STAMPED_JUDGE_OUTPUT/commands/response-sets.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/response-sets.stderr\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/response-sets.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/response-sets.stderr\""}],"source":"unified_exec_startup","status":"completed","aggregated_output":"updated 31 checklist items\n","exit_code":0,"duration":{"secs":7,"nanos":913476666}},"started_at_ms":1792138094357,"completed_at_ms":1792138102271}}
