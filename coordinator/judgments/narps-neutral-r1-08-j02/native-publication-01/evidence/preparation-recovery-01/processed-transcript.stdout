e-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--skip {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--check-remote] [--allow GLOB [GLOB ...]]\n                     [--kind {dataset,component,study,skill}] [--overwrite]\n                     [--quiet]\n                     path\nrun_probes.py: error: unrecognized arguments: --path\n","exit_code":0,"duration":{"secs":0,"nanos":113763417}},"started_at_ms":1792137965864,"completed_at_ms":1792137965978}}
