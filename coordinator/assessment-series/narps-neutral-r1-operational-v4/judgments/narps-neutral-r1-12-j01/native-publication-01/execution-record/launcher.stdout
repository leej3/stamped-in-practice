under the required whole-brain criterion.'\nstarts=[]\nfor q in (q1,q2):\n found=[i+1 for i,l in enumerate(lines) if q in l]\n if len(found)\"'!=1: raise SystemExit(f'\"'quote match count {len(found)}: {q}')\n starts.append(found[0])\nrecord={'schema_version':1,'delivery_capture_sha256':'783faf61b2b84a56c1a82f46c5dceb88ecba15be11981f2c55870311f89e09c9','scientific_adequacy':'supported','report':{'path':'assessment-report.md','sha256':hashlib.sha256(p.read_bytes()).hexdigest()},'adequacy_evidence':{'quote':q2,'start_line':starts[1],'end_line':starts[1]},'hypothesis_conclusion':{'quote':q1,'start_line':starts[0],'end_line':starts[0]}}\n(out/'scientific-judgment.json').write_text(json.dumps(record,indent=2)+'\\\\n')\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\" validate scientific-judgment.json --workspace \"$STAMPED_JUDGE_OUTPUT\" --delivery-manifest \"$STAMPED_DELIVERY_MANIFEST\" > \"$STAMPED_JUDGE_OUTPUT/scientific-judgment-validate.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/scientific-judgment-validate.stderr\"; printf '\"'scientific_validate_exit=%s\\\\n' \\\"\"'$?\"; cat \"$STAMPED_JUDGE_OUTPUT/scientific-judgment-validate.stdout\" \"$STAMPED_JUDGE_OUTPUT/scientific-judgment-validate.stderr\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
