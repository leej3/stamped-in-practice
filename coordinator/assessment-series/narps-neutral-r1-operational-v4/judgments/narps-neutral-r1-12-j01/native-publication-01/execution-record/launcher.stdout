{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"sed -n '200,275p' \\\"\"'$STAMPED_ASSESSMENT_SOURCE/skills/assess-alignment-with-stamped-principles/scripts/fresh_rerun.py\"; \"$STAMPED_ASSESSMENT_PYTHON\" - <<'\"'PY'\nimport json,os\np=os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'response.json')\nd=json.load(open(p));d['assessor']['dependencies']=['assess-alignment-with-stamped-principles@0.1.0','stamped-conventions@0.1.0'];open(p,'w').write(json.dumps(d,indent=2)+'\\\\n')\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response validate \"$STAMPED_JUDGE_OUTPUT/response.json\" > \"$STAMPED_JUDGE_OUTPUT/response-validate.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/response-validate.stderr\"; printf '\"'validate_exit=%s\\\\n' \\\"\"'$?\"; cat \"$STAMPED_JUDGE_OUTPUT/response-validate.stdout\" \"$STAMPED_JUDGE_OUTPUT/response-validate.stderr\"; \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response encode \"$STAMPED_JUDGE_OUTPUT/response.json\" > \"$STAMPED_JUDGE_OUTPUT/checklist-url.txt\" 2> \"$STAMPED_JUDGE_OUTPUT/response-encode.stderr\"; printf '\"'encode_exit=%s\\\\n' \\\"\"'$?\"; cat \"$STAMPED_JUDGE_OUTPUT/response-encode.stderr\"; head -c 240 \"$STAMPED_JUDGE_OUTPUT/checklist-url.txt\"; printf '\"'\\\\n'\"","aggregated_output":"                out[relpath] = _sha256(path)\n    return out\n\n\ndef _numeric_close(a: pathlib.Path, b: pathlib.Path, rtol: float) -> bool | None:\n    \"\"\"Compare numeric cells relatively, labels exactly, and missingness explicitly.\"\"\"\n    def parse(path: pathlib.Path) -> list[list[str]] | None:\n        try:\n            with path.open(newline=\"\") as stream:\n                return list(csv.reader(stream, delimiter=\"\\t\" if path.suffix == \".tsv\" else \",\"))\n        except (OSError, UnicodeError, csv.Error):\n            return None\n\n    rows_a, rows_b = parse(a), parse(b)\n    if rows_a is None or rows_b is None or len(rows_a) != len(rows_b):\n        return None\n    for ra, rb in zip(rows_a, rows_b):\n        if len(ra) != len(rb):\n            return None\n        for text_a, text_b in zip(ra, rb):\n            if text_a == text_b:\n                continue\n            try:\n                va, vb = float(text_a), float(text_b)\n            except ValueError:\n                return False\n            if math.isnan(va) and math.isnan(vb):\n                continue\n            if not math.isclose(va, vb, rel_tol=rtol, abs_tol=0.0):\n                return False\n    return True\n\n\ndef main(argv: list[str] | None = None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    source = ap.add_mutually_exclusive_group(required=True)\n    source.add_argument(\"--url\", help=\"published location to clone from (what D.1 promises)\")\n    source.add_argument(\"--path\", help=\"local path to clone from (indicative only: does not test D.1)\")\n    ap.add_argument(\"--entry\", help=\"command to run (default: datalad rerun, else make)\")\n    ap.add_argument(\"--outputs\", nargs=\"+\", required=True,\n                    help=\"explicit generated-output glob(s) to compare; selected files are removed before replay\")\n    ap.add_argument(\"--in-container\", dest=\"container\", help=\"apptainer/singularity image to run --entry inside\")\n    ap.add_argument(\"--rtol\", type=float, default=1e-6, help=\"relative tolerance for tables\")\n    ap.add_argument(\"--workdir\", type=pathlib.Path, help=\"keep the clone here instead of a temp dir\")\n    ap.add_argument(\"--timeout\", type=int, default=7200)\n    ap.add_argument(\"--keep-outputs\", action=\"store_true\",\n                    help=\"do not delete the shipped outputs before the rerun (for an entry point that \"\n                         \"regenerates them in place); by default they are removed so that only \"\n                         \"re-creation counts as reproduction\")\n    ap.add_argument(\"--max-get-gb\", type=float, default=5.0,\n                    help=\"skip the up-front content fetch when it would exceed this (default 5 GiB); \"\n                         \"a module of a container registry can be hundreds of GB\")\n    ap.add_argument(\"-o\", \"--output\", type=pathlib.Path)\n    args = ap.parse_args(argv)\n    if any(not pattern.strip() for pattern in args.outputs):\n        ap.error(\"--outputs requires nonempty generated-output selections\")\n    if not math.isfinite(args.rtol) or args.rtol < 0:\n        ap.error(\"--rtol must be finite and nonnegative\")\n\n    base = args.workdir or pathlib.Path(tempfile.mkdtemp(prefix=\"stamped-fresh-rerun-\"))\n    base.mkdir(parents=True, exist_ok=True)\n    clone = base / \"clone\"\n    report: dict = {\n        \"probe\": \"fresh-rerun\",\n        \"items\": ITEMS,\n        \"source\": args.url or args.path,\n        \"started_at\": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec=\"seconds\"),\n        \"host\": {\"uname\": \" \".join(_run([\"uname\", \"-a\"])[1].split()[:6]),\n                 \"datalad\": bool(shutil.which(\"datalad\")),\n                 \"container_runtime\": shutil.which(\"apptainer\") or shutil.which(\"singularity\")},\n        \"steps\": [],\n    }\n\n    def step(name: str, code: int, log: str) -> None:\n        report[\"steps\"].append({\"step\": name, \"returncode\": code, \"log\": log[-4000:]})\n\nvalidate_exit=0\nok: 31 answers against checklist 0.3.1\n✔ The default environment has been installed.\nencode_exit=0\n✔ The default environment has been installed.\nhttps://checklist.stamped-principles.org/?checklist=0.3.1&responses_version=0.3.1&cols=auto&sections=off&format=3&responses=eyJjaGVja2xpc3RfdmVyc2lvbiI6IjAuMy4xIiwicmVzcG9uc2VzIjp7InN0YW1wZWQtY2hlY2tsaXN0Om11c3QvMDAxIjp7InZhbHVlIjoieWVzIiwi\n","exit_code":0,"status":"completed"}}
