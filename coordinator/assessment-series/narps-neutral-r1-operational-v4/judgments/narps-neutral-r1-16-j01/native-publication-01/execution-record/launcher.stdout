.json')).write_text(json.dumps(args,indent=2)+'\\\\n')\n pathlib.Path(str(base)+'.stdout').write_text(p.stdout); pathlib.Path(str(base)+'.stderr').write_text(p.stderr); pathlib.Path(str(base)+'.exit').write_text(str(p.returncode)+'\\\\n')\n if p.returncode: print('FAILED',n,p.returncode,p.stderr); sys.exit(p.returncode)\nprint('items_set',len(items),'access_reachable',access['reachable'],'access_unavailable',access['unavailable'])\nPY\nSTAMPED_JUDGE_OUTPUT=\\\"\"'$STAMPED_JUDGE_OUTPUT\" STAMPED_JUDGE_TARGET=\"$STAMPED_JUDGE_TARGET\" STAMPED_ASSESSMENT_RUNNER=\"$STAMPED_ASSESSMENT_RUNNER\" STAMPED_ASSESSMENT_PYTHON=\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_JUDGE_OUTPUT/commands/finalize-assessment.py\" > \"$STAMPED_JUDGE_OUTPUT/commands/finalize-assessment.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/finalize-assessment.stderr\"\nrc=$?; echo \"$rc\" > \"$STAMPED_JUDGE_OUTPUT/commands/finalize-assessment.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/finalize-assessment.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/finalize-assessment.stderr\"; exit \"$rc\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
