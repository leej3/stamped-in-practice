{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'set +e\nGIT_OPTIONAL_LOCKS=0 git -C \"$STAMPED_JUDGE_TARGET\" status --porcelain=v1 --untracked-files=all > \"$STAMPED_JUDGE_OUTPUT/commands/git-status.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/git-status.stderr\"; echo \"$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/git-status.exit\"\nGIT_OPTIONAL_LOCKS=0 git -C \"$STAMPED_JUDGE_TARGET\" ls-files --stage > \"$STAMPED_JUDGE_OUTPUT/commands/git-ls-files.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/git-ls-files.stderr\"; echo \"$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/git-ls-files.exit\"\nGIT_OPTIONAL_LOCKS=0 git -C \"$STAMPED_JUDGE_TARGET\" log -1 --format='\"'%H%n%cs%n%s' > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/git-head.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/git-head.stderr\"; echo \"$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/git-head.exit\"\n\"$STAMPED_ASSESSMENT_PYTHON\" - \"$STAMPED_DELIVERY_MANIFEST\" \"$STAMPED_JUDGE_TARGET\" <<'\"'PY' > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/evidence-index.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/evidence-index.stderr\"\nimport json,sys,pathlib,hashlib\nD=json.load(open(sys.argv[1])); root=pathlib.Path(sys.argv[2]); lookup={e['\"'path'].removeprefix('content/workspace/'):e for e in D['entries'] if e.get('kind') in ('file','symlink')}\nfor p in ['report.md','analysis/group_analysis.py','analysis/restore_maps.py','input/upstream-methods.md','input/study-task.md','input/sources.json','input/participants.tsv','results/summary.json','results/map_qc.csv','results/fwe_positive_voxels.csv','results/vmPFC_proxy_participant_estimates.csv','figures/whole_brain_results.png','figures/vmPFC_proxy_participants.png','.git/config','.git/HEAD','.git/index']:\n e=lookup.get(p); f=root/p\n print(p,'canonical=',e,'actual_sha256=',hashlib.sha256(f.read_bytes()).hexdigest() if f.is_file() and not f.is_symlink() else None,'symlink=',f.is_symlink())\nPY\necho \\\"\"'$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/evidence-index.exit\"\nprintf '\"'%s\\\\n' '---status---'; cat \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/git-status.stdout\"; printf '\"'%s\\\\n' '---head---'; cat \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/git-head.stdout\"; printf '\"'%s\\\\n' '---tracked relevant---'; rg '(\"'^|/)(README|report|analysis|results|figures|input/(sources|participants|study-task|upstream-methods))'\"' \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/git-ls-files.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/evidence-index.stdout\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
