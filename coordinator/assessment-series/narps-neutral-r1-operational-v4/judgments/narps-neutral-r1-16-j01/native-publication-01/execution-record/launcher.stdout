{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat > \"$STAMPED_JUDGE_OUTPUT/commands/finalize-assessment.py\" <<'\"'PY'\nimport concurrent.futures, hashlib, json, os, pathlib, subprocess, sys, urllib.request, urllib.parse\nout=pathlib.Path(os.environ['STAMPED_JUDGE_OUTPUT']); target=pathlib.Path(os.environ['STAMPED_JUDGE_TARGET']); runner=os.environ['STAMPED_ASSESSMENT_RUNNER']; py=os.environ['STAMPED_ASSESSMENT_PYTHON']; capture_sha='1bc0f46ef4ad58e9f70bb654d761eb330f15d1c87929ad165d414907dd7d0f68'\n# Record a current check of every declared map route without fetching payload bytes.\ns=json.load(open(target/'input/sources.json')); urls=[(k,v['url']) for k,v in s['files'].items() if isinstance(v,dict) and v.get('url')]\ndef check(item):\n k,url=item; req=urllib.request.Request(url,method='HEAD',headers={'User-Agent':'STAMPED-independent-assessment/1.0'})\n try:\n  with urllib.request.urlopen(req,timeout=25) as r: return {'artifact':k,'host':urllib.parse.urlparse(url).netloc,'status':r.status,'final_host':urllib.parse.urlparse(r.geturl()).netloc,'content_length':r.headers.get('Content-Length'),'result':'reachable'}\n except Exception as e:return {'artifact':k,'host':urllib.parse.urlparse(url).netloc,'result':'unavailable','error':type(e).__name__+': '+str(e)}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as ex: rows=list(ex.map(check,urls))\naccess={'intended_recipient':'Researcher using the declared authorized route with the report/scripts and source manifest','declared_route':'analysis/restore_maps.py reads NeuroVault URLs in input/sources.json, verifies the expected byte count and SHA-256, and supplies the maps consumed by analysis/group_analysis.py','required_artifact_coverage':'54 participant gain-effect COPE maps; the route does not publish the complete report, code, results or environment','test':'HTTP HEAD request to every declared map URL; no payload fetched','tested_host_scope':s