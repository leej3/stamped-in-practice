{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'set +e\n\"$STAMPED_ASSESSMENT_PYTHON\" - \"$STAMPED_JUDGE_TARGET/input/sources.json\" \"$STAMPED_JUDGE_OUTPUT/access-record.json\" <<'\"'PY' > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/access-check.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/access-check.stderr\"\nimport concurrent.futures,json,sys,time,urllib.request,urllib.error,urllib.parse\nsource,out=sys.argv[1:]\ns=json.load(open(source)); urls=[(k,v['\"'url']) for k,v in s['files'].items() if isinstance(v,dict) and v.get('url')]\ndef check(item):\n k,url=item; req=urllib.request.Request(url,method='HEAD',headers={'User-Agent':'STAMPED-independent-assessment/1.0'})\n try:\n  with urllib.request.urlopen(req,timeout=25) as r: return {'artifact':k,'host':urllib.parse.urlparse(url).netloc,'status':r.status,'final_host':urllib.parse.urlparse(r.geturl()).netloc,'content_length':r.headers.get('Content-Length'),'result':'reachable'}\n except Exception as e: return {'artifact':k,'host':urllib.parse.urlparse(url).netloc,'result':'unavailable','error':type(e).__name__+': '+str(e)}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as ex: rows=list(ex.map(check,urls))\nrecord={'intended_recipient':'Researcher using the documented analysis entrypoint and input/sources.json','declared_route':'analysis/restore_maps.py reads NeuroVault URLs in input/sources.json, verifies expected byte counts and SHA-256, then analysis/group_analysis.py consumes the maps','required_artifact_coverage':'54 participant gain-effect COPE maps; cohort metadata and scripts remain in the delivery','test':'HTTP HEAD request for each declared NeuroVault map URL; no payload fetched by this check','tested_host_scope':sorted(set(r['host'] for r in rows)),'results':rows,'reachable':sum(r['result']=='reachable' for r in rows),'unavailable':sum(r['result']=='unavailable' for r in rows)}\njson.dump(record,open(out,'w'),indent=2); print('tested',len(rows),'reachable',record['reachable'],'unavailable',record['unavailable']);\nfor r in rows:\n if r['result']\"'!='\"'reachable': print(r)\nPY\nrc=\"'$?; echo \"$rc\" > \"$STAMPED_JUDGE_OUTPUT/commands/access-check.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/access-check.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/access-check.stderr\"; printf '\"'exit=%s\\\\n' \\\"\"'$rc\";'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
