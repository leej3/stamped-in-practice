{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/bash -lc '\"$STAMPED_ASSESSMENT_PYTHON\" - \"$STAMPED_DELIVERY_MANIFEST\" \"$STAMPED_OPERATIONAL_MANIFEST\" \"$STAMPED_JUDGE_TARGET\" <<'\"'PY' > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stderr\"\nimport hashlib,json,os,stat,sys\nfrom pathlib import Path\ncp,op,root=map(Path,sys.argv[1:]); c=json.load(open(cp)); o=json.load(open(op)); print('\"'canonical_manifest_sha256',hashlib.sha256(cp.read_bytes()).hexdigest()); print('operational_manifest_sha256',hashlib.sha256(op.read_bytes()).hexdigest()); print('manifests_equal',cp.read_bytes()==op.read_bytes());\nce={e['path']:e for e in c['entries'] if e['path'].startswith('content/workspace/')}; oe={e['path']:e for e in o['entries'] if e['path'].startswith('content/workspace/')}; print('canonical_entries',len(ce),'operational_entries',len(oe),'path_sets_equal',set(ce)==set(oe)); mismatch=[]; allowed=[]\nfor path,e in ce.items():\n p=root/Path(path).relative_to('content/workspace')\n try: st=p.lstat()\n except FileNotFoundError: mismatch.append((path,'missing')); continue\n if e['kind']=='directory': kind='directory'; mode=stat.S_IMODE(st.st_mode)\n elif stat.S_ISLNK(st.st_mode): kind='symlink'; mode=stat.S_IMODE(st.st_mode)\n elif stat.S_ISREG(st.st_mode): kind='file'; mode=stat.S_IMODE(st.st_mode)\n else: kind='other'; mode=stat.S_IMODE(st.st_mode)\n if kind\"'!=e['\"'kind'] or mode\"'!=e['\"'mode']:\n  mismatch.append((path,'type/mode',e['kind'],e['mode'],kind,mode)); continue\n if kind=='file':\n  h=hashlib.sha256(p.read_bytes()).hexdigest()\n  if h\"'!=e.get('\"'sha256'):\n   item=(path,'sha256',e.get('sha256'),h)\n   if path in {'content/workspace/.git/annex/keysdb/db','content/workspace/.git/annex/keysdb/db-shm','content/workspace/.git/annex/keysdb/db-wal'}: allowed.append(item)\n   else: mismatch.append(item)\n elif kind=='symlink':\n  target=os.readlink(p)\n  if target\"'!=e.get('\"'target'): mismatch.append((path,'symlink-target',e.get('target'),target))\nextra=set(oe)-set(ce); print('extra_entries',sorted(extra)[:20], 'count',len(extra)); print('nonmetadata_mismatches',len(mismatch));\nfor m in mismatch[:100]: print('MISMATCH',m)\nprint('allowed_metadata_deltas',allowed)\nPY\necho \\\"\"'$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stderr\";'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
