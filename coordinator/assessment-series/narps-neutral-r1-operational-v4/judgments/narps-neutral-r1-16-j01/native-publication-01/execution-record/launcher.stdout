{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/opt/homebrew/bin/bash -lc '\"$STAMPED_ASSESSMENT_PYTHON\" - \"$STAMPED_DELIVERY_MANIFEST\" \"$STAMPED_OPERATIONAL_MANIFEST\" \"$STAMPED_JUDGE_TARGET\" \"$STAMPED_JUDGE_OUTPUT\" <<'\"'PY' > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/final-state-check.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/final-state-check.stderr\"\nimport hashlib,json,os,stat,sys\nfrom pathlib import Path\ncp,op,root,out=map(Path,sys.argv[1:]); c=json.load(open(cp)); o=json.load(open(op)); ce={e['\"'path']:e for e in c['entries'] if e['path'].startswith('content/workspace/')}; oe={e['path']:e for e in o['entries'] if e['path'].startswith('content/workspace/')}; bad=[]; allowed=[]\nfor path,e in ce.items():\n p=root/Path(path).relative_to('content/workspace')\n try:st=p.lstat()\n except FileNotFoundError:bad.append([path,'missing']);continue\n if stat.S_ISDIR(st.st_mode):kind='directory'\n elif stat.S_ISLNK(st.st_mode):kind='symlink'\n elif stat.S_ISREG(st.st_mode):kind='file'\n else:kind='other'\n if kind\"'!=e['\"'kind'] or stat.S_IMODE(st.st_mode)\"'!=e['\"'mode']:bad.append([path,'type/mode']);continue\n if kind=='file' and hashlib.sha256(p.read_bytes()).hexdigest()\"'!=e.get('\"'sha256'):\n  item=[path,'sha256',e.get('sha256'),hashlib.sha256(p.read_bytes()).hexdigest()]\n  if path in {'content/workspace/.git/annex/keysdb/db','content/workspace/.git/annex/keysdb/db-shm','content/workspace/.git/annex/keysdb/db-wal'}:allowed.append(item)\n  else:bad.append(item)\n if kind=='symlink' and os.readlink(p)\"'!=e.get('\"'target'):bad.append([path,'symlink'])\naccess=json.load(open(out/'access-record.json')); response=json.load(open(out/'response.json')); sci=json.load(open(out/'scientific-judgment.json'))\nprint('canonical_capture_sha256',hashlib.sha256(cp.read_bytes()).hexdigest());print('operational_manifest_identical',cp.read_bytes()==op.read_bytes());print('captured_head',c['head_commit']);print('worker_stop_capture_sha256',json.load(open(os.environ['STAMPED_WORKER_STOP_RECEIPT']))['capture']['sha256']);print('nonmetadata_mismatches',len(bad));print('allowed_operational_metadata_deltas',allowed);print('access_routes_reachable',access['reachable'],'/',len(access['results']));print('response_capture',response['object'].get('capture'));print('response_commit',response['object'].get('commit'));print('scientific_record_capture',sci['delivery_capture_sha256']);print('scientific_adequacy',sci['scientific_adequacy']);print('unrecorded_response_items',[k for k,v in response['responses'].items() if v['status']=='not-checked']);\nfor x in bad:print('MISMATCH',x)\nPY\necho \\\"\"'$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/final-state-check.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/final-state-check.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/final-state-check.stderr\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
