{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'set +e\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" --help > \"$STAMPED_JUDGE_OUTPUT/commands/runner-help.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/runner-help.stderr\"\nprintf '\"'%s\\\\n' \\\"\"'$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/runner-help.exit\"\n\"$STAMPED_ASSESSMENT_PYTHON\" - \"$STAMPED_DELIVERY_MANIFEST\" \"$STAMPED_OPERATIONAL_MANIFEST\" \"$STAMPED_JUDGE_TARGET\" <<'\"'PY' > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/manifest-summary.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/manifest-summary.stderr\"\nimport json, pathlib, sys\nfor p in sys.argv[1:3]:\n d=json.load(open(p)); print(p, '\"'keys=',list(d)); print('capture=',d.get('capture_sha256') or d.get('delivery_capture_sha256'),'head=',d.get('head') or d.get('captured_head'),'entry_count=',len(d.get('entries',[])))\nfor p in ['.','input','output','results','reports','src','code']:\n q=pathlib.Path(sys.argv[3])/p\n if q.exists(): print('DIR',p)\nroot=pathlib.Path(sys.argv[3]);\nfor x in sorted(root.rglob('*')):\n rel=x.relative_to(root)\n if '.git' in rel.parts or '.entire' in rel.parts: continue\n if x.is_file() or x.is_symlink(): print(('LINK ' if x.is_symlink() else 'FILE ')+str(rel))\nPY\nprintf '%s\\\\n' \\\"\"'$?\" > \"$STAMPED_JUDGE_OUTPUT/commands/manifest-summary.exit\"\ncat \"$STAMPED_JUDGE_OUTPUT/commands/runner-help.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/manifest-summary.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/manifest-summary.stderr\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
