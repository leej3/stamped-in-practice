{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY'\nimport json,os\np=os.environ['STAMPED_JUDGE_TARGET']+'/input/sources.json'; d=json.load(open(p)); print('keys', sorted(d));\nfor k,v in d.items():\n if isinstance(v,dict):\n  print(k, {x:v[x] for x in v if x not in ('files','sources')});\n  if isinstance(v.get('files'),dict): print('file_count',len(v['files']),'first',next(iter(v['files'].items())))\n  if isinstance(v.get('sources'),dict): print('sources',v['sources'])\nPY\nGIT_OPTIONAL_LOCKS=0 git -C \\\"\"'$STAMPED_JUDGE_TARGET\" remote -v; cat \"$STAMPED_JUDGE_TARGET/references/nilearn/README.md\"; ls -l \"$STAMPED_JUDGE_TARGET/input/data\" | head -6'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
