{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat > \"$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.py\" <<'\"'PY'\nimport hashlib,json,os,stat\nfrom pathlib import Path\nroot=Path(os.environ['STAMPED_JUDGE_TARGET'])\nmanifest=json.load(open(os.environ['STAMPED_OPERATIONAL_MANIFEST']))\nexpected={x['path'].removeprefix('content/workspace/'):x for x in manifest['entries'] if x['path'].startswith('content/workspace/')}\nactual=set()\nfor base,dirs,files in os.walk(root,followlinks=False):\n    bp=Path(base)\n    for name in list(dirs)+files:\n        p=bp/name\n        rel=p.relative_to(root).as_posix()\n        actual.add(rel)\nmissing=sorted(set(expected)-actual)\nextra=sorted(actual-set(expected))\nchanged=[]; metadata=[]\nfor rel,row in expected.items():\n    p=root/rel\n    if not p.exists() and not p.is_symlink():\n        continue\n    st=p.lstat(); mode=stat.S_IMODE(st.st_mode)\n    kind='symlink' if stat.S_ISLNK(st.st_mode) else 'directory' if stat.S_ISDIR(st.st_mode) else 'file' if stat.S_ISREG(st.st_mode) else 'other'\n    diffs=[]\n    if kind \"'!= row['\"'kind']: diffs.append(f\\\"kind {row['kind']}->{kind}\\\")\n    if mode \"'!= row['\"'mode']: diffs.append(f\\\"mode {row['mode']}->{mode}\\\")\n    if kind=='symlink':\n        if os.readlink(p) \"'!= row.get('\"'link_target'): diffs.append('link target changed')\n    elif kind=='file':\n        h=hashlib.sha256()\n        with p.open('rb') as f:\n            for chunk in iter(lambda:f.read(1<<20),b''): h.update(chunk)\n        if h.hexdigest()\"'!=row.get('\"'sha256'): diffs.append(f\\\"sha256 {row.get('sha256')}->{h.hexdigest()}\\\")\n    if diffs:\n        record={'path':rel,'differences':diffs}\n        if (rel in ('.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal') and kind=='file'):\n            metadata.append(record)\n        else: changed.append(record)\nresult={'canonical_manifest_sha256':manifest.get('sha256'),'operational_manifest_entries':len(expected),'missing_paths':missing,'extra_paths':extra,'non_metadata_changes':changed,'annex_keysdb_regular_file_changes':metadata,'integrity':'match except classified annex keysdb regular-file changes' if not (missing or extra or changed) else 'mismatch'}\nout=Path(os.environ['STAMPED_JUDGE_OUTPUT'])/'operational-integrity.json'; out.write_text(json.dumps(result,indent=2)+'\\\\n'); print(json.dumps(result,indent=2))\nPY\nprintf '%s\\\\n' 'python3 \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.py\"'\"' > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.command.txt\"; python3 \"$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.py\" > \"$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.stdout.txt\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.stderr.txt\"; rc=$?; printf '\"'%s\\\\n' \\\"\"'$rc\" > \"$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.stdout.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/verify_operational_integrity.stderr.txt\"; exit \"$rc\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
