{\n                    \"principle_codes\": [\"T.1\", \"T.3\", \"T.5\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:must/004\",\n                            \"text\": \"Are version control systems such as `Git` used for code, text, documentation, and configuration files?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/005\",\n                            \"text\": \"Are version control systems such as `git-annex`, DataLad, or `Git` LFS used for large binary data?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/006\",\n                            \"text\": \"Are the exact environment specifications used to generate a set of results included in the provenance records to link computational actions to particular environments?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"A.1\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:must/007\",\n                            \"text\": \"Is a `README.md` or `Makefile` included with instructions for installation and usage?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/008\",\n                            \"text\": \"Is there a clear starting point for users to start reproducing results (e.g., a main script, a workflow definition, or a container image)?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"P.1\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:must/009\",\n                            \"text\": \"Are relative paths used in scripts, avoiding hardcoded or system-specific paths like `C:\\\\Users\\\\...` or `/home/user/...`?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/010\",\n                            \"text\": \"Are all software dependencies included in the environment specification, rather than relying on pre-installed tools?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/011\",\n                            \"text\": \"Have all assumptions about the host system's configuration been documented (e.g., specific OS versions, required system libraries, or environment variables)?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"P.2\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:must/012\",\n                            \"text\": \"Is there a clear list of system requirements and dependencies documented in the README or environment specifications?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"P.3\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:must/013\",\n                            \"text\": \"Are environment specifications (e.g., Dockerfiles, `pyproject.toml`, `package.json`) included in the version control system alongside code and data?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/014\",\n                            \"text\": \"Is there a process for updating environment specifications when dependencies change, and are these updates tracked in version control?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"D.1\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:must/015\",\n                            \"text\": \"Are environment specifications (e.g., container digests, frozen package manifests) included to ensure others can attempt to exactly replicate the environment?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/016\",\n                            \"text\": \"Are environment specifications shared in a way that others can access and use them (e.g., published container images, archived environment files)?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:must/017\",\n                            \"text\": \"Is there documentation on how to obtain and use the environment specifications for reproduction?\"\n                        }\n                    ]\n                }\n            ]\n        },\n        {\n            \"level\": \"should\",\n            \"entries\": [\n                {\n                    \"principle_codes\": [\"T.2\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:should/001\",\n                            \"text\": \"Is a common version control system (e.g., `Git`, DVC, `git-annex`, or DataLad) used across all components?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"A.2\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:should/002\",\n                            \"text\": \"Is the workflow tested regularly to ensure instructions remain accurate?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"M.1\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:should/003\",\n                            \"text\": \"Are raw data, processed data, code, and environment definitions separated into distinct modules?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"M.4\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:should/009\",\n                            \"text\": \"Are restricted data or software kept in their own modules?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"E.1\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:should/004\",\n                            \"text\": \"Is the pipeline tested in a fresh container, batch job, clean virtual machine, or cloud-based instance?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:should/005\",\n                            \"text\": \"Does the workflow spawn disposable environments for each execution, allowing for isolation of runs?\"\n                        }\n                    ]\n                },\n                {\n                    \"principle_codes\": [\"D.2\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:should/006\",\n                            \"text\": \"Are the exact environment specifications used to generate a specific set of results regularly tested to ensure they can be reconstituted as intended?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:should/007\",\n                            \"text\": \"Are environment artifacts archived within the research object where possible (e.g., executable binaries, container images)?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:should/008\",\n                            \"text\": \"Is there a process for updating environment specifications when dependencies change, and are these updates tracked in version control?\"\n                        }\n                    ]\n                }\n            ]\n        },\n        {\n            \"level\": \"may\",\n            \"entries\": [\n                {\n                    \"principle_codes\": [\"M.2\"],\n                    \"items\": [\n                        {\n                            \"id\": \"stamped-checklist:may/001\",\n                            \"text\": \"Are external datasets or software dependencies included as submodules or linked as submodules?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:may/002\",\n                            \"text\": \"Is the modular structure documented to clarify how components relate and can be recombined?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:may/003\",\n                            \"text\": \"Are modular boundaries defined in a way that allows independent updates without breaking the overall workflow?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:may/004\",\n                            \"text\": \"Is there a clear mechanism for composing modules together (e.g., `git` submodules, or container orchestration)?\"\n                        },\n                        {\n                            \"id\": \"stamped-checklist:may/005\",\n                            \"text\": \"Is there documentation or tooling to support users in understanding and navigating the modular structure?\"\n                        }\n                    ]\n                }\n            ]\n        }\n    ]\n}\n# STAMPED in one screen\n\nNormative text lives in the [paper](https://github.com/stamped-principles/stamped-paper) and in [stamped-principles-schema](https://github.com/stamped-principles/stamped-principles-schema).\nThis card exists so a session can hold the shape of STAMPED without loading either, and so no skill retypes them.\nWhen a judgement turns on wording, open the paper rather than this card.\n\n**A STAMPED research object is one versioned boundary that carries everything needed to re-run its own results.**\n\n| | Principle | Codes in [principles 0.2.0](https://github.com/stamped-principles/stamped-principles-schema/blob/v0.2.0/stamped-principles.json) | The question it answers |\n|---|---|---|---|\n| **S** | Self-contained | S.1 (MUST) | Is everything essential reachable under one top-level root? |\n| **T** | Tracked | T.1, T.3, T.5 (MUST) · T.2, T.4 (SHOULD) | Is every component content-identified, is every change recorded, and do run records name the versions involved? |\n| **A** | Actionable | A.1 (MUST) · A.2 (SHOULD) | Can a reader reproduce the results from the instructions, and are the procedures executable rather than prose? |\n| **M** | Modular | M.1, M.4 (SHOULD) · M.2 (MAY) | Are raw data, derivatives, code and environment separable, recombinable, and separated by access requirements? |\n| **P** | Portable | P.1, P.2, P.3 (MUST) | Does it avoid undocumented host state, specify the environment explicitly, and version-control that specification? |\n| **E** | Ephemeral | E.1 (SHOULD) | Are results produced in disposable environments, one per execution? |\n| **D** | Distributable | D.1 (MUST) · D.2 (SHOULD) | Can others persistently retrieve every referenced component, and rebuild the environment from what is published? |\n\n## What to say instead of restating\n\n- The **principles** are the 17 statements above; quote at most the one code under discussion.\n- The **checklist** is 31 questions derived from them (17 MUST, 9 SHOULD, 5 MAY), pinned at 0.3.1 in `../checklist/stamped-checklist-0.3.1.json` — read ids and text from there.\n- The **web app** at <https://checklist.stamped-principles.org/> is where a person fills or reads a checklist.\n- STAMPED **generalises YODA**: a YODA-shaped DataLad dataset is one way to satisfy it, not the definition. Nothing in these skills is YODA-specific.\n\n## Known drift to be aware of (and not to paper over)\n\n- The paper names **S.2**, **M.3** and **D.3** — all three about licensing; principles-schema 0.2.0 does not carry them, so none of the 31 checklist items asks about a licence.\n  The paper lists 19 principles, the schema 17 ([`docs/stamped/upstream/paper-schema-drift-issue.md`](https://github.com/con/skills/blob/master/docs/stamped/upstream/paper-schema-drift-issue.md) in con/skills has the line numbers; it is not part of an installed copy of this skill).\n  The assessor reports licence findings as an extra item outside the checklist rather than bending an existing id ([`response-format.md`](response-format.md)).\n- **T.4** (\"code-driven provenance SHOULD be recorded programmatically\") exists in the schema but has **no checklist item**.\n  Evidence for it is reported under the T items it supports, with the gap named.\n  The paper's T.4 is one compound statement; the schema splits it into T.4 (SHOULD, programmatic) and **T.5** (MUST, versions recorded), so T.5 has no paper counterpart to cite.\n- **must/014 and should/008 are the same sentence**, word for word: \"Is there a process for updating environment specifications when dependencies change, and are these updates tracked in version control?\" — one as a MUST under P.3, one as a SHOULD under D.2.\n  Answer both, from the same evidence, and say in the report that they are duplicates rather than letting a reader think two different things were checked.\n  Nothing in the checklist explains the duplication; it is in the upstream issue draft.\n- @asmacdo's draft in [stamped-agent-skills](https://github.com/stamped-principles/stamped-agent-skills) cites \"checklist v1.0.1\"; that is the web app's `package.json` version.\n  The checklist's own `checklist_version` is **0.3.1**.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"agent_message","text":"The primary inference is coherent: a positive one-sample group test, whole-brain max‑T FWER correction, a predeclared anatomical proxy, and explicit uncertainty about first-level precision and spatial reference. I’m preparing the single permitted replay against the captured delivery now: the documented absolute Python command, using the already supplied maps and atlas; I’ll compare only the generated numeric summary, participant QC table, and cluster table, with the frozen helper’s stated `1e-6` tolerance for numeric tables."}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'mkdir -p \"$STAMPED_JUDGE_OUTPUT/replay\"; cat > \"$STAMPED_JUDGE_OUTPUT/replay-plan.json\" <<'\"'JSON'\n{\n  \\\"source\\\": \\\"canonical original complete delivery; materialized by the frozen runner from the delivery manifest\\\",\n  \\\"entrypoint\\\": \\\"/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/common-environment/.pixi/envs/default/bin/python analyze.py\\\",\n  \\\"prerequisites\\\": [\n    \\\"The exact interpreter path is the command documented in report.md.\\\",\n    \\\"All input maps and the Harvard-Oxford atlas files are already in the captured delivery; the adapter does not fetch scientific inputs.\\\",\n    \\\"The documented interpreter is available on this assessment host; it is not declared or captured by the worker as a reconstructable environment.\\\"\n  ],\n  \\\"selected_generated_outputs\\\": [\n    \\\"results/results.json\\\",\n    \\\"results/participant_qc.tsv\\\",\n    \\\"results/fwer_positive_clusters.tsv\\\"\n  ],\n  \\\"protected\\\": [\\\"input/**\\\", \\\"source code and configuration\\\", \\\"all unselected existing outputs\\\"],\n  \\\"comparison\\\": {\n    \\\"tsv\\\": \\\"frozen helper numeric-table comparison with relative tolerance 1e-6; includes participant QC and cluster peaks/coordinates\\\",\n    \\\"json\\\": \\\"frozen helper byte-for-byte comparison; deterministic result summary has no timestamps or run-duration fields\\\",\n    \\\"scope_limit\\\": \\\"This selection does not compare full NIfTI maps or figures; preexisting unselected products are not replay evidence.\\\"\n  },\n  \\\"timeout_seconds\\\": 7200,\n  \\\"max_get_gb\\\": 5.0,\n  \\\"attempts\\\": 1\n}\nJSON\ncat > \\\"\"'$STAMPED_JUDGE_OUTPUT/replay.command.txt\" <<'\"'EOF'\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" fresh-rerun --path \"$STAMPED_JUDGE_TARGET\" --entry '\"'/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/common-environment/.pixi/envs/default/bin/python analyze.py' --outputs results/results.json results/participant_qc.tsv results/fwer_positive_clusters.tsv --workdir replay/work -o fresh-rerun.json --rtol 1e-6 --timeout 7200 --max-get-gb 5.0\nEOF\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" fresh-rerun --path \"$STAMPED_JUDGE_TARGET\" --entry '\"'/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/common-environment/.pixi/envs/default/bin/python analyze.py' --outputs results/results.json results/participant_qc.tsv results/fwer_positive_clusters.tsv --workdir replay/work -o fresh-rerun.json --rtol 1e-6 --timeout 7200 --max-get-gb 5.0 > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/replay.stdout.txt\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/replay.stderr.txt\"; rc=$?; printf '\"'%s\\\\n' \\\"\"'$rc\" > \"$STAMPED_JUDGE_OUTPUT/commands/replay.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/replay.stdout.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/replay.stderr.txt\"; exit \"$rc\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
