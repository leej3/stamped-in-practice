nted environment. The access test establishes endpoint reachability only, not the availability or checksum of all 54 maps. Coordinator delivery is excluded as worker publication evidence.\\\"\n}\nEOF\ncat > \\\"\"'$STAMPED_JUDGE_OUTPUT/replay-record.json\" <<'\"'EOF'\n{\n  \\\"schema_version\\\": 1,\n  \\\"status\\\": \\\"not-checked\\\",\n  \\\"attempted\\\": false,\n  \\\"attempt_count\\\": 0,\n  \\\"attempt_limit\\\": 1,\n  \\\"documented_entrypoint\\\": \\\"python analysis/group_analysis.py\\\",\n  \\\"working_directory\\\": \\\"workspace root\\\",\n  \\\"prerequisites\\\": [\n    \\\"Python packages imported by the script: numpy, pandas, nibabel, scipy, nilearn, matplotlib\\\",\n    \\\"Nilearn MNI152 brain mask, Harvard-Oxford atlas and MNI152 template resources used by the script\\\"\n  ],\n  \\\"prerequisite_reason\\\": \\\"No dependency declaration, lockfile, container, or environment reconstruction instructions are present in the worker stop state. The entrypoint also calls Nilearn resource loaders. The common-scope rule does not permit adding missing declarations or inferring a replacement environment.\\\",\n  \\\"selected_generated_outputs\\\": [\n    \\\"results/participant_qc.tsv\\\",\n    \\\"results/permutation_max_t.tsv.gz\\\",\n    \\\"results/mean_gain_effect.nii.gz\\\",\n    \\\"results/tstat_one_sample.nii.gz\\\",\n    \\\"results/p_fwe_maxT.nii.gz\\\",\n    \\\"results/neglog10_p_fwe.nii.gz\\\",\n    \\\"results/fwe_clusters.tsv\\\",\n    \\\"results/summary.json\\\",\n    \\\"results/voxelwise_results_common_mask.tsv.gz\\\",\n    \\\"results/tstat_positive_uncorrected_p05.nii.gz\\\",\n    \\\"results/tstat_fwe_significant.nii.gz\\\",\n    \\\"figures/whole_brain_t_uncorrected.png\\\",\n    \\\"figures/whole_brain_fwe.png\\\",\n    \\\"figures/vmPFC_subject_estimates.png\\\"\n  ],\n  \\\"protection\\\": \\\"Only the listed generated artifacts would be selected for removal in the helper's fresh copy. Inputs, participant metadata, source code and the inspection copy are protected; no replay copy was made because prerequisites were not established.\\\",\n  \\\"comparison_rule_if_replay_were_supported\\\": \\\"Compare scientific numerical outputs with rtol=1e-6; compare the 54 participant identities, mask dimensions, permutation max-T values, voxelwise t/FWE maps and reported vmPFC summary. Treat timestamps, logs, prose, formatting, and random differences separately; the script fixes seed 20261016.\\\",\n  \\\"timeout_seconds\\\": 7200,\n  \\\"max_get_gb\\\": 5.0,\n  \\\"limitation\\\": \\\"Frozen replay helper not invoked; no substitute HEAD-only replay or shipped-output replay is claimed.\\\"\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat > \"$STAMPED_JUDGE_OUTPUT/build_response.py\" <<'\"'PY'\nimport json, os, subprocess, sys\nout=os.environ['STAMPED_JUDGE_OUTPUT']; py=os.environ['STAMPED_ASSESSMENT_PYTHON']; runner=os.environ['STAMPED_ASSESSMENT_RUNNER']; sha='9370db020f9b437ca3a96b2e171d89d3d52cc94554a3d62d23da0b0ca71fcb59'\nitems={\n'must/001':('met','All worker materials are nested in the common workspace root.',['report.md']),\n'must/002':('met','The 54 input maps are linked through the in-boundary annex object store, and cohort metadata is under input/.',['input/sources.json','input/participants.tsv']),\n'must/003':('unmet','The script imports external software packages, but they are neither specified in an environment nor included as submodules.',['analysis/group_analysis.py']),\n'must/004':('unmet','Git is present, but the code, report, results and figures were untracked at worker stop, so version control did not capture the complete delivered work.',['analysis/group_analysis.py','report.md','results/summary.json']),\n'must/005':('met','Git-annex tracks all 54 large participant maps as binary content.',['input/data/sub-001_hypo1_cope.nii.gz','input/sources.json']),\n'must/006':('unmet','No run provenance record names an exact environment used for the reported outputs.',['analysis/group_analysis.py','report.md']),\n'must/007':('unmet','No README.md or Makefile with installation and usage instructions is present; command guidance is in report.md.',['report.md']),\n'must/008':('met','The report identifies the analysis script and gives the command to run it from the workspace.',['report.md','analysis/group_analysis.py']),\n'must/009':('met','The analysis script locates inputs and outputs from its own file path and uses relative project paths.',['analysis/group_analysis.py']),\n'must/010':('unmet','Required Python packages are imported but no environment specification declares them.',['analysis/group_analysis.py']),\n'must/011':('unmet','No host configuration assumptions or system requirements are documented.',['analysis/group_analysis.py','report.md']),\n'must/012':('unmet','No README or environment specification gives a system requirements and dependencies list.',['analysis/group_analysis.py']),\n'must/013':('unmet','No environment specification is tracked with the code.',['analysis/group_analysis.py']),\n'must/014':('unmet','No environment update process or tracked environment specification is supplied.',['analysis/group_analysis.py']),\n'must/015':('unmet','No pinned environment specification is provided for exact reconstruction.',['analysis/group_analysis.py']),\n'must/016':('unmet','No environment specification is available through a worker-declared access route.',['input/sources.json']),\n'must/017':('unmet','No instructions explain how to obtain and use a computational environment specification.',['report.md']),\n'should/001':('met','A single Git repository is used, and git-annex is used for the large input maps.',['input/sources.json']),\n'should/002':('unmet','The stop state contains one analysis run and no CI or recurring test process.',['analysis/group_analysis.py','results/summary.json']),\n'should/003':('partial','Inputs, analysis code, results and figures occupy distinct directories, but environment files are absent and module relationships are not documented.',['input/sources.json','analysis/group_analysis.py','results/summary.json']),\n'should/009':('not-applicable','The supplied maps and metadata are not identified as restricted data or software.',['input/sources.json']),\n'should/004':('unmet','No fresh-container, clean-VM or batch-job test is recorded.',['analysis/group_analysis.py']),\n'should/005':('unmet','No disposable execution environment is supplied or documented.',['analysis/group_analysis.py']),\n'should/006':('unmet','There is no exact environment specification or recurring reconstitution test.',['analysis/group_analysis.py']),\n'should/007':('unmet','No environment artifacts are archived in the worker stop state.',['analysis/group_analysis.py']),\n'should/008':('unmet','No environment specification or update process is present.',['analysis/group_analysis.py']),\n'may/001':('not-applicable','There are no linked submodules; the input dataset is carried through git-annex inside the project.',['input/sources.json']),\n'may/002':('unmet','The folder structure is visible but no document explains the module relationships.',['report.md']),\n'may/003':('not-checked','The delivery does not describe module interfaces or independent update procedures.',['analysis/group_analysis.py']),\n'may/004':('not-applicable','No independently composed modules or orchestration mechanism are declared.',['analysis/group_analysis.py']),\n'may/005':('partial','The report provides a starting command, but no guide to navigating or composing the project directories.',['report.md'])}\nargs=[]; log=[]\nfor i,(item,(status,reason,paths)) in enumerate(items.items(),1):\n cmd=[py,runner,'response','set','--item',item,'--status',status,'--reason',reason,'--source','judgement']\n for path in paths: cmd += ['--evidence',f'capture:sha256:{sha}:{path}={path} in canonical capture']\n p=subprocess.run(cmd,capture_output=True,text=True,env=os.environ.copy())\n (open(f'{out}/commands/response-set-{i:02}.stdout','w').write(p.stdout))\n (open(f'{out}/commands/response-set-{i:02}.stderr','w').write(p.stderr))\n open(f'{out}/commands/response-set-{i:02}.exit','w').write(str(p.returncode)+'\\\\n')\n log.append({'argv':cmd,'exit':p.returncode})\n if p.returncode: raise SystemExit(f'response set failed for {item}: {p.stderr}')\n# Add frozen assessment identity; capture URL denotes the canonical original capture, not the operational path.\np=f'{out}/response.json'; d=json.load(open(p)); d['object']={'url':f'capture:sha256:{sha}','commit':'afb62884c70115b6e46a92ddcd1d17bbf4f33544','captured_at':'2026-10-16T07:14:56.253754+00:00','kind':'study'}\nd['assessor']={'skill':'frozen independent assessor','version':'source_commit 9852d8360f9519d21d11099b45f5deb8ba80cb28','harness':'frozen assessment runner','model':'external frozen assessor','date':'2026-10-16','dependencies':[]}\nd['scope']='Independent assessment of the complete stopped delivery: STAMPED checklist, scientific adequacy, route check and replay eligibility. One representative access HEAD check per declared host; no replay because worker-supplied prerequisites are absent.'\njson.dump(d,open(p,'w'),indent=2); open(p,'a').write('\\\\n'); json.dump(log,open(f'{out}/commands/response-set-commands.json','w'),indent=2)\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_JUDGE_OUTPUT/build_response.py\" > \"$STAMPED_JUDGE_OUTPUT/commands/build-response.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/build-response.stderr\"; result=$?; printf '\"'%s\\\\n' \\\"\"'$result\" > \"$STAMPED_JUDGE_OUTPUT/commands/build-response.exit\"; exit \"$result\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
