": \"No tracked environment specification (lockfile, container definition or registration).\",\n        \"stamped-checklist:must/013\": \"No tracked environment specification (lockfile, container definition or registration).\",\n        \"stamped-checklist:must/016\": \"Nothing to share: No tracked environment specification (lockfile, container definition or registration).\"\n      }\n    },\n    {\n      \"probe\": \"inputs-untouched\",\n      \"status\": \"not-applicable\",\n      \"items\": [],\n      \"reason\": \"N/A: no linked modules, so there is no recorded input state to compare against.\",\n      \"evidence\": [],\n      \"details\": {},\n      \"item_status\": {},\n      \"item_reason\": {}\n    },\n    {\n      \"probe\": \"large-in-annex\",\n      \"status\": \"met\",\n      \"items\": [\n        \"stamped-checklist:must/005\"\n      ],\n      \"reason\": \"git-annex carries the binary content (54 pointer(s) tracked) and no binary blob over 10 MiB is in git.\",\n      \"evidence\": [\n        {\n          \"uri\": \"git ls-tree -r -l HEAD\",\n          \"description\": \"no binary blob over 10485760 bytes\",\n          \"sha256\": null\n        },\n        {\n          \"uri\": \".datalad/config\",\n          \"description\": \"git-annex in use for large content\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"mechanism\": \"git-annex\",\n        \"annex_pointers\": 54,\n        \"large_binary\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/005\": \"met\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/005\": \"git-annex carries the binary content (54 pointer(s) tracked) and no binary blob over 10 MiB is in git.\"\n      }\n    },\n    {\n      \"probe\": \"license-declared\",\n      \"status\": \"unmet\",\n      \"items\": [],\n      \"reason\": \"No LICENSE, LICENSES/, REUSE.toml or BIDS License field: reuse terms are unstated.\",\n      \"evidence\": [\n        {\n 