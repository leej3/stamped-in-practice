{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'python - \"$STAMPED_OPERATIONAL_MANIFEST\" \"$STAMPED_JUDGE_TARGET\" <<'\"'PY'\nimport hashlib,json,os,stat,sys\nm=json.load(open(sys.argv[1])); root=sys.argv[2]; bad=[]; exempt=[]\nfor e in m['entries']:\n if not e['path'].startswith('content/workspace/'): continue\n rel=e['path'][len('content/workspace/'):]; p=os.path.join(root,rel)\n try: st=os.lstat(p)\n except FileNotFoundError: bad.append([rel,'missing']); continue\n if e['kind']=='file':\n  if not stat.S_ISREG(st.st_mode): bad.append([rel,'type']); continue\n  if rel in ('.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'):\n   exempt.append(rel); continue\n  h=hashlib.sha256()\n  with open(p,'rb') as f:\n   for b in iter(lambda:f.read(1048576),b''): h.update(b)\n  if h.hexdigest()\"'!=e['\"'sha256']: bad.append([rel,'sha256'])\n elif e['kind']=='symlink':\n  if not stat.S_ISLNK(st.st_mode) or os.readlink(p)\"'!=e['\"'link_target']: bad.append([rel,'symlink'])\nprint(json.dumps({'manifest_entries':len(m['entries']),'non_db_mismatches':bad,'allowed_db_exemptions':exempt},indent=2))\nif bad: sys.exit(1)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
