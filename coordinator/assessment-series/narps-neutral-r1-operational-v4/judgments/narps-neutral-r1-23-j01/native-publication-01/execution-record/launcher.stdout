{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat > \"$STAMPED_JUDGE_OUTPUT/access-record.json\" <<'\"'EOF'\n{\n  \\\"schema_version\\\": 1,\n  \\\"intended_recipient\\\": \\\"A researcher following the worker-declared source links\\\",\n  \\\"declared_route\\\": {\n    \\\"map_source\\\": \\\"54 individual URLs at https://neurovault.org/media/images/4932/ listed in input/sources.json\\\",\n    \\\"metadata_source\\\": \\\"Pinned participants.tsv URL at raw.githubusercontent.com listed in input/sources.json\\\",\n    \\\"methods_source\\\": \\\"Pinned upstream methods source identified in input/sources.json\\\",\n    \\\"complete_project_route\\\": null\n  },\n  \\\"required_artifact_coverage\\\": {\n    \\\"maps\\\": \\\"54 participant gain-effect maps\\\",\n    \\\"metadata\\\": \\\"participants.tsv and source/method provenance\\\",\n    \\\"code_report_results_environment\\\": \\\"Not covered by a worker-declared publication route\\\"\n  },\n  \\\"tested\\\": [\n    {\n      \\\"url\\\": \\\"https://neurovault.org/media/images/4932/sub-001_hypo1_cope.nii.gz\\\",\n      \\\"method\\\": \\\"HTTP HEAD\\\",\n      \\\"status\\\": 200,\n      \\\"tested_at\\\": \\\"2026-10-16\\\",\n      \\\"scope\\\": \\\"One representative map endpoint; no map bytes retrieved\\\"\n    },\n    {\n      \\\"url\\\": \\\"https://raw.githubusercontent.com/OpenNeuroDatasets/ds001734/64ec117560ab58ed0fe1273f3e90887b1768b268/participants.tsv\\\",\n      \\\"method\\\": \\\"HTTP HEAD\\\",\n      \\\"status\\\": 200,\n      \\\"tested_at\\\": \\\"2026-10-16\\\",\n      \\\"scope\\\": \\\"Pinned metadata endpoint; no response body retrieved\\\"\n    }\n  ],\n  \\\"host_scope_tested\\\": [\\\"neurovault.org\\\", \\\"raw.githubusercontent.com\\\"],\n  \\\"coverage_assessment\\\": \\\"The declared URLs provide a route to the inputs and cohort metadata. They do not provide the worker's code, report, generated results, or a document