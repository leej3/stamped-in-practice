{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/bash -lc '$STAMPED_ASSESSMENT_PYTHON - <<'\"'PY'\nimport hashlib,json,os,pathlib,stat\nroot=pathlib.Path(os.environ['STAMPED_JUDGE_TARGET'])\nman=json.load(open(os.environ['STAMPED_OPERATIONAL_MANIFEST']))\nchanges=[]; missing=[]; extra=[]\nexpected={e['path'].removeprefix('content/workspace/'):e for e in man['entries'] if e['path'].startswith('content/workspace/') and e['path']\"'!='\"'content/workspace'}\nfor rel,e in expected.items():\n p=root/rel\n try: st=p.lstat()\n except FileNotFoundError: missing.append(rel); continue\n kind='file' if stat.S_ISREG(st.st_mode) else 'symlink' if stat.S_ISLNK(st.st_mode) else 'directory' if stat.S_ISDIR(st.st_mode) else 'other'\n if kind\"'!=e['\"'kind']: changes.append({'path':rel,'expected_kind':e['kind'],'actual_kind':kind}); continue\n if kind=='file':\n  h=hashlib.sha256(p.read_bytes()).hexdigest()\n  if h\"'!=e.get('\"'sha256'): changes.append({'path':rel,'expected_sha256':e.get('sha256'),'actual_sha256':h})\n elif kind=='symlink':\n  t=os.readlink(p)\n  if t\"'!=e.get('\"'link_target'): changes.append({'path':rel,'expected_target':e.get('link_target'),'actual_target':t})\nfor p in root.rglob('*'):\n rel=p.relative_to(root).as_posix()\n if rel not in expected and not any(rel.startswith(x+'/') for x in expected if expected[x]['kind']=='directory'): extra.append(rel)\n# Count regular file modifications separately allowed only under the three annex keys DB files.\nallowed={'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'}\nallowed_changes=[c for c in changes if c['path'] in allowed and 'actual_sha256' in c]\ninvalid=[c for c in changes if c not in allowed_changes]\nresult={'capture_sha256':hashlib.sha256(open(os.environ['STAMPED_OPERATIONAL_MANIFEST'],'rb').read()).hexdigest(),'expected_entries':len(expected),'content_differences':changes,'missing':missing,'extra':sorted(extra),'allowed_regular_db_metadata_differences':allowed_changes,'invalid_differences':invalid}\nopen(os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'integrity.json'),'w').write(json.dumps(result,indent=2)+'\\\\n')\nprint(json.dumps(result,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
