{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/opt/homebrew/bin/bash -lc '$STAMPED_ASSESSMENT_PYTHON - <<'\"'PY'\nimport hashlib,json,os,pathlib,stat\nroot=pathlib.Path(os.environ['STAMPED_JUDGE_TARGET']); man=json.load(open(os.environ['STAMPED_OPERATIONAL_MANIFEST']))\nexpected={e['path'].removeprefix('content/workspace/'):e for e in man['entries'] if e['path'].startswith('content/workspace/') and e['path']\"'!='\"'content/workspace'}\nchanges=[]; missing=[]\nfor rel,e in expected.items():\n p=root/rel\n try: st=p.lstat()\n except FileNotFoundError: missing.append(rel); continue\n kind='file' if stat.S_ISREG(st.st_mode) else 'symlink' if stat.S_ISLNK(st.st_mode) else 'directory' if stat.S_ISDIR(st.st_mode) else 'other'\n if kind\"'!=e['\"'kind']: changes.append({'path':rel,'expected_kind':e['kind'],'actual_kind':kind}); continue\n if kind=='file':\n  actual=hashlib.sha256(p.read_bytes()).hexdigest()\n  if actual\"'!=e.get('\"'sha256'): changes.append({'path':rel,'expected_sha256':e.get('sha256'),'actual_sha256':actual})\n elif kind=='symlink' and os.readlink(p)\"'!=e.get('\"'link_target'): changes.append({'path':rel,'expected_target':e.get('link_target'),'actual_target':os.readlink(p)})\nallowed={'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'}\npermitted=[c for c in changes if c['path'] in allowed and 'actual_sha256' in c]\ninvalid=[c for c in changes if c not in permitted]\nextra=[]\nfor p in root.rglob('*'):\n rel=p.relative_to(root).as_posix()\n if rel not in expected and not any(rel.startswith(x+'/') for x in expected if expected[x]['kind']=='directory'): extra.append(rel)\nout={'capture_sha256':hashlib.sha256(open(os.environ['STAMPED_OPERATIONAL_MANIFEST'],'rb').read()).hexdigest(),'entries_checked':len(expected),'missing':missing,'extra':sorted(extra),'differences':changes,'permitted_regular_db_metadata_differences':permitted,'invalid_differences':invalid}\npathlib.Path(os.environ['STAMPED_JUDGE_OUTPUT'],'integrity.json').write_text(json.dumps(out,indent=2)+'\\\\n')\nprint(json.dumps(out,indent=2))\nPY\n\"'$STAMPED_ASSESSMENT_PYTHON - <<'\"'PY'\nfrom pathlib import Path\np=Path('commands/response-encode-final.stdout.txt')\nlines=[x for x in p.read_text().splitlines() if x.startswith('https://checklist.stamped-principles.org/')]\nassert len(lines)==1\nPath('checklist-link.txt').write_text(lines[0]+'\\\\n')\nPY\ncat integrity.json\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
