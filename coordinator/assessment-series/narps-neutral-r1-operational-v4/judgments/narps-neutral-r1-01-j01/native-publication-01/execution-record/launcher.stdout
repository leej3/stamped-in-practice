-I --max-time 15; HEAD only, no artifact body downloaded\\\",\n  \\\"tested_host_scope\\\": {\n    \\\"neurovault.org\\\": \\\"HTTP 200 for collection page and sub-001 map\\\",\n    \\\"raw.githubusercontent.com\\\": \\\"HTTP 200 for pinned participants.tsv and AO86 methods workbook\\\"\n  },\n  \\\"required_artifact_coverage\\\": {\n    \\\"retrievable_via_declared_routes\\\": [\n      \\\"participant gain maps\\\",\n      \\\"cohort metadata\\\",\n      \\\"upstream methods source\\\"\n    ],\n    \\\"not_covered_by_tested_routes\\\": [\n      \\\"worker analysis script\\\",\n      \\\"worker report\\\",\n      \\\"worker figures\\\",\n      \\\"worker group result maps and summary\\\",\n      \\\"worker execution environment\\\"\n    ]\n  },\n  \\\"attribution_limit\\\": \\\"The source routes are recorded in the worker stop-state input/sources.json. HEAD requests establish present host reachability only. They do not establish that the worker had published the complete project or that a researcher could retrieve these resources at worker stop; coordinator delivery to the assessor is not worker access evidence.\\\"\n}\nEOF\npython3 - <<'PY'\nimport json,hashlib,os,stat\nfrom pathlib import Path\nm=json.load(open(os.environ[\\\"STAMPED_DELIVERY_MANIFEST\\\"]))\nroot=Path(os.environ[\\\"STAMPED_JUDGE_TARGET\\\"])\nallowed={\\\".git/annex/keysdb/db\\\",\\\".git/annex/keysdb/db-shm\\\",\\\".git/annex/keysdb/db-wal\\\"}\nbad=[]; allowed_changes=[]\nfor row in m[\\\"entries\\\"]:\n p=row[\\\"path\\\"]\n prefix=\\\"content/workspace/\\\"\n if not p.startswith(prefix): continue\n rel=p[len(prefix):]\n q=root/rel\n kind=row[\\\"kind\\\"]\n try:\n  if kind==\\\"file\\\":\n   if not q.is_file() or q.is_symlink(): bad.append((rel,\\\"missing-or-not-file\\\")); continue\n   b=q.read_bytes(); digest=hashlib.sha256(b).hexdigest()\n   mode=stat.S_IMODE(q.stat().st_mode)\n   if digest\"'!=row[\"sha256\"] or mode!=row[\"mode\"]:\n    if rel in allowed: allowed_changes.append((rel,digest,row[\"sha256\"]))\n    else: bad.append((rel,\"sha-or-mode\",digest,row[\"sha256\"],mode,row[\"mode\"]))\n  elif kind==\"symlink\":\n   if not q.is_symlink() or os.readlink(q)!=row[\"target\"]: bad.append((rel,\"link-mismatch\"))\n  elif kind==\"directory\":\n   if not q.is_dir() or q.is_symlink(): bad.append((rel,\"directory-mismatch\"))\n except Exception as e: bad.append((rel,type(e).__name__,str(e)))\nprint(json.dumps({\"canonical_capture_sha256\":json.load(open(os.environ[\"STAMPED_WORKER_STOP_RECEIPT\"]))[\"capture\"][\"sha256\"],\"checked_entries\":len(m[\"entries\"]),\"mismatches\":bad[:50],\"mismatch_count\":len(bad),\"allowed_operational_metadata_changes\":allowed_changes},indent=2))\nPY\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
