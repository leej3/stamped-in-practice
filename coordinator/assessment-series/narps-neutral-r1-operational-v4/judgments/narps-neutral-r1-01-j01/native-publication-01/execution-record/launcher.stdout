a/sub-003_hypo1_cope.nii.gz\n./input/data/sub-005_hypo1_cope.nii.gz\n./input/data/sub-009_hypo1_cope.nii.gz\n./input/data/sub-011_hypo1_cope.nii.gz\n./input/data/sub-013_hypo1_cope.nii.gz\n./input/data/sub-015_hypo1_cope.nii.gz\n./input/data/sub-017_hypo1_cope.nii.gz\n./input/data/sub-019_hypo1_cope.nii.gz\n./input/data/sub-021_hypo1_cope.nii.gz\n./input/data/sub-025_hypo1_cope.nii.gz\n./input/data/sub-027_hypo1_cope.nii.gz\n./input/data/sub-029_hypo1_cope.nii.gz\n./input/data/sub-033_hypo1_cope.nii.gz\n./input/data/sub-035_hypo1_cope.nii.gz\n./input/data/sub-037_hypo1_cope.nii.gz\n./input/data/sub-039_hypo1_cope.nii.gz\n./input/data/sub-041_hypo1_cope.nii.gz\n./input/data/sub-043_hypo1_cope.nii.gz\n./input/data/sub-045_hypo1_cope.nii.gz\n./input/data/sub-047_hypo1_cope.nii.gz\n./input/data/sub-049_hypo1_cope.nii.gz\n./input/data/sub-051_hypo1_cope.nii.gz\n./input/data/sub-053_hypo1_cope.nii.gz\n./input/data/sub-055_hypo1_cope.nii.gz\n./input/data/sub-057_hypo1_cope.nii.gz\n./input/data/sub-059_hypo1_cope.nii.gz\n./input/data/sub-061_hypo1_cope.nii.gz\n./input/data/sub-063_hypo1_cope.nii.gz\n./input/data/sub-067_hypo1_cope.nii.gz\n./input/data/sub-069_hypo1_cope.nii.gz\n./input/data/sub-071_hypo1_cope.nii.gz\n./input/data/sub-073_hypo1_cope.nii.gz\n./input/data/sub-075_hypo1_cope.nii.gz\n./input/data/sub-077_hypo1_cope.nii.gz\n./input/data/sub-079_hypo1_cope.nii.gz\n./input/data/sub-081_hypo1_cope.nii.gz\n./input/data/sub-083_hypo1_cope.nii.gz\n./input/data/sub-085_hypo1_cope.nii.gz\n./input/data/sub-087_hypo1_cope.nii.gz\n./input/data/sub-089_hypo1_cope.nii.gz\n./input/data/sub-093_hypo1_cope.nii.gz\n./input/data/sub-095_hypo1_cope.nii.gz\n./input/data/sub-099_hypo1_cope.nii.gz\n./input/data/sub-103_hypo1_cope.nii.gz\n./input/data/sub-105_hypo1_cope.nii.gz\n./input/data/sub-107_hypo1_cope.nii.gz\n./input/data/sub-109_hypo1_cope.nii.gz\n./input/data/sub-113_hypo1_cope.nii.gz\n./input/data/sub-115_hypo1_cope.nii.gz\n./input/data/sub-117_hypo1_cope.nii.gz\n./input/dat