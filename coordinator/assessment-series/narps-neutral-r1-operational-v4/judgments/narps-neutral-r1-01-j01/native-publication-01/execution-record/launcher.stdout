{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY' > integrity-check.json\nimport json,hashlib,os,stat\nfrom pathlib import Path\nm=json.load(open(os.environ[\\\"STAMPED_DELIVERY_MANIFEST\\\"])); root=Path(os.environ[\\\"STAMPED_JUDGE_TARGET\\\"])\nallowed={\\\".git/annex/keysdb/db\\\",\\\".git/annex/keysdb/db-shm\\\",\\\".git/annex/keysdb/db-wal\\\"}; bad=[]; allowed_changes=[]; expected=set()\nfor row in m[\\\"entries\\\"]:\n p=row[\\\"path\\\"]\n if not p.startswith(\\\"content/workspace/\\\"): continue\n rel=p[len(\\\"content/workspace/\\\"):]; expected.add(rel); q=root/rel; kind=row[\\\"kind\\\"]\n try:\n  if kind==\\\"file\\\":\n   if not q.is_file() or q.is_symlink(): bad.append({\\\"path\\\":rel,\\\"issue\\\":\\\"missing-or-not-file\\\"}); continue\n   digest=hashlib.sha256(q.read_bytes()).hexdigest(); mode=stat.S_IMODE(q.stat().st_mode)\n   if digest\"'!=row[\"sha256\"] or mode!=row[\"mode\"]:\n    record={\"path\":rel,\"current_sha256\":digest,\"initial_sha256\":row[\"sha256\"],\"current_mode\":mode,\"initial_mode\":row[\"mode\"]}\n    if rel in allowed and mode==row[\"mode\"]: allowed_changes.append(record)\n    else: bad.append(record)\n  elif kind==\"symlink\":\n   if not q.is_symlink() or os.readlink(q)!=row[\"link_target\"] or stat.S_IMODE(q.lstat().st_mode)!=row[\"mode\"]: bad.append({\"path\":rel,\"issue\":\"link-or-mode-mismatch\"})\n  elif kind==\"directory\":\n   if not q.is_dir() or q.is_symlink() or stat.S_IMODE(q.stat().st_mode)!=row[\"mode\"]: bad.append({\"path\":rel,\"issue\":\"directory-or-mode-mismatch\"})\n except Exception as e: bad.append({\"path\":rel,\"issue\":type(e).__name__,\"message\":str(e)})\nactual=set()\nfor base,dirs,files in os.walk(root,followlinks=False):\n for name in dirs+files:\n  p=Path(base)/name; rel=p.relative_to(root).as_posix(); actual.add(rel)\n  if p.is_symlink(): dirs[:] = [d for d in dirs if d!=name]\nextra=sorted(actual-expected)\nprint(json.dumps({\"canonical_capture_sha256\":json.load(open(os.environ[\"STAMPED_WORKER_STOP_RECEIPT\"]))[\"capture\"][\"sha256\"],\"checked_manifest_entries\":len(expected),\"mismatches\":bad,\"mismatch_count\":len(bad),\"unexpected_paths\":extra,\"allowed_operational_metadata_changes\":allowed_changes,\"logical_database_equivalence_established\":False},indent=2))\nPY\ncat integrity-check.json'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
