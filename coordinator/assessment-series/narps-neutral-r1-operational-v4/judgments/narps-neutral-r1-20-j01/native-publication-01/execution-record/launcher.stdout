{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$STAMPED_JUDGE_TARGET/input/sources.json\"; printf '\"'\\\\n--- git receipt identity and counts ---\\\\n'; python3 - <<'PY'\nimport json,os\nm=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST'])); r=json.load(open(os.environ['STAMPED_WORKER_STOP_RECEIPT']))\nprint('capture',r.get('capture')); print('head',m.get('head_commit')); print('git_metadata',json.dumps(m.get('git_metadata'),indent=2)); print('kind',m.get('kind'),'entry_count',len(m['entries']),'issues',m.get('errors'),m.get('omissions'))\nprint('worker stop',r.get('worker'))\nfor e in m['entries']:\n if e.get('path','').removeprefix('content/workspace/') in ['report.md','analysis/analyze.py','input/upstream-methods.md','input/participants.tsv','input/sources.json','results/summary.json','results/participant_qc.csv','figures/group_gain_vmPFC.png','figures/voxel_t_distribution.png']:\n  print(e)\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response items > \"$STAMPED_JUDGE_OUTPUT/logs/checklist-items.txt\" 2> \"$STAMPED_JUDGE_OUTPUT/logs/checklist-items.stderr.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/checklist-items.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
