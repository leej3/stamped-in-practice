{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY' > \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/final-artifact-audit.stdout.txt\" 2> \"$STAMPED_JUDGE_OUTPUT/logs/final-artifact-audit.stderr.txt\"\nimport hashlib,json,os,stat\nfrom pathlib import Path\nout=Path(os.environ['\"'STAMPED_JUDGE_OUTPUT']); root=Path(os.environ['STAMPED_JUDGE_TARGET']); mpath=root.parents[1]/'manifest.json'; m=json.loads(mpath.read_bytes()); pref='content/workspace/'; exp={r['path'][len(pref):]:r for r in m['entries'] if r['path'].startswith(pref)}; allowed={'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'}; bad=[]; missing=[]; extra=[]; meta=[]\nfor rel,row in exp.items():\n p=root/rel\n if not p.exists() and not p.is_symlink(): missing.append(rel); continue\n if stat.S_IMODE(p.lstat().st_mode)\"'!=row['\"'mode']: bad.append(rel+' mode'); continue\n if row['kind']=='symlink':\n  if not p.is_symlink() or os.readlink(p)\"'!=row.get('\"'link_target'): bad.append(rel+' symlink')\n elif row['kind']=='file':\n  h=hashlib.sha256(p.read_bytes()).hexdigest()\n  if h\"'!=row.get('\"'sha256'):\n   if rel in allowed: meta.append({'path':rel,'initial':row.get('sha256'),'current':h})\n   else: bad.append(rel+' sha256')\nfor p in root.rglob('*'):\n rel=p.relative_to(root).as_posix()\n if rel not in exp:\n  if rel in allowed and p.is_file() and not p.is_symlink(): meta.append({'path':rel,'initial':None,'current':hashlib.sha256(p.read_bytes()).hexdigest()})\n  else: extra.append(rel)\nresponse=json.loads((out/'response.json').read_bytes()); sj=json.loads((out/'scientific-judgment.json').read_bytes())\ncounts={s:sum(a['status']==s for a in response['responses'].values()) for s in ['met','partial','unmet','not-checked','not-applicable']}\nrecord={'capture_sha256':response['object']['capture']['sha256'],'commit':response['object']['commit'],'response_counts':counts,'target_missing':missing,'target_extra_outside_allowed_db':extra,'target_changed_outside_allowed_db':bad,'annex_db_metadata':meta,'target_integrity':'preserved outside classified annex database metadata' if not (missing or extra or bad) else 'mismatch','scientific_adequacy':sj['scientific_adequacy'],'report_sha256':sj['report']['sha256']}\n(out/'operational-integrity.json').write_text(json.dumps({'schema_version':1,'canonical_capture_sha256':record['capture_sha256'],'initial_manifest':str(mpath),'checked_entry_count':len(exp),'missing':missing,'unexpected_outside_allowed_annex_metadata':extra,'changed_outside_allowed_annex_metadata':bad,'annex_database_metadata_changes':[{'path':x['path'],'initial_sha256':x['initial'],'current_sha256':x['current'],'logical_equivalence':'not established'} for x in meta],'integrity':record['target_integrity']},indent=2)+'\\\\n')\nprint(json.dumps(record,indent=2))\nPY\ncat \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/final-artifact-audit.stdout.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/final-artifact-audit.stderr.txt\"; find \"$STAMPED_JUDGE_OUTPUT\" -maxdepth 2 -type f -print | sort'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
