 \"/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-20-j01/operational/content/workspace\",\n    \"commit\": \"eece8595d255a766517e32ff10b2e6574d3c4e6a\",\n    \"is_datalad\": false\n  },\n  \"checklist_version\": \"0.3.1\",\n  \"probes\": [\n    {\n      \"probe\": \"ci-present\",\n      \"status\": \"not-checked\",\n      \"items\": [\n        \"stamped-checklist:should/002\",\n        \"stamped-checklist:should/006\"\n      ],\n      \"reason\": \"No recognized CI configuration; inspect equivalent repeated-testing records.\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:ci-present\",\n          \"description\": \"no tracked .github/workflows/, .gitlab-ci.yml, .circleci/, .forgejo/workflows/, .gitea/workflows/ in 58 tracked paths\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"configs\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:should/002\": \"not-checked\",\n        \"stamped-checklist:should/006\": \"not-checked\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:should/002\": \"No recognized CI configuration; inspect equivalent repeated-testing records.\",\n        \"stamped-checklist:should/006\": \"No recognized CI configuration; inspect equivalent environment-reconstitution records.\"\n      }\n    },\n    {\n      \"probe\": \"clone-weight\",\n      \"status\": \"met\",\n      \"items\": [],\n      \"reason\": \"No text blob in git exceeds 10 MiB.\",\n      \"evidence\": [\n        {\n          \"uri\": \"git ls-tree -r -l HEAD\",\n          \"description\": \"largest text blob under 10485760 bytes\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {},\n      \"item_status\": {},\n      \"item_reason\": {}\n    },\n    {\n      \"probe\": \"derived-have-records\",\n      \"status\": \"not-applicable\",\n      \"items\": [\n        \"stamped-checklist:mu