4821a8a880085af0c41494bfe11f13059836d18326292448af25c', 'size': 11284}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/figures/group_gain_vmPFC.png', 'sha256': '5ec9684e227a6b35e09571c5572ac4b82fd2684dd8c737b12a6dd2c40bd221a9', 'size': 151405}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/figures/voxel_t_distribution.png', 'sha256': '6fbc68fdbc8192b370daeefc44781169a0009000ea961af94e1153e4bced01c8', 'size': 42691}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/input/participants.tsv', 'sha256': 'faca815bcb042144bdb8dcff915f45de0d27650f60416ed76a5a72557341abbf', 'size': 1706}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/input/sources.json', 'sha256': '919be9b4278c31f7e39ae3d02fcf159eb4ae222a2fb96c90df7c3a92e5fb19cd', 'size': 19843}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/input/upstream-methods.md', 'sha256': '508d832c8787ed8303c3de101c2c76f40a3aa5dec53e6993dc2a49c4b7bcf90b', 'size': 1342}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/report.md', 'sha256': 'd22704a597befd2afcf3dc207053c0ca4a54a05a1a73be20beb00dfbcd0c9c25', 'size': 5955}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/results/participant_qc.csv', 'sha256': 'cb8176844646dddd1eb52a78adab61b3dc7fe5421ee45112923d6c9a65f4504e', 'size': 5521}\n{'kind': 'file', 'mode': 420, 'path': 'content/workspace/results/summary.json', 'sha256': 'ca2d7767a96bb659a93df6011197fe98f5c7d1b906d0eb8ba49768502effac79', 'size': 2095}\nstamped-checklist:must/001\tmust\tS.1\tAre all files and directories nested under a common root?\nstamped-checklist:must/002\tmust\tS.1\tAre datasets included, linked, or referenced reachable from the code and environment specifications without crossing the boundary of a common root?\nstamped-checklist:must/003\tmust\tS.1\tIs external software included in the environment or linked as submodules within the project boundary?\nstamped-checklist:must/004\tmust\tT.1,T.3,T.5\tAre version control systems such as `Git` used for code, text, documentation, and configuration files?\nstamped-checklist:must/005\tmust\tT.1,T.3,T.5\tAre version control systems such as `git-annex`, DataLad, or `Git` LFS used for large binary data?\nstamped-checklist:must/006\tmust\tT.1,T.3,T.5\tAre the exact environment specifications used to generate a set of results included in the provenance records to link computational actions to particular environments?\nstamped-checklist:must/007\tmust\tA.1\tIs a `README.md` or `Makefile` included with instructions for installation and usage?\nstamped-checklist:must/008\tmust\tA.1\tIs there a clear starting point for users to start reproducing results (e.g., a main script, a workflow definition, or a container image)?\nstamped-checklist:must/009\tmust\tP.1\tAre relative paths used in scripts, avoiding hardcoded or system-specific paths like `C:\\Users\\...` or `/home/user/...`?\nstamped-checklist:must/010\tmust\tP.1\tAre all software dependencies included in the environment specification, rather than relying on pre-installed tools?\nstamped-checklist:must/011\tmust\tP.1\tHave all assumptions about the host system's configuration been documented (e.g., specific OS versions, required system libraries, or environment variables)?\nstamped-checklist:must/012\tmust\tP.2\tIs there a clear list of system requirements and dependencies documented in the README or environment specifications?\nstamped-checklist:must/013\tmust\tP.3\tAre environment specifications (e.g., Dockerfiles, `pyproject.toml`, `package.json`) included in the version control system alongside code and data?\nstamped-checklist:must/014\tmust\tP.3\tIs there a process for updating environment specifications when dependencies change, and are these updates tracked in version control?\nstamped-checklist:must/015\tmust\tD.1\tAre environment specifications (e.g., container digests, frozen package manifests) included to ensure others can attempt to exactly replicate the environment?\nstamped-checklist:must/016\tmust\tD.1\tAre environment specifications shared in a way that others can access and use them (e.g., published container images, archived environment files)?\nstamped-checklist:must/017\tmust\tD.1\tIs there documentation on how to obtain and use the environment specifications for reproduction?\nstamped-checklist:should/001\tshould\tT.2\tIs a common version control system (e.g., `Git`, DVC, `git-annex`, or DataLad) used across all components?\nstamped-checklist:should/002\tshould\tA.2\tIs the workflow tested regularly to ensure instructions remain accurate?\nstamped-checklist:should/003\tshould\tM.1\tAre raw data, processed data, code, and environment definitions separated into distinct modules?\nstamped-checklist:should/009\tshould\tM.4\tAre restricted data or software kept in their own modules?\nstamped-checklist:should/004\tshould\tE.1\tIs the pipeline tested in a fresh container, batch job, clean virtual machine, or cloud-based instance?\nstamped-checklist:should/005\tshould\tE.1\tDoes the workflow spawn disposable environments for each execution, allowing for isolation of runs?\nstamped-checklist:should/006\tshould\tD.2\tAre the exact environment specifications used to generate a specific set of results regularly tested to ensure they can be reconstituted as intended?\nstamped-checklist:should/007\tshould\tD.2\tAre environment artifacts archived within the research object where possible (e.g., executable binaries, container images)?\nstamped-checklist:should/008\tshould\tD.2\tIs there a process for updating environment specifications when dependencies change, and are these updates tracked in version control?\nstamped-checklist:may/001\tmay\tM.2\tAre external datasets or software dependencies included as submodules or linked as submodules?\nstamped-checklist:may/002\tmay\tM.2\tIs the modular structure documented to clarify how components relate and can be recombined?\nstamped-checklist:may/003\tmay\tM.2\tAre modular boundaries defined in a way that allows independent updates without breaking the overall workflow?\nstamped-checklist:may/004\tmay\tM.2\tIs there a clear mechanism for composing modules together (e.g., `git` submodules, or container orchestration)?\nstamped-checklist:may/005\tmay\tM.2\tIs there documentation or tooling to support users in understanding and navigating the modular structure?\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/bash -lc '\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response set --help; printf '\"'\\\\nvalidator=%s\\\\n' \\\"\"'$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\"; test -f \"$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\" && head -80 \"$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\"; printf '\"'%s\\\\n' 'The first Git inventory command used invalid shell assignment syntax for the annex.* environment settings and did not run Git.' > \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/initial-git-command-error.txt\"; printf '\"'%s\\\\n' 'cd \\\"\"'$STAMPED_JUDGE_TARGET\" && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git status --short --ignored'\"' >> \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/initial-git-command-error.txt\"; printf '\"'%s\\\\n' '/opt/homebrew/bin/bash: line 1: annex.merge-annex-branches=false: command not found' >> \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/initial-git-command-error.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/bash -lc '\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response set --help; printf '\"'\\\\nvalidator=%s\\\\n' \\\"\"'$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\"; test -f \"$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\" && head -80 \"$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\"; printf '\"'%s\\\\n' 'The first Git inventory command used invalid shell assignment syntax for the annex.* environment settings and did not run Git.' > \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/initial-git-command-error.txt\"; printf '\"'%s\\\\n' 'cd \\\"\"'$STAMPED_JUDGE_TARGET\" && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git status --short --ignored'\"' >> \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/initial-git-command-error.txt\"; printf '\"'%s\\\\n' '/opt/homebrew/bin/bash: line 1: annex.merge-annex-branches=false: command not found' >> \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/initial-git-command-error.txt\"'","aggregated_output":"✔ The default environment has been installed.\nusage: encode_response.py set [-h] --item ITEM\n                              --status {met,not-applicable,not-checked,partial,unmet}\n                              --reason REASON [--source SOURCE]\n                              [--evidence EVIDENCE] [--flag FLAGS]\n                              [--drop-evidence]\n                              response\n\npositional arguments:\n  response\n\noptions:\n  -h, --help            show this help message and exit\n  --item ITEM           item id, with or without the 'stamped-checklist:'\n                        prefix\n  --status {met,not-applicable,not-checked,partial,unmet}\n  --reason REASON\n  --source SOURCE       probe:<name>, judgement, probe:<name>+judgement,\n                        human:web-app\n  --evidence EVIDENCE   uri, or uri=description; repeatable\n  --flag FLAGS\n  --drop-evidence       clear the evidence already on this item (by default it\n                        is kept when --evidence is not given)\n\nvalidator=/Users/johnlee/.local/share/wt-utils/worktrees/73e0/stamped-in-practice/scripts/scientific_judgment.py\n\"\"\"Validate an explicit scientific judgment without interpreting its prose.\"\"\"\nimport argparse\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator\n\n\nADEQUACY = (\"supported\", \"qualified\", \"not supported\", \"unable to assess\")\nSHA256 = {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}\nTEXT = {\"type\": \"string\", \"minLength\": 1}\n\n\ndef object_schema(properties):\n    return {\"type\": \"object\", \"properties\": properties,\n            \"required\": list(properties), \"additionalProperties\": False}\n\n\nEXCERPT = object_schema({\n    \"quote\": TEXT,\n    \"start_line\": {\"type\": \"integer\", \"minimum\": 1},\n    \"end_line\": {\"type\": \"integer\", \"minimum\": 1},\n})\nSCHEMA = object_schema({\n    \"schema_version\": {\"const\": 1, \"type\": \"integer\"},\n    \"delivery_capture_sha256\": SHA256,\n    \"scientific_adequacy\": {\"enum\": list(ADEQUACY)},\n    \"report\": object_schema({\"path\": TEXT, \"sha256\": SHA256}),\n    \"adequacy_evidence\": EXCERPT,\n    \"hypothesis_conclusion\": {\"anyOf\": [EXCERPT, {\"type\": \"null\"}]},\n})\nSCHEMA[\"$schema\"] = \"https://json-schema.org/draft/2020-12/schema\"\n\n\ndef digest(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef parse_record(data):\n    def unique_pairs(pairs):\n        result = {}\n        for key, value in pairs:\n            if key in result:\n                raise ValueError(\"Duplicate JSON key: \" + key)\n            result[key] = value\n        return result\n\n    def invalid_constant(value):\n        raise ValueError(\"Nonfinite JSON value: \" + value)\n\n    value = json.loads(data, object_pairs_hook=unique_pairs,\n                       parse_constant=invalid_constant)\n    errors = list(Draft202012Validator(SCHEMA).iter_errors(value))\n    if errors:\n        raise ValueError(\"Invalid scientific judgment: \" + \"; \".join(\n            f\"{'/'.join(map(str, error.absolute_path)) or '(root)'}: {error.message}\"\n            for error in errors))\n    return value\n\n\ndef workspace_file(workspace, relative):\n    path = Path(relative)\n    if path.is_absolute() or \"..\" in path.parts:\n        raise ValueError(\"Judgment artifacts must use paths inside the judge workspace\")\n    current = workspace\n    for part in path.parts:\n        current = current / part\n        if current.is_symlink():\n            raise ValueError(\"Judgment artifacts must not use symlinks\")\n    if not current.is_file():\n        raise ValueError(\"Judgment artifact is not a regular file: \" + str(path))\n    return current\n\n\ndef validate_excerpt(excerpt, report):\n    \"\"\"Bind a literal text quote to one-based physical report lines.\"\"\"\n    lines = report.splitlines()\n    start, end = excerpt[\"start_line\"], excerpt[\"end_line\"]\n    if type(start) is not int or type(end) is not int:\n","exit_code":0,"status":"completed"}}
