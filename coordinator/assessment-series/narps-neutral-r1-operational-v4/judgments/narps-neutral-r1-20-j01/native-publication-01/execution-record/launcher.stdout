met.\",\n      \"evidence\": [],\n      \"details\": {\n        \"specs\": {},\n        \"uninstalled_modules\": [],\n        \"preconditions\": [],\n        \"remote\": null,\n        \"publication\": null\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/010\": \"unmet\",\n        \"stamped-checklist:must/013\": \"unmet\",\n        \"stamped-checklist:must/016\": \"unmet\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/010\": \"No tracked environment specification (lockfile, container definition or registration).\",\n        \"stamped-checklist:must/013\": \"No tracked environment specification (lockfile, container definition or registration).\",\n        \"stamped-checklist:must/016\": \"Nothing to share: No tracked environment specification (lockfile, container definition or registration).\"\n      }\n    },\n    {\n      \"probe\": \"inputs-untouched\",\n      \"status\": \"not-applicable\",\n      \"items\": [],\n      \"reason\": \"N/A: no linked modules, so there is no recorded input state to compare against.\",\n      \"evidence\": [],\n      \"details\": {},\n      \"item_status\": {},\n      \"item_reason\": {}\n    },\n    {\n      \"probe\": \"large-in-annex\",\n      \"status\": \"met\",\n      \"items\": [\n        \"stamped-checklist:must/005\"\n      ],\n      \"reason\": \"git-annex carries the binary content (54 pointer(s) tracked) and no binary blob over 10 MiB is in git.\",\n      \"evidence\": [\n        {\n          \"uri\": \"git ls-tree -r -l HEAD\",\n          \"description\": \"no binary blob over 10485760 bytes\",\n          \"sha256\": null\n        },\n        {\n          \"uri\": \".datalad/config\",\n          \"description\": \"git-annex in use for large content\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"mechanism\": \"git-annex\",\n        \"annex_pointers\": 54,\n        \"large_binary\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/005\": \"met\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/005\": \"git-annex carries the binary content (54 pointer(s) tracked) and no binary blob over 10 MiB is in git.\"\n      }\n    },\n    {\n      \"probe\": \"license-declared\",\n      \"status\": \"unmet\",\n      \"items\": [],\n      \"reason\": \"No LICENSE, LICENSES/, REUSE.toml or BIDS License field: reuse terms are unstated.\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:license-declared\",\n          \"description\": \"no licence file among 58 tracked paths, and no License field in any dataset_description.json\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {},\n      \"item_status\": {},\n      \"item_reason\": {}\n    },\n    {\n      \"probe\": \"modules-separated\",\n      \"status\": \"partial\",\n      \"items\": [\n        \"stamped-checklist:should/003\"\n      ],\n      \"reason\": \"Only inputs are separate here; no distinct place for code, derived, environment.\",\n      \"evidence\": [\n        {\n          \"uri\": \"input\",\n          \"description\": \"inputs module\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"found\": {\n          \"inputs\": [\n            \"input\"\n          ],\n          \"code\": [],\n          \"derived\": [],\n          \"environment\": []\n        }\n      },\n      \"item_status\": {\n        \"stamped-checklist:should/003\": \"partial\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:should/003\": \"Only inputs are separate here; no distinct place for code, derived, environment.\"\n      }\n    },\n    {\n      \"probe\": \"no-abs-paths\",\n      \"status\": \"met\",\n      \"items\": [\n        \"stamped-checklist:must/009\"\n      ],\n      \"reason\": \"No host-specific absolute paths in tracked text files.\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:no-abs-paths\",\n          \"description\": \"scanned 58 tracked paths, 0 /tmp hit(s), 0 host-specific\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"tmp_hits\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/009\": \"met\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/009\": \"No host-specific absolute paths in tracked text files.\"\n      }\n    },\n    {\n      \"probe\": \"platform-assumptions\",\n      \"status\": \"not-checked\",\n      \"items\": [\n        \"stamped-checklist:must/011\",\n        \"stamped-checklist:must/012\"\n      ],\n      \"reason\": \"No platform-specific package manager, BSD/GNU-only flag or scheduler command in tracked text \\u2014 all a command scan can settle. Whether the documented route needs a mount, a host install, hardware or a service is a reading.\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:platform-assumptions\",\n          \"description\": \"scanned 58 tracked paths for 20 platform-specific commands, 0 hits\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"hits\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/011\": \"not-checked\",\n        \"stamped-checklist:must/012\": \"not-checked\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/011\": \"No platform-specific package manager, BSD/GNU-only flag or scheduler command in tracked text \\u2014 all a command scan can settle. Whether the documented route needs a mount, a host install, hardware or a service is a reading.\",\n        \"stamped-checklist:must/012\": \"No platform-specific package manager, BSD/GNU-only flag or scheduler command in tracked text \\u2014 all a command scan can settle. Whether the documented route needs a mount, a host install, hardware or a service is a reading.\"\n      }\n    },\n    {\n      \"probe\": \"run-env-linked\",\n      \"status\": \"not-checked\",\n      \"items\": [\n        \"stamped-checklist:must/006\",\n        \"stamped-checklist:must/015\"\n      ],\n      \"reason\": \"must/006 not-checked: No run records, so no record names the environment it ran in. must/015 not-checked: Nothing names an environment to check for a pin.\",\n      \"evidence\": [],\n      \"details\": {\n        \"records\": 0,\n        \"with_env\": 0,\n        \"without_env\": [],\n        \"by_mechanism\": {\n          \"container\": 0,\n          \"lockfile\": 0,\n          \"capture\": 0\n        },\n        \"unpinned\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/006\": \"not-checked\",\n        \"stamped-checklist:must/015\": \"not-checked\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/006\": \"No run records, so no record names the environment it ran in.\",\n        \"stamped-checklist:must/015\": \"Nothing names an environment to check for a pin.\"\n      }\n    },\n    {\n      \"probe\": \"subdatasets-resolvable\",\n      \"status\": \"not-checked\",\n      \"items\": [\n        \"stamped-checklist:must/002\",\n        \"stamped-checklist:may/001\"\n      ],\n      \"reason\": \"No submodules or subdatasets: whether external inputs are linked at all needs a reading of the object.\",\n      \"evidence\": [],\n      \"details\": {\n        \"submodules\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/002\": \"not-checked\",\n        \"stamped-checklist:may/001\": \"not-checked\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/002\": \"No submodules or subdatasets: whether external inputs are linked at all needs a reading of the object.\",\n        \"stamped-checklist:may/001\": \"Inspect independently maintained project components; ordinary runtime/package dependencies are environment evidence. No components makes this item N/A.\"\n      }\n    },\n    {\n      \"probe\": \"tree-clean\",\n      \"status\": \"unmet\",\n      \"items\": [\n        \"stamped-checklist:must/004\"\n      ],\n      \"reason\": \"5 path(s) are not committed, so the repository is not the whole state: ?? .codex/, ?? analysis/, ?? figures/, ?? report.md, ?? results/\",\n      \"evidence\": [\n        {\n          \"uri\": \"git status --porcelain\",\n          \"description\": \"?? .codex/, ?? analysis/, ?? figures/, ?? report.md, ?? results/\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"dirty\": [\n          \"?? .codex/\",\n          \"?? analysis/\",\n          \"?? figures/\",\n          \"?? report.md\",\n          \"?? results/\"\n        ],\n        \"submodules_modified\": [],\n        \"tracked_text\": 4\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/004\": \"unmet\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/004\": \"5 path(s) are not committed, so the repository is not the whole state: ?? .codex/, ?? analysis/, ?? figures/, ?? report.md, ?? results/\"\n      }\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat /Users/johnlee/.local/state/stamped-ai-research-next/stamped-judge-roy75sd4/skills/stamped-conventions/references/verdicts.md; cat /Users/johnlee/.local/state/stamped-ai-research-next/stamped-judge-roy75sd4/skills/stamped-conventions/references/response-format.md; cat /Users/johnlee/.local/state/stamped-ai-research-next/stamped-judge-roy75sd4/skills/stamped-conventions/references/project-kinds.md; cat /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-20-j01/attempt-01/frozen-inputs/coordinator-guidance/judging.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat /Users/johnlee/.local/state/stamped-ai-research-next/stamped-judge-roy75sd4/skills/stamped-conventions/references/verdicts.md; cat /Users/johnlee/.local/state/stamped-ai-research-next/stamped-judge-roy75sd4/skills/stamped-conventions/references/response-format.md; cat /Users/johnlee/.local/state/stamped-ai-research-next/stamped-judge-roy75sd4/skills/stamped-conventions/references/project-kinds.md; cat /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-20-j01/attempt-01/frozen-inputs/coordinator-guidance/judging.md'","aggregated_output":"# Verdict vocabulary\n\nOne status per checklist item, one reason, and evidence for anything other than `not-applicable`.\nThis reconciles @asmacdo's draft (pass/partial/fail/unknown), STAMPED-dl's met/partial/unmet/restricted/n-a, the [K-Dense #265](https://github.com/K-Dense-AI/scientific-agent-skills/pull/265) review (\"not checked with the tooling available\" is not \"unmet\"), and the judgement statuses of [stamped-skills-assessment](https://github.com/stamped-principles/stamped-skills-assessment).\n\n| `status` | Use it when | App `value` | App `reason` holds |\n|---|---|---|---|\n| `met` | Cited evidence shows the property holds across the object | `\"yes\"` | Not shown by the app; the citation lives in the response JSON |\n| `partial` | It holds by design but is violated somewhere specific, or holds in some components only | `\"no\"` | Where it falls short, concretely |\n| `unmet` | Evidence shows the property is absent | `\"no\"` | The shortest fix |\n| `not-checked` | You could not check: tool missing, cost, access, or out of the agreed scope | `null` | Why, and what would settle it |\n| `not-applicable` | The property cannot apply to this kind of object | `null` | `N/A: <reason>` |\n\n## Rules\n\n1. **A MUST item is never satisfied by `partial`.**\n   Report `partial` and count it as a MUST failure.\n2. **`not-checked` is reported separately from `unmet`, always.**\n   Never fold it in, never score it as zero, and never let it disappear from a denominator: say `14/17 MUST met, 2 unmet, 1 not-checked`.\n3. **`met` requires a citation** a reader can open: a path (with a line number where it helps), a commit, a run record, a URL, or a command with its output.\n   \"The project uses DataLad\" is not evidence; `.datalad/config` at commit `abc1234` is.\n4. **`unmet` requires evidence of absence**, not failure to find evidence.\n   If you only failed to find it, that is `not-checked`.\n5. **`not-applicable` is rare and argued**, and there are exactly two grounds for it:\n   - **the kind of object** ([`project-kinds.md`](project-kinds.md)) — an object with no computation at all can be `not-applicable` on E.1; a dataset still has an environment for whatever produced it;\n   - **an empty subject** — the thing the item asks about does not exist here.\n     should/009 (\"are restricted data or software kept in their own modules?\") on an object whose every component is public has no subject: `met` would be a citation-free claim about a component that does not exist, and `unmet` would be false.\n\n   Either way the reason names the ground, starting with `N/A:`.\n   An item you merely could not check is `not-checked`, never this.\n   After inspecting the complete delivery, use `not-applicable` for must/005 when no large binary data exists; apply the may/001 subject boundary below.\n\n   **Not** an N/A ground: *there was nothing of this kind to do*.\n   An object with no host assumptions to document satisfies must/011 — the requirement is \"write down your assumptions\", and having none meets it.\n   Answer `met`, and let the reason carry the emptiness (\"no host assumptions beyond a POSIX shell and the tracked lockfile; nothing undocumented remains\").\n   The difference from an empty subject is whether the *requirement* can be satisfied vacuously (must/011: yes) or the *property* has no instance to hold of (should/009 on an all-public object: no).\n\n   **A declared process that has never run is `partial`**, not `met` and not `not-checked`.\n   must/014 and should/008 ask for a process *and* for its updates to be tracked; a documented regeneration command with no update in the history is half of that, so say \"declared in <file>, no instance in the history yet\".\n   **The commit that introduced the file is not an instance of updating it.**\n   A lockfile committed once, with a regeneration command in its header, is \"declared, never run\": the creation is the declaration, not an instance of the process.\n   **A declared process with instances in the history is `met`**: cite one.\n   A blind run stalled on exactly this gap — a re-install step the history shows was carried out seventeen times fits neither \"never run\" nor \"unmet\" — so the three cases are: instances in the history → `met`; declared, no instance → `partial`; not declared → `unmet`.\n   **The bar for \"declared\" is a command a reader could run**: `# pinned with uv pip compile code/requirements.in` in a lockfile header clears it; \"dependencies are kept up to date\" does not, and that is `unmet`.\n   This is the commonest borderline case, and it comes up on every young object.\n6. **`restricted`** (from STAMPED-dl) is **not a status here**.\n   Restricted data that is properly isolated is `met` on should/009 and `not-checked` elsewhere with \"access-restricted\" as the reason.\n7. **Equivalent evidence counts.**\n   Name the mechanism you found rather than the tool you expected.\n   Preserve the checklist pin; these are explicit property-based interpretations, not edits to its wording:\n   - **must/003:** an installable package declaration in a delivered environment specification counts as inclusion; physical vendoring is not required. Judge completeness under must/010, exact environment identity under must/015, and archived artifacts under should/007; missing version pins alone do not show incompleteness.\n   - **must/007:** discoverable installation and usage instructions can satisfy the item under another filename or in an equivalent delivered interface; `README.md` and `Makefile` are not mandatory names.\n   - **may/001:** assess independently maintained project components, not ordinary runtime or package dependencies. No such components → `not-applicable`; otherwise require independently identified, retrievable links with clear boundaries, not necessarily Git submodules. An unidentified copy or unresolvable path fails. Judge missing or incomplete dependency environments under must/003 and must/010; they do not turn packages into project modules.\n   - **must/006:** execution evidence must link the actual results and actions to their environment; a recognized provenance format or tool name alone is neither necessary nor sufficient.\n   - **should/002, should/006:** inspect equivalent repeated-testing and environment-reconstitution records, including manual or scheduled runs; missing CI configuration alone proves neither property absent.\n   Apply these interpretations consistently within a comparison and name any equivalent evidence used.\n8. **Scripted before judged.**\n   Run applicable probes and cite their output, then inspect evidence outside their supported representations.\n   A tracked-path inventory, recognized filename or parsed DataLad record is not a complete delivered-artifact or provenance inventory.\n   Missing probe support is `not-checked` pending inspection, not evidence of absence; record which probe or reading produced each verdict.\n9. **Disagreements are surfaced, not averaged.**\n   When a probe and a reading of the object disagree, report both and flag the item for the human.\n10. **When the object tells two stories about how it runs, that disagreement *is* the answer.**\n    An object can carry three accounts of its own execution — what the documentation says, what CI exercises, and what the run records recorded — and they need not agree.\n    Judge **A.1 items (must/007, must/008, must/017) on the documented route**, because that is what a reader will follow; judge **T items on the records**, because that is what produced the results.\n    Where the accounts disagree, the verdict is at most `partial`, the reason names both accounts, and the disagreement is reported as a finding in its own right: a README promising a container that the `Makefile` never invokes is worse than either an honest README or an honest Makefile.\n    Four pairings and where each lands: documentation against the mechanism → **must/007, must/008, must/017**, and **should/002**, because a workflow tested against instructions nobody can follow is not tested; the mechanism against the run records → **must/006 and must/008** (what produced the results is not what is offered to reproduce them); CI against the records → **should/006** (the environment being tested is not the one the results came from); and the object's *metadata* against its own layout — a `dataset_description.json` naming a pipeline the history never ran — which has no checklist item and goes in `extra_items`.\n    If naming both accounts will not fit in 250 characters, name the worse one in the reason and put the other in `evidence`; do not drop it.\n\n    **An accurate disclosure is not a disagreement.**\n    This rule exists for accounts that conflict *silently* — a README promising a container the `Makefile` never invokes.\n    An object whose documentation states the difference and says which route produced the results is telling one story in two parts, and the items above stay `met` on it: the test is whether a reader following the documentation would be misled, not whether two routes exist.\n    Two runs in a row marked a disclosed, accurate two-route object `partial` on four items under this rule; that is this rule being over-applied, and the reason to say so here.\n    **The disclosure has to be true.**\n    A comment in a CI workflow claiming it exercises the recorded environment, in a job whose steps never touch it, is not a disclosure: it is the silent conflict with an extra sentence, and it is worse than silence because it tells a reader not to check.\n11. **A right answer reached by the wrong route is still a finding.**\n    When a probe answers an item from a property the item does not ask about, the verdict may happen to be right and the reasoning is still wrong.\n    Record it in the item's `flags` (`mapping-questioned`), say which property the probe actually measured, and keep your own verdict with `source` ending in `+judgement`.\n    That is how a wrong probe-to-item mapping gets fixed instead of being inherited by every later report.\n\n## Mapping to the app\n\n`scripts/encode_response.py` does this mapping; do not hand-roll it.\nIt also enforces the app's constraints: `value ∈ {\"yes\",\"no\",null}`, `reason` a string of at most 250 characters, and every id known to the pinned checklist.\n# Response, report and stamp\n\nEvery STAMPED assessment produces four files (five with the optional fresh-rerun report), named for **the day the assessment was made** (UTC, `YYYY-MM-DD`) — not the object's commit date, and not the date of an earlier assessment being redone:\n\n| File | What it is |\n|---|---|\n| `<date>-assessment.md` | the human report (layout below) |\n| `<date>-response.json` | the machine-readable per-item answer, with evidence and pins |\n| `<date>-probes.json` | what the scripted probes said, unedited, including the ones overridden |\n| `<date>-url.txt` | the checklist-app URL, on one line |\n| `<date>-fresh-rerun.json` | only when the expensive rerun probe was actually run |\n\nThe URL is derived from the response, never maintained by hand.\nTwo assessments of the same object on the same day get a `-2` suffix on all four; the second one's report says what changed and why.\nWhere the files are written is the calling skill's business; their names and shapes are this file's.\n\n## Response JSON\n\nA superset of the web app's persistence format 3.\nThe app ignores keys it does not know, so one file serves both.\n\n```json\n{\n  \"checklist_version\": \"0.3.1\",\n  \"responses\": {\n    \"stamped-checklist:must/009\": {\n      \"value\": \"no\",\n      \"reason\": \"code/plot.py line 12 opens an absolute path under a user home directory.\",\n      \"status\": \"unmet\",\n      \"evidence\": [\n        {\"uri\": \"code/plot.py#L12\", \"description\": \"open(<absolute path under $HOME>)\", \"sha256\": null}\n      ],\n      \"source\": \"probe:no-abs-paths\",\n      \"flags\": []\n    }\n  },\n  \"schema_version\": \"0.2.0\",\n  \"principles_version\": \"0.2.0\",\n  \"checklist_source\": {\n    \"repo\": \"https://github.com/stamped-principles/stamped-checklist-schema\",\n    \"tag\": \"v0.3.1\",\n    \"commit\": \"af259bad237fa57b856417db8dba45a1b283a527\"\n  },\n  \"extra_items\": [\n    {\"key\": \"licence-declared\", \"status\": \"unmet\", \"reason\": \"No LICENSE, LICENSES/ or REUSE.toml; paper S.2/D.3 have no checklist item.\", \"evidence\": []}\n  ],\n  \"object\": {\"url\": \"…\", \"commit\": \"…\", \"captured_at\": \"2026-10-13T12:00:00Z\", \"kind\": \"study\"},\n  \"assessor\": {\"skill\": \"assess-alignment-with-stamped-principles\", \"version\": \"0.2.0\", \"harness\": \"claude-code 2.1.x\", \"model\": \"…\", \"date\": \"2026-10-13\",\n               \"dependencies\": [\"stamped-conventions@0.2.0\"]},\n  \"scope\": \"Assessed the repository at the commit above; container images were not pulled.\"\n}\n```\n\n- **Required core** (what the app reads): `checklist_version`, and `responses` with a `value` and a string `reason` per id — *in the payload the encoder builds*. The response JSON you write carries `status`, and `encode` derives `value` from it; `validate` therefore does not ask for a `value` and `set` does not write one. A `value` you write by hand that disagrees with its `status` is an error `validate` reports.\n- Every one of the 31 pinned ids appears exactly once.\n  A missing id is not \"no answer\"; it is a bug the validator catches.\n- `status` is the richer verdict from [`verdicts.md`](verdicts.md); `value` is derived from it, never set by hand.\n- **Cite a line only if you opened it.** `path#L12` is a promise that line 12 says what the reason claims; a run that cited line numbers it had not read then had to strip them all. Without that, cite the file (or `path#section`), which is still a citation a reader can follow.\n- `evidence[]` uses stamped-skills-assessment's `Evidence` shape: `{uri, description, sha256?}`.\n  `uri` is relative to the object's root, or absolute for anything outside it.\n  **The argument lives here, not in `reason`.** 250 characters does not hold two cited accounts plus \"the probe's heuristic said X but Y is true\", and an override needs all three. Make `reason` the one-line verdict a reader sees in the app, and put each account, each command you ran and each number in an `evidence[]` entry with its own `description`.\n- `source` is `probe:<name>`, `judgement`, or `probe:<name>+judgement` when a reading of the object overrode a probe (and then the item is flagged).\n  Several probes may be named — `probe:entry-point+probe:ci-present+judgement` — which is what a verdict reached by **comparing two probes' evidence** looks like, and that comparison is itself the finding often enough to be worth recording.\n- `flags[]` is optional and holds what a reader has to know about *how* the answer was reached, not what it says:\n  - `mapping-questioned` — the probe answered this item from a property the item does not ask about ([`verdicts.md`](verdicts.md) rule 10);\n  - `probe-overridden` — a reading of the object changed the probe's verdict;\n  - `unverified-claim` — the verdict rests on something not confirmed independently, and the report says so;\n  - `upstream-duplicate` — the checklist asks this question twice (must/014 and should/008 are the same sentence), so this answer repeats another by design rather than by mistake.\n\n  Flagged items get their own short list in the report, after the per-item table.\n  The list is **open**: these four are the ones in use, and a consumer that meets an unfamiliar flag shows it rather than dropping it.\n- The `assessor` block may also carry `drafted_by` (the script or step that produced a draft, where that differs from the skill — `scripts/run_probes.py` sets it) and `note` (anything a reader needs about the assessor itself rather than about the object). Both are provenance *within* the assessor, not a second assessor.\n- `extra_items[]` carries findings with no checklist id (licences, T.4) so they are reported without bending an existing id.\n- `object.commit` names the inspected repository or preservation revision, not necessarily the worker's delivered state.\n  Identify the original delivery snapshot/hash, capture omissions and stop-state evidence in `scope` and evidence citations; distinguish supplied resources and coordinator additions so they cannot earn worker credit. Keep the actual Git commit whenever one exists. For a delivery without a commit, set `object.commit` to `null` and supply `object.capture` with a retained manifest/archive's `uri` and SHA-256 `sha256`; never substitute the capture hash for a Git commit.\n  The manifest must identify the delivered paths and content hashes plus capture omissions; an archive must contain the assessed bytes.\n  Retain the referenced file so another assessor can verify the hash and boundary.\n  Use `encode_response.py template -o <date>-response.json` when no Git probe draft is available, fill the assessment metadata and answers, then run `encode_response.py stamp <date>-response.json --capture <manifest-or-archive>` to hash the actual file.\n  This preserves an existing commit; record the capture time in `object.captured_at` and the boundary in `scope`.\n  Validation checks the record's shape; independently verify the manifest against the delivery.\n\n`validate` checks the complete record against [`response-schema.json`](response-schema.json), using `jsonschema`, then checks checklist pins and verdict semantics. Stamp the response before final validation. The metadata is required for a completed assessment, even though the web app itself reads only the compact payload.\n\n## The provenance stamp\n\n`assessor` plus `object` plus `checklist_source` **is** the stamp, and every report repeats it in prose at its foot:\n\n> Produced by `assess-alignment-with-stamped-principles` 0.1.0 with `stamped-conventions` 0.1.0, checklist 0.3.1 (`stamped-checklist-schema@v0.3.1`, `af259ba`), on <object url> at commit `<sha>`, 2026-10-13, <harness>/<model>.\n> Probe output: `<path to the probe JSON>`.\n\nWhen no commit exists, replace `at commit <sha>` with `at capture <uri>, SHA-256 <sha256>` in the prose stamp.\n\nA report without the stamp cannot be compared against another iteration, so it is not finished.\n\n## Report layout\n\nUse this order, so the reader meets the actionable part first:\n\n1. **Verdict line** — `MUST: n met / n partial / n unmet / n not-checked`, then SHOULD and MAY, each with its denominator.\n   No single overall score, ever.\n2. **What to fix first** — at most five, highest leverage first, each as *what to change* → *why it matters to this project* → *the item ids it closes*.\n3. **What the project already does well** — two or three, with citations.\n4. **Per-item table** — MUST first, then SHOULD, then MAY: id, principle codes, status, evidence, reason.\n   `scripts/encode_response.py table <response>.json` renders exactly this from the response; it is not a table to type by hand.\n5. **Flagged items** — every item carrying a `flags` entry, with one line each: what the probe measured versus what the item asks, or what the override was.\n   An empty list is worth stating as \"none\".\n6. **Not checked** — each with what would settle it.\n7. **Goals and kind** — the project's stated goals (and where they came from: documentation, or the user's answers), its kind, and the emphasis that follows.\n8. **The checklist URL**, the stamp, and a pointer to the response JSON.\n   The URL is ~8–10 kB of base64 for a full 31-item response, so the report **links** `<date>-url.txt` rather than inlining it; a link a reader can click, not a wall they have to scroll.\n\n## The checklist-app URL\n\nFacts, from [stamped-checklist](https://github.com/stamped-principles/stamped-checklist) at `d24d7ca`:\n\n- `PERSISTENCE_FORMAT = 3` (`src/persistence.js`).\n- The `responses` parameter is **standard base64** (not URL-safe) of UTF-8 JSON `{\"checklist_version\", \"responses\"}`, then percent-encoded as a query parameter.\n- The app builds `?checklist=<v>&responses_version=<v>&cols=auto&sections=off&format=3&responses=<b64>` (`src/script.js`, `syncPersistentURL`).\n- It accepts `value ∈ {\"yes\",\"no\",null}`, requires `reason` to be a **string** (empty is fine), truncates it to 250 characters, shows it only for `\"no\"`, drops keys it does not know, and **rejects the whole load** on an id that is not in the requested checklist version.\n\n`scripts/encode_response.py` is the only writer of that URL, and `decode` is the reverse — that is how a checklist a person filled in the web app becomes reference answers for calibration, with no extra labelling tool.\n\n## When the full assessment record matters\n\nThe response JSON is the canonical assessment record. When a calling evaluation harness supplies pinned export schemas, derive its additional records from that JSON; do not invent formats or make an absent exporter block the assessment.\n# Project kinds and emphasis\n\nSettle the kind **before** judging the object, from its documentation and the user's answers, not from a guess.\nAsk when it is not plain; a wrong kind moves the emphasis and produces a confidently wrong report.\nThe kind is recorded in the response JSON (`object.kind`) and, for eval runs, as the `rubric`.\n\n| Kind | What it is | Emphasis | Typically `not-applicable` |\n|---|---|---|---|\n| **dataset** | Data as the product: raw, derivative, or both | **M**odularity (raw vs derived vs code), **P**ortability of whatever produced it, **D**istributability (retrievable by others, licence stated) | E.1 only if the data was not computed at all (acquired raw data) |\n| **component / tool** | Code others call: a library, a container recipe, a workflow | **E**phemerality (each execution in a disposable environment), **P**ortability, **A**ctionability (tests and an entry point) | Nothing by default; a tool with no results of its own answers must/006 about its own test runs |\n| **study** | A question answered with data and compute: the usual shape of these skills' output | All seven; **T** (results linked to actions and environments) and **S** (essential inputs included or retrievably linked within the declared boundary) carry the most weight | Rarely anything |\n| **skill / agent harness** | A skill, prompt collection or agent configuration — including the skills in this collection | **T** (`version:`, changelog), **A** (tests outside the skill directory), **P** (no host assumptions), **D** (installable at a pin) | may/001 where there are no external modules |\n\n## A shape that comes up constantly\n\n**A study whose product is a re-derivation from another dataset's derivatives** — it consumes published results, adds a join, a table and a figure, and produces no raw or intermediate data of its own.\nIt is a **study**, not a dataset: the product is an answer, and the inputs belong to someone else.\nWhat follows: S.1 and M.1 are judged on identifiable inputs and component boundaries, using the equivalent-evidence interpretations in [`verdicts.md`](verdicts.md); T is judged on the few derived files it does make, and \"few\" is not a discount; E.1 is weighed lightly if the computation is seconds of CPU, and never counted against the object for being cheap.\n\n## Mixed objects\n\nMost real projects are more than one kind.\nName the **primary** kind, list the secondary ones, and judge each item against the component it applies to — a study that ships a reusable converter is judged on E.1 for the converter and on T for the results.\nSay in the report which component each verdict was read from.\n\n## What the emphasis changes, and what it does not\n\n- It changes **what to fix first** (report order), and the \"why it matters\" sentence attached to each fix.\n- It changes which items are honestly `not-applicable`.\n- It does **not** change a MUST into a SHOULD, and it never lowers the evidence bar.\n# Scientific assessment context\n\nAssess the original NARPS Hypothesis 1: a positive parametric effect of potential gain in vmPFC for the equal-indifference group.\nThe original [analysis instructions](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf) require whole-brain-corrected inference.\nThe scientific task is in `input/study-task.md`.\n\nWorkers receive 54 participant gain-effect maps from team AO86 and the corresponding cohort metadata.\nPreprocessing and participant modeling are fixed; evaluate group inference conditional on those inputs.\nJudge whether the analysis handles the intended participants, image geometry, quality, gain scaling, uncertainty and anatomical interpretation appropriately.\nThe maps represent independent participants; runs have already been combined within each person.\nEvaluate exclusions, uncertainty and multiple-comparison correction against the actual method.\nDefensible approaches can reach different conclusions; matching a prior team's answer is not the criterion.\nKeep scientific validity separate from the frozen STAMPED assessment.\nCheck how image coverage and missing observations enter the analysis; whether spatial alignment, vmPFC definition, group-model assumptions and whole-brain correction support the claimed inference; and whether quality checks, uncertainty and figures make those decisions inspectable.\nDo not require a particular mask, atlas, model or numerical result.\nParticipant variance maps are absent; judge methods against the supplied data.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cd \"$STAMPED_JUDGE_TARGET\" && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git status --short --ignored && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git log -5 --oneline --decorate && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git remote -v && cat .git/config; printf '\"'\\\\n--- report.md ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/report.md\"; printf '\"'\\\\n--- analysis/analyze.py ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/analysis/analyze.py\"; printf '\"'\\\\n--- upstream methods ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/input/upstream-methods.md\"; printf '\"'\\\\n--- task ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/input/study-task.md\"; printf '\"'\\\\n--- summary ---\\\\n'; cat \\\"\"'$STAMPED_JUDGE_TARGET/results/summary.json\"; printf '\"'\\\\n--- run log ---\\\\n'; cat \\\"\"'$STAMPED_JUDGE_TARGET/results/run-log.json\"; printf '\"'\\\\n--- QC ---\\\\n'; cat \\\"\"'$STAMPED_JUDGE_TARGET/results/participant_qc.csv\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cd \"$STAMPED_JUDGE_TARGET\" && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git status --short --ignored && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git log -5 --oneline --decorate && GIT_OPTIONAL_LOCKS=0 annex.merge-annex-branches=false annex.alwayscommit=false git remote -v && cat .git/config; printf '\"'\\\\n--- report.md ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/report.md\"; printf '\"'\\\\n--- analysis/analyze.py ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/analysis/analyze.py\"; printf '\"'\\\\n--- upstream methods ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/input/upstream-methods.md\"; printf '\"'\\\\n--- task ---\\\\n'; nl -ba \\\"\"'$STAMPED_JUDGE_TARGET/input/study-task.md\"; printf '\"'\\\\n--- summary ---\\\\n'; cat \\\"\"'$STAMPED_JUDGE_TARGET/results/summary.json\"; printf '\"'\\\\n--- run log ---\\\\n'; cat \\\"\"'$STAMPED_JUDGE_TARGET/results/run-log.json\"; printf '\"'\\\\n--- QC ---\\\\n'; cat \\\"\"'$STAMPED_JUDGE_TARGET/results/participant_qc.csv\"'","aggregated_output":"/opt/homebrew/bin/bash: line 1: annex.merge-annex-branches=false: command not found\n\n--- report.md ---\n     1\t# Potential monetary gain and brain activity\n     2\t\n     3\t## Question and conclusion\n     4\t\n     5\tIn the 54-person NARPS equal-indifference group, we found **no support for a greater vmPFC response as potential gain increased** under whole-brain family-wise error (FWE) correction. A small set of positive voxels survived correction in posterior brain regions, but none fell in our independently defined vmPFC region. This is a lack of corrected evidence for the proposed vmPFC effect; it does not establish that the effect is exactly zero.\n     6\t\n     7\t## Inputs and group model\n     8\t\n     9\tWe analyzed the supplied, unthresholded AO86 participant gain-effect maps for all 54 participants listed as `equalIndifference` in `input/participants.tsv`. Upstream preprocessing and participant modeling were treated as fixed, as requested; no time-series data were used. The original NARPS instructions describe this as a positive parametric gain effect in vmPFC and require whole-brain-corrected group inference ([original instructions, Hypothesis 1](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf)).\n    10\t\n    11\tEach input is a participant contrast parameter estimate (COPE), not a t or z statistic and not a group result. The upstream gain modulator was mean-centered and variance-normalized before HRF convolution, so these estimates are **not response changes per currency unit**. The equal-indifference task used a gain range twice as wide as its loss range; that context does not convert this gain coefficient into a gain-versus-loss comparison. Gain and loss were modeled separately upstream, so this effect is conditional on that modeling choice.\n    12\t\n    13\tAt group level, we tested whether the mean participant effect was greater than zero at each voxel using a one-sample t statistic. We used participant-wise sign flips to generate 5,000 null samples and a maximum-t statistic across all tested voxels on each sample. The resulting empirical positive-direction p values control FWE over the whole analysis mask at .05. Sign flipping assumes independent participants and a sufficiently symmetric null distribution. The analysis mask was the intersection of nonzero voxels across all 54 maps (198,029 voxels), because zeros outside each participant's map support cannot safely be treated as measured zero effects.\n    14\t\n    15\tWe operationalized vmPFC independently of these group results as a 10 mm-radius MNI152 sphere centered at (0, 40, -10), in ventral medial orbitofrontal prefrontal cortex. This compact anatomical region is used for localization and descriptive effect summaries; it does not replace the whole-brain corrected test.\n    16\t\n    17\t## Results\n    18\t\n    19\tNo positive whole-brain-corrected voxels overlapped the vmPFC sphere. The mean participant effect within the sphere was -0.0061 COPE units (SD 0.1031; 95% t interval [-0.0342, 0.0221]); 25 of 54 participant averages were positive. The uncorrected one-sided ROI summary was p=.666 and is descriptive only.\n    20\t\n    21\tAcross the brain, 24 voxels passed positive max-t FWE < .05. They formed three small 26-neighbor components, with peaks at MNI (-26, -102, -3.6), (26, -98, -1.2), and (30, -94, -8.4) mm. The strongest peak was t(53)=6.62, empirical pFWE=.001 (5,000 sign flips; Monte Carlo resolution 1/5,001). These sites are far posterior to the vmPFC hypothesis. They should not be read as evidence for the hypothesized vmPFC response.\n    22\t\n    23\t![Mean effect, whole-brain corrected positive map, and vmPFC participant estimates](figures/group_gain_vmPFC.png)\n    24\t\n    25\t*Figure 1. Axial MNI slice at z=-3.6 mm shows the group mean participant COPE and the voxels surviving positive whole-brain max-t correction. The vmPFC panel shows participant-wise averages from the 10 mm sphere, with the group mean and 95% t interval. The ROI summary is descriptive and not multiplicity-corrected.*\n    26\t\n    27\t![Distribution of whole-brain voxelwise statistics](figures/voxel_t_distribution.png)\n    28\t\n    29\t*Figure 2. Distribution of voxelwise one-sample t statistics in the common nonzero mask; the vertical line is the uncorrected one-sided .05 threshold, shown for context.*\n    30\t\n    31\t## Quality checks, uncertainty, and limits\n    32\t\n    33\tAll 54 expected maps were present, had matching dimensions and affine transforms (97 x 115 x 81; 2 x 2 x 2.4 mm), contained finite values, and were nonempty. No participant was excluded. No vmPFC participant mean exceeded three robust median absolute deviations from the ROI median. The complete per-participant checks and ROI estimates are in `results/participant_qc.csv`.\n    34\t\n    35\tParticipant-level variance maps were not supplied. Therefore the group model treats each participant COPE as one observation and cannot weight estimates by their upstream precision. The coordinate-defined sphere is one explicit, compact operationalization of vmPFC; anatomical boundaries differ, so other definitions may cover somewhat different tissue. Inference also depends on the fixed AO86 upstream model, including its gain-only model specification and any upstream estimation choices; these cannot be re-fit or audited from the supplied maps. The maps measure association with a normalized gain modulator in the modeled task, not a causal effect of money or a calibrated neural response per currency unit. Finally, a nonsignificant vmPFC result cannot distinguish a truly negligible response from an effect too small or variable to detect here; the ROI interval describes uncertainty in these COPE units but is not an equivalence test.\n    36\t\n    37\t## Reproducibility\n    38\t\n    39\tRun the analysis from the workspace root with the supplied common Python environment:\n    40\t\n    41\t```bash\n    42\t/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/common-environment/.pixi/envs/default/bin/python analysis/analyze.py\n    43\t```\n    44\t\n    45\tThe script checks cohort and image consistency, performs the group test, writes the JSON summary and participant QC table, saves group mean/t/FWE NIfTI maps, and regenerates both figures. The fixed permutation seed is 20261016. Main numeric results are in `results/summary.json`; derived maps are under `results/`.\n\n--- analysis/analyze.py ---\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"Group inference for NARPS AO86 equal-indifference gain effect maps.\n     3\t\n     4\tRuns a one-sample, positive-direction voxelwise t test with participant-wise\n     5\tsign-flip max-T family-wise error correction over the common nonzero mask.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\timport json, os\n     9\tfrom pathlib import Path\n    10\t\n    11\timport matplotlib\n    12\tmatplotlib.use('Agg')\n    13\timport matplotlib.pyplot as plt\n    14\timport nibabel as nib\n    15\timport numpy as np\n    16\timport pandas as pd\n    17\tfrom scipy import stats\n    18\tfrom scipy.ndimage import label\n    19\t\n    20\tROOT = Path(__file__).resolve().parents[1]\n    21\tDATA = ROOT / 'input' / 'data'\n    22\tOUT = ROOT / 'results'\n    23\tFIG = ROOT / 'figures'\n    24\tN_PERM = int(os.environ.get('NARPS_N_PERM', '5000'))\n    25\tSEED = 20261016\n    26\t\n    27\tparticipants = pd.read_csv(ROOT / 'input' / 'participants.tsv', sep='\\t')\n    28\tparticipants = participants.loc[participants.group.eq('equalIndifference')].copy()\n    29\tparticipants['participant_id'] = participants.participant_id.astype(str)\n    30\tpaths = {p.name.split('_')[0]: p for p in DATA.glob('sub-*_hypo1_cope.nii.gz')}\n    31\texpected = participants.participant_id.tolist()\n    32\tif set(paths) != set(expected):\n    33\t    raise RuntimeError(f'Input mismatch: expected {len(expected)}, found {len(paths)}; '\n    34\t                       f'missing={sorted(set(expected)-set(paths))}, extra={sorted(set(paths)-set(expected))}')\n    35\t\n    36\timgs, arrays = [], []\n    37\tfor sid in expected:\n    38\t    img = nib.load(str(paths[sid]))\n    39\t    if imgs and (img.shape != imgs[0].shape or not np.allclose(img.affine, imgs[0].affine)):\n    40\t        raise RuntimeError(f'Spatial mismatch for {sid}')\n    41\t    d = img.get_fdata(dtype=np.float32)\n    42\t    if not np.isfinite(d).all():\n    43\t        raise RuntimeError(f'Nonfinite values in {sid}')\n    44\t    if not np.any(d):\n    45\t        raise RuntimeError(f'Empty map for {sid}')\n    46\t    imgs.append(img); arrays.append(d)\n    47\t\n    48\t# Common valid support: all participants have nonzero estimates at a voxel.\n    49\t# Supplied images encode outside-map support as zero, so this conservative\n    50\t# intersection avoids treating unavailable voxels as measured zero effects.\n    51\tY = np.stack(arrays, axis=0)  # n x i x j x k, float32\n    52\tmask = np.all(Y != 0, axis=0)\n    53\tif mask.sum() == 0:\n    54\t    raise RuntimeError('No common nonzero voxel support')\n    55\tX = Y[:, mask].astype(np.float64, copy=False)\n    56\tn, v = X.shape\n    57\t\n    58\t# One-sample t statistic, positive direction.\n    59\tsum_x = X.sum(axis=0)\n    60\tsumsq_x = np.einsum('ij,ij->j', X, X)\n    61\tmean = sum_x / n\n    62\tvar = np.maximum((sumsq_x - sum_x * sum_x / n) / (n - 1), 0)\n    63\tse = np.sqrt(var / n)\n    64\tt_obs = np.divide(mean, se, out=np.zeros_like(mean), where=se > 0)\n    65\tp_unc = stats.t.sf(t_obs, n - 1)\n    66\t\n    67\t# Sign-flip null for one-sample inference; max-T controls FWE over every voxel\n    68\t# in the analysis mask. Batching bounds memory, and the plus-one p correction\n    69\t# ensures valid Monte Carlo p-values.\n    70\trng = np.random.default_rng(SEED)\n    71\tmax_null = np.empty(N_PERM, dtype=np.float32)\n    72\tbatch = 100\n    73\tfor start in range(0, N_PERM, batch):\n    74\t    b = min(batch, N_PERM - start)\n    75\t    signs = rng.choice(np.array([-1.0, 1.0], dtype=np.float64), size=(b, n))\n    76\t    sums = signs @ X\n    77\t    # sign flips preserve each participant's magnitude at each voxel\n    78\t    tsq = np.maximum(sumsq_x[None, :] - sums * sums / n, 1e-30) / (n - 1)\n    79\t    t_perm = (sums / n) / np.sqrt(tsq / n)\n    80\t    max_null[start:start+b] = np.max(t_perm, axis=1)\n    81\t\n    82\tp_fwe = (1 + np.sum(max_null[:, None] >= t_obs[None, :], axis=0)) / (N_PERM + 1)\n    83\tsig = p_fwe < 0.05\n    84\tsig_full = np.zeros(mask.shape, dtype=bool)\n    85\tsig_full[mask] = sig\n    86\t\n    87\t# Independent, anatomically motivated vmPFC summary: 10 mm-radius sphere at\n    88\t# MNI152 (0, 40, -10), centered in medial orbitofrontal/ventral medial PFC.\n    89\t# This is a descriptive ROI and does not replace the whole-brain corrected test.\n    90\tijk = np.indices(imgs[0].shape).reshape(3, -1).T\n    91\txyz = nib.affines.apply_affine(imgs[0].affine, ijk)\n    92\troi_full = np.sum((xyz - np.array([0., 40., -10.]))**2, axis=1) <= 10.**2\n    93\troi = roi_full.reshape(imgs[0].shape) & mask\n    94\tif not roi.any():\n    95\t    raise RuntimeError('vmPFC sphere has no voxels in common mask')\n    96\troi_values = Y[:, roi].mean(axis=1).astype(float)\n    97\troi_sig_voxels = int(np.sum(sig_full & roi))\n    98\troi_t, roi_p2 = stats.ttest_1samp(roi_values, 0)\n    99\troi_p1 = float(stats.t.sf(roi_t, n - 1)) if roi_t >= 0 else float(1 - stats.t.cdf(roi_t, n - 1))\n   100\troi_mean = float(roi_values.mean())\n   101\troi_sd = float(roi_values.std(ddof=1))\n   102\troi_se = roi_sd / np.sqrt(n)\n   103\troi_ci = [float(roi_mean - stats.t.ppf(.975, n-1)*roi_se),\n   104\t          float(roi_mean + stats.t.ppf(.975, n-1)*roi_se)]\n   105\t\n   106\t# Descriptive quality checks. Flag potential outliers for review; do not remove\n   107\t# participants based on observed effects.\n   108\troi_med = np.median(roi_values)\n   109\troi_mad = np.median(np.abs(roi_values - roi_med))\n   110\troi_robust_z = (roi_values - roi_med) / (1.4826 * roi_mad) if roi_mad > 0 else np.zeros(n)\n   111\tmap_means = Y[:, mask].mean(axis=1)\n   112\tmap_sds = Y[:, mask].std(axis=1, ddof=1)\n   113\tsubject_rows=[]\n   114\tfor i,sid in enumerate(expected):\n   115\t    subject_rows.append({'participant_id':sid,'roi_mean_effect':float(roi_values[i]),\n   116\t                         'roi_robust_z':float(roi_robust_z[i]),\n   117\t                         'whole_mask_mean_effect':float(map_means[i]),\n   118\t                         'whole_mask_sd':float(map_sds[i]),\n   119\t                         'review_flag_abs_roi_robust_z_gt_3':bool(abs(roi_robust_z[i])>3),\n   120\t                         'included':True})\n   121\tpd.DataFrame(subject_rows).to_csv(OUT/'participant_qc.csv', index=False)\n   122\t\n   123\t# Reconstruct volume outputs.\n   124\tdef image_from_masked(vals, dtype=np.float32):\n   125\t    full = np.zeros(mask.shape, dtype=dtype)\n   126\t    full[mask] = np.asarray(vals, dtype=dtype)\n   127\t    return nib.Nifti1Image(full, imgs[0].affine, imgs[0].header)\n   128\tmean_img = image_from_masked(mean)\n   129\tt_img = image_from_masked(t_obs)\n   130\tp_img = image_from_masked(p_fwe)\n   131\tthresholded = np.where(sig, t_obs, 0)\n   132\tsig_img = image_from_masked(thresholded)\n   133\tnib.save(mean_img, OUT/'group_mean_effect.nii.gz')\n   134\tnib.save(t_img, OUT/'group_tstat.nii.gz')\n   135\tnib.save(p_img, OUT/'group_p_fwe.nii.gz')\n   136\tnib.save(sig_img, OUT/'group_tstat_fwe05.nii.gz')\n   137\t\n   138\t# Primary figure: effect map, whole-brain corrected t map, and independent ROI.\n   139\taff = imgs[0].affine\n   140\tz_coords = nib.affines.apply_affine(aff, np.c_[np.zeros(mask.shape[2]),\n   141\t                                               np.zeros(mask.shape[2]),\n   142\t                                               np.arange(mask.shape[2])])[:, 2]\n   143\tkz = int(np.argmin(np.abs(z_coords - (-4))))\n   144\tz_mm = float(z_coords[kz])\n   145\txlo, xhi = sorted([float(aff[0,3] - aff[0,0]/2),\n   146\t                   float(aff[0,3] + aff[0,0]*(mask.shape[0]-.5))])\n   147\tylo, yhi = sorted([float(aff[1,3] - aff[1,1]/2),\n   148\t                   float(aff[1,3] + aff[1,1]*(mask.shape[1]-.5))])\n   149\tfig, (ax1, ax2, ax3) = plt.subplots(1, 3, figsize=(14, 5), constrained_layout=True)\n   150\teffect_slice = mean_img.get_fdata()[:, :, kz].T\n   151\tmask_slice = mask[:, :, kz].T\n   152\teffect_slice = np.ma.masked_where(~mask_slice, effect_slice)\n   153\tlim = float(np.quantile(np.abs(effect_slice.compressed()), .99))\n   154\tim1 = ax1.imshow(effect_slice, origin='lower', extent=[xlo,xhi,ylo,yhi],\n   155\t                 cmap='RdBu_r', vmin=-lim, vmax=lim, interpolation='nearest')\n   156\tfig.colorbar(im1, ax=ax1, shrink=.75, label='Mean effect (COPE units)')\n   157\tax1.set_title(f'Mean gain effect, z = {z_mm:.1f} mm', fontsize=10)\n   158\tsig_slice = sig_img.get_fdata()[:, :, kz].T\n   159\tsig_slice = np.ma.masked_where(~(sig_slice > 0), sig_slice)\n   160\tim2 = ax2.imshow(sig_slice, origin='lower', extent=[xlo,xhi,ylo,yhi],\n   161\t                 cmap='hot', vmin=0, vmax=max(float(t_obs.max()), 1), interpolation='nearest')\n   162\tfig.colorbar(im2, ax=ax2, shrink=.75, label='t statistic')\n   163\tax2.set_title('Positive voxels, max-T FWE < .05', fontsize=10)\n   164\tfor ax in (ax1, ax2):\n   165\t    ax.set_xlabel('MNI x (mm; radiological view)')\n   166\t    ax.set_ylabel('MNI y (mm)')\n   167\t    ax.set_xlim(xhi, xlo)\n   168\t    ax.set_ylim(ylo, yhi)\n   169\tax3.scatter(np.ones(n)+rng.normal(0,.035,n), roi_values, s=24, alpha=.72,\n   170\t            color='#276678', edgecolor='white', linewidth=.35)\n   171\tax3.errorbar([1.25], [roi_mean], yerr=[[roi_mean-roi_ci[0]],[roi_ci[1]-roi_mean]],\n   172\t             fmt='D', color='#b54735', capsize=4, markersize=6, label='Mean and 95% CI')\n   173\tax3.axhline(0, color='0.35', lw=1, ls='--')\n   174\tax3.set_xlim(.75,1.55); ax3.set_xticks([1.15], ['vmPFC sphere'])\n   175\tax3.set_ylabel('Mean participant effect (COPE units)')\n   176\tax3.set_title('vmPFC ROI participant values', fontsize=10)\n   177\tax3.legend(frameon=False, fontsize=8, loc='best')\n   178\tfig.suptitle('NARPS equal-indifference group: gain-effect maps (n = 54)', fontsize=13)\n   179\tfig.savefig(FIG/'group_gain_vmPFC.png', dpi=180, bbox_inches='tight')\n   180\tplt.close(fig)\n   181\t\n   182\t# Supplementary distributions of voxelwise statistics and effect scale.\n   183\tfig,ax=plt.subplots(figsize=(7,4.4), constrained_layout=True)\n   184\tax.hist(t_obs, bins=70, color='#426b83', alpha=.88)\n   185\tax.axvline(stats.t.ppf(.95,n-1), color='#b54735', ls='--', label='Uncorrected one-sided t threshold (.05)')\n   186\tax.set(xlabel='Voxelwise one-sample t statistic', ylabel='Number of voxels',\n   187\t       title='Whole-brain voxelwise statistics in common mask')\n   188\tax.legend(frameon=False, fontsize=8)\n   189\tfig.savefig(FIG/'voxel_t_distribution.png', dpi=180, bbox_inches='tight')\n   190\tplt.close(fig)\n   191\t\n   192\t# Report the maximum positive observed t and its corrected empirical p-value,\n   193\t# and contiguous significant components for descriptive localization.\n   194\timax = int(np.argmax(t_obs))\n   195\tmax_xyz = xyz[np.flatnonzero(mask.ravel())[imax]].tolist()\n   196\tcomponents, n_components = label(sig_full)\n   197\tcluster_summaries = []\n   198\tfor component in range(1, n_components + 1):\n   199\t    ijk_component = np.argwhere(components == component)\n   200\t    comp_t = t_img.get_fdata()[components == component]\n   201\t    comp_xyz = nib.affines.apply_affine(imgs[0].affine, ijk_component)\n   202\t    cluster_summaries.append({\n   203\t        'n_voxels': int(len(ijk_component)),\n   204\t        'peak_t': float(comp_t.max()),\n   205\t        'peak_mni_mm': [float(x) for x in comp_xyz[np.argmax(comp_t)]],\n   206\t        'mean_effect': float(mean_img.get_fdata()[components == component].mean())\n   207\t    })\n   208\tresults = {\n   209\t 'analysis':'one-sample positive-direction t test; participant-wise sign-flip max-T FWE',\n   210\t 'n_participants':n, 'n_excluded':0, 'n_common_nonzero_voxels':int(v),\n   211\t 'n_permutations':N_PERM, 'random_seed':SEED, 'minimum_attainable_mc_p':1/(N_PERM+1),\n   212\t 'fwe_alpha':0.05, 'n_positive_voxels_fwe05':int(sig.sum()),\n   213\t 'n_vmPFC_roi_voxels_fwe05':roi_sig_voxels,\n   214\t 'positive_fwe_components_26_neighbor':cluster_summaries,\n   215\t 'max_positive_t':float(t_obs[imax]),'max_positive_t_mni_mm':[float(x) for x in max_xyz],\n   216\t 'max_positive_t_p_uncorrected_one_sided':float(p_unc[imax]),\n   217\t 'max_positive_t_p_fwe':float(p_fwe[imax]),\n   218\t 'roi':{'definition':'10 mm radius sphere centered at MNI152 (0, 40, -10); independent descriptive vmPFC summary',\n   219\t        'n_voxels':int(roi.sum()),'mean_effect':roi_mean,'sd_between_participants':roi_sd,\n   220\t        'se':float(roi_se),'ci95_t':[float(x) for x in roi_ci], 't':float(roi_t),\n   221\t        'p_one_sided_uncorrected':roi_p1,'p_two_sided_uncorrected':float(roi_p2),\n   222\t        'n_positive_participant_roi_means':int(np.sum(roi_values>0)),\n   223\t        'median':float(np.median(roi_values)),'range':[float(roi_values.min()),float(roi_values.max())]},\n   224\t 'quality':{'all_54_maps_present':True,'same_shape_affine':True,'all_values_finite':True,\n   225\t            'empty_maps':0,'roi_abs_robust_z_gt_3':int(np.sum(np.abs(roi_robust_z)>3)),\n   226\t            'no_effect_based_exclusions':True}\n   227\t}\n   228\t(OUT/'summary.json').write_text(json.dumps(results,indent=2)+'\\n')\n   229\tprint(json.dumps(results,indent=2))\n\n--- upstream methods ---\n     1\t# Fixed upstream analysis\n     2\t\n     3\tEach map is one participant's unthresholded gain-effect estimate from NARPS team AO86, averaged across four runs.\n     4\tThe 54 participants comprise the complete equal-indifference group in OpenNeuro ds001734 version 1.0.4.\n     5\tThese are effect estimates, not standardized test statistics or group results.\n     6\tMaps are reported in MNI152NLin2009cAsym space.\n     7\t\n     8\tAO86 used fMRIPrep outputs and nistats participant models.\n     9\tTheir reported gain regressor was mean-centered and variance-normalized before HRF convolution; its coefficients must not be interpreted as change per currency unit.\n    10\tResponse trials used response-time durations, with separate response-choice and gain modulators.\n    11\tNonresponse trials, motion terms, flagged volumes and drift terms were also modeled; runs were combined within participant.\n    12\tGain and loss used separate models, so the supplied gain effect is conditional on that modeling choice.\n    13\t\n    14\tThe reported upstream choices are fixed for this task.\n    15\tParticipant variance maps and a complete executable upstream pipeline are not supplied; account for these limits when choosing and interpreting group inference.\n    16\t`participants.tsv` retains the source group, age and gender columns.\n    17\t`sources.json` identifies each original image, its retrieved-byte checksum, the pinned cohort table and the original methods report.\n\n--- task ---\n     1\t# Potential gains and brain activity\n     2\t\n     3\tDoes increasing potential monetary gain produce a greater fMRI response in the ventromedial prefrontal cortex (vmPFC) in the NARPS equal-indifference group?\n     4\t\n     5\tTest the hypothesis that this response increases with potential gain.\n     6\tParticipants performed a mixed-gambles task, deciding whether to accept gambles with possible gains and losses.\n     7\tIn this group, the range of potential gains was twice the range of potential losses.\n     8\t\n     9\tInvestigate the question at the group-analysis stage using the supplied 54 participant gain-effect maps and metadata.\n    10\tPreprocessing and individual modeling are fixed inputs, described in `upstream-methods.md`; do not repeat them or download time-series scans.\n    11\tChoose scientifically defensible group models, quality checks, software and visualizations.\n    12\tAccount for what the supplied effect estimates measure and the limits of their upstream model.\n    13\tUse whole-brain correction for multiple comparisons when evaluating support for the hypothesis, as required by the original study; justify how you identify vmPFC.\n    14\t\n    15\tProduce a concise scientific report with informative figures and the code and results supporting your conclusions.\n    16\tExplain uncertainty, exclusions and limitations, including what a lack of support would mean.\n    17\tPrior teams' answers are not ground truth or a required result.\n    18\t\n    19\tSource: [NARPS original analysis instructions, Hypothesis 1](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf).\n\n--- summary ---\n{\n  \"analysis\": \"one-sample positive-direction t test; participant-wise sign-flip max-T FWE\",\n  \"n_participants\": 54,\n  \"n_excluded\": 0,\n  \"n_common_nonzero_voxels\": 198029,\n  \"n_permutations\": 5000,\n  \"random_seed\": 20261016,\n  \"minimum_attainable_mc_p\": 0.0001999600079984003,\n  \"fwe_alpha\": 0.05,\n  \"n_positive_voxels_fwe05\": 24,\n  \"n_vmPFC_roi_voxels_fwe05\": 0,\n  \"positive_fwe_components_26_neighbor\": [\n    {\n      \"n_voxels\": 17,\n      \"peak_t\": 6.617173194885254,\n      \"peak_mni_mm\": [\n        -26.0,\n        -102.0,\n        -3.599997043609619\n      ],\n      \"mean_effect\": 0.1096723000792896\n    },\n    {\n      \"n_voxels\": 2,\n      \"peak_t\": 5.760898590087891,\n      \"peak_mni_mm\": [\n        26.0,\n        -98.0,\n        -1.1999969482421875\n      ],\n      \"mean_effect\": 0.11084404587745667\n    },\n    {\n      \"n_voxels\": 5,\n      \"peak_t\": 6.1934027671813965,\n      \"peak_mni_mm\": [\n        30.0,\n        -94.0,\n        -8.399997234344482\n      ],\n      \"mean_effect\": 0.10139038413763046\n    }\n  ],\n  \"max_positive_t\": 6.617173246302242,\n  \"max_positive_t_mni_mm\": [\n    -26.0,\n    -102.0,\n    -3.599997043609619\n  ],\n  \"max_positive_t_p_uncorrected_one_sided\": 9.311564027968446e-09,\n  \"max_positive_t_p_fwe\": 0.0009998000399920016,\n  \"roi\": {\n    \"definition\": \"10 mm radius sphere centered at MNI152 (0, 40, -10); independent descriptive vmPFC summary\",\n    \"n_voxels\": 428,\n    \"mean_effect\": -0.006060335343203473,\n    \"sd_between_participants\": 0.10310948320797442,\n    \"se\": 0.014031423416755982,\n    \"ci95_t\": [\n      -0.03420380666997115,\n      0.022083135983564203\n    ],\n    \"t\": -0.43191165737086723,\n    \"p_one_sided_uncorrected\": 0.6662211417399067,\n    \"p_two_sided_uncorrected\": 0.6675577165201866,\n    \"n_positive_participant_roi_means\": 25,\n    \"median\": -0.008224427467212081,\n    \"range\": [\n      -0.2759972810745239,\n      0.19310368597507477\n    ]\n  },\n  \"quality\": {\n    \"all_54_maps_present\": true,\n    \"same_shape_affine\": true,\n    \"all_values_finite\": true,\n    \"empty_maps\": 0,\n    \"roi_abs_robust_z_gt_3\": 0,\n    \"no_effect_based_exclusions\": true\n  }\n}\n\n--- run log ---\n{\n  \"analysis\": \"one-sample positive-direction t test; participant-wise sign-flip max-T FWE\",\n  \"n_participants\": 54,\n  \"n_excluded\": 0,\n  \"n_common_nonzero_voxels\": 198029,\n  \"n_permutations\": 5000,\n  \"random_seed\": 20261016,\n  \"minimum_attainable_mc_p\": 0.0001999600079984003,\n  \"fwe_alpha\": 0.05,\n  \"n_positive_voxels_fwe05\": 24,\n  \"n_vmPFC_roi_voxels_fwe05\": 0,\n  \"positive_fwe_components_26_neighbor\": [\n    {\n      \"n_voxels\": 17,\n      \"peak_t\": 6.617173194885254,\n      \"peak_mni_mm\": [\n        -26.0,\n        -102.0,\n        -3.599997043609619\n      ],\n      \"mean_effect\": 0.1096723000792896\n    },\n    {\n      \"n_voxels\": 2,\n      \"peak_t\": 5.760898590087891,\n      \"peak_mni_mm\": [\n        26.0,\n        -98.0,\n        -1.1999969482421875\n      ],\n      \"mean_effect\": 0.11084404587745667\n    },\n    {\n      \"n_voxels\": 5,\n      \"peak_t\": 6.1934027671813965,\n      \"peak_mni_mm\": [\n        30.0,\n        -94.0,\n        -8.399997234344482\n      ],\n      \"mean_effect\": 0.10139038413763046\n    }\n  ],\n  \"max_positive_t\": 6.617173246302242,\n  \"max_positive_t_mni_mm\": [\n    -26.0,\n    -102.0,\n    -3.599997043609619\n  ],\n  \"max_positive_t_p_uncorrected_one_sided\": 9.311564027968446e-09,\n  \"max_positive_t_p_fwe\": 0.0009998000399920016,\n  \"roi\": {\n    \"definition\": \"10 mm radius sphere centered at MNI152 (0, 40, -10); in