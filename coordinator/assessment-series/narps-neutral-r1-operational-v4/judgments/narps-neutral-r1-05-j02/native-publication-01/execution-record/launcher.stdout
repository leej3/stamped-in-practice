{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat > \"$STAMPED_JUDGE_OUTPUT/commands/verify-operational-capture.py\" <<'\"'PY'\nimport hashlib, json, os, stat\nmanifest=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nroot=os.environ['STAMPED_JUDGE_TARGET']\nprefix='content/workspace/'\nexpected={e['path'][len(prefix):]:e for e in manifest['entries'] if e['path'].startswith(prefix)}\nactual={}\nfor base,dirs,files in os.walk(root,topdown=True,followlinks=False):\n    for name in list(dirs)+files:\n        p=os.path.join(base,name); rel=os.path.relpath(p,root)\n        try: st=os.lstat(p)\n        except OSError: continue\n        if stat.S_ISLNK(st.st_mode): kind='symlink'; payload=os.readlink(p)\n        elif stat.S_ISDIR(st.st_mode): kind='directory'; payload=None\n        elif stat.S_ISREG(st.st_mode): kind='file'; payload=hashlib.sha256(open(p,'rb').read()).hexdigest()\n        else: kind='other'; payload=None\n        actual[rel]=(kind,stat.S_IMODE(st.st_mode),payload)\n        if kind=='symlink' and name in dirs: dirs.remove(name)\nmismatches=[]; operational_metadata=[]\nfor rel,e in expected.items():\n    got=actual.get(rel)\n    same=got is not None and got[0]==e['kind'] and got[1]==e.get('mode')\n    if same and e['kind']=='file': same=got[2]==e.get('sha256')\n    if same and e['kind']=='symlink': same=got[2]==e.get('target')\n    if not same:\n        row={'path':rel,'expected_kind':e['kind'],'actual':got}\n        if rel in {'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'} and got and got[0]=='file': operational_metadata.append(row)\n        else: mismatches.append(row)\nfor rel,got in actual.items():\n    if rel not in expected:\n        row={'path':rel,'actual':got}\n        if rel in {'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'} and got[0]=='file': operational_metadata.append(row)\n        else: mismatches.append(row)\nreport={'canonical_capture_sha256':json.load(open(os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'judge-target.json')))['capture']['sha256'],'baseline_operational_manifest_sha256':json.load(open(os.environ['STAMPED_JUDGE_OUTPUT']+'/judge-target.json'))['operational_capture']['sha256'],'entry_count':len(expected),'mismatches':mismatches,'operational_metadata_changes':operational_metadata,'integrity':'match except classified operational metadata' if not mismatches else 'mismatch'}\nout=os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'integrity','operational-integrity.json'); os.makedirs(os.path.dirname(out),exist_ok=True); json.dump(report,open(out,'w'),indent=2)\nprint(json.dumps({'integrity':report['integrity'],'entry_count':len(expected),'mismatches':len(mismatches),'operational_metadata_changes':len(operational_metadata),'report':out}))\nPY\npython3 \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/verify-operational-capture.py\" > \"$STAMPED_JUDGE_OUTPUT/commands/integrity.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/integrity.stderr\"; code=$?; printf '\"'exit=%s\\\\n' \\\"\"'$code\" > \"$STAMPED_JUDGE_OUTPUT/commands/integrity.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/integrity.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/integrity.stderr\"; cat \"$STAMPED_JUDGE_OUTPUT/integrity/operational-integrity.json\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
