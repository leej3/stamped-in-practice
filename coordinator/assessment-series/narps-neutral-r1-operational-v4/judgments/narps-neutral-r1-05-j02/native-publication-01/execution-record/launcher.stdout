{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$STAMPED_JUDGE_OUTPUT/commands/replay-01.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/replay-01.stderr\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/replay-01.exit\"; find \"$STAMPED_JUDGE_OUTPUT/replay\" -maxdepth 3 -type f -print\npython3 - <<'\"'PY'\nimport concurrent.futures, json, os, urllib.request, urllib.error, time\nroot=os.environ['STAMPED_JUDGE_TARGET']; out=os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'access')\nos.makedirs(out,exist_ok=True)\nd=json.load(open(os.path.join(root,'input/sources.json')))\nitems=[(rel,info) for rel,info in d['files'].items() if rel.endswith('.nii.gz')]\ndef check(item):\n rel,info=item; req=urllib.request.Request(info['url'],method='HEAD',headers={'User-Agent':'NARPS-group-study/1.0'})\n try:\n  with urllib.request.urlopen(req,timeout=25) as r:\n   return {'path':rel,'url':info['url'],'status':r.status,'content_length':r.headers.get('Content-Length'),'expected_bytes':info['bytes'],'host':urllib.request.urlparse(info['url']).hostname,'ok':r.status==200 and r.headers.get('Content-Length')==str(info['bytes'])}\n except Exception as e:\n  return {'path':rel,'url':info['url'],'host':urllib.request.urlparse(info['url']).hostname,'error':type(e).__name__+': '+str(e),'ok':False}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool: rows=list(pool.map(check,items))\njson.dump({'route_source':'input/sources.json; retrieval code: scripts/retrieve_maps.py','method':'HEAD only; no scientific bytes downloaded','intended_recipient':'researcher using the declared NeuroVault URLs and retained manifest','required_artifact_coverage':'54 participant gain-effect maps; does not cover worker report/code/environment or full research object publication','tested_host_scope':sorted(set(r.get('host') for r in rows)),'tested_routes':len(rows),'ok':sum(r['ok'] for r in rows),'failures':[r for r in rows if not r['ok']],'results':rows},open(os.path.join(out,'access-record.json'),'w'),indent=2)\nprint('tested',len(rows),'ok',sum(r['ok'] for r in rows),'failures',len(rows)-sum(r['ok'] for r in rows))\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$STAMPED_JUDGE_OUTPUT/commands/replay-01.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/replay-01.stderr\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/replay-01.exit\"; find \"$STAMPED_JUDGE_OUTPUT/replay\" -maxdepth 3 -type f -print\npython3 - <<'\"'PY'\nimport concurrent.futures, json, os, urllib.request, urllib.error, time\nroot=os.environ['STAMPED_JUDGE_TARGET']; out=os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'access')\nos.makedirs(out,exist_ok=True)\nd=json.load(open(os.path.join(root,'input/sources.json')))\nitems=[(rel,info) for rel,info in d['files'].items() if rel.endswith('.nii.gz')]\ndef check(item):\n rel,info=item; req=urllib.request.Request(info['url'],method='HEAD',headers={'User-Agent':'NARPS-group-study/1.0'})\n try:\n  with urllib.request.urlopen(req,timeout=25) as r:\n   return {'path':rel,'url':info['url'],'status':r.status,'content_length':r.headers.get('Content-Length'),'expected_bytes':info['bytes'],'host':urllib.request.urlparse(info['url']).hostname,'ok':r.status==200 and r.headers.get('Content-Length')==str(info['bytes'])}\n except Exception as e:\n  return {'path':rel,'url':info['url'],'host':urllib.request.urlparse(info['url']).hostname,'error':type(e).__name__+': '+str(e),'ok':False}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool: rows=list(pool.map(check,items))\njson.dump({'route_source':'input/sources.json; retrieval code: scripts/retrieve_maps.py','method':'HEAD only; no scientific bytes downloaded','intended_recipient':'researcher using the declared NeuroVault URLs and retained manifest','required_artifact_coverage':'54 participant gain-effect maps; does not cover worker report/code/environment or full research object publication','tested_host_scope':sorted(set(r.get('host') for r in rows)),'tested_routes':len(rows),'ok':sum(r['ok'] for r in rows),'failures':[r for r in rows if not r['ok']],'results':rows},open(os.path.join(out,'access-record.json'),'w'),indent=2)\nprint('tested',len(rows),'ok',sum(r['ok'] for r in rows),'failures',len(rows)-sum(r['ok'] for r in rows))\nPY\n\"","aggregated_output":"✔ The default environment has been installed.\nFormal replay allowance already consumed; retain this attempt\nexit=1\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-05-j02/attempt-01/judgment/replay/replay-plan.md\ntested 54 ok 54 failures 0\n","exit_code":0,"status":"completed"}}
