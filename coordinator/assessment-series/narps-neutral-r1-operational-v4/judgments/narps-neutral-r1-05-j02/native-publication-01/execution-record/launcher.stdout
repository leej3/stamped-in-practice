{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat > \"$STAMPED_JUDGE_OUTPUT/commands/finalize-records.py\" <<'\"'PY'\nimport hashlib,json,os\nout=os.environ['STAMPED_JUDGE_OUTPUT']; manifest=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nresponse=os.path.join(out,'response.json'); d=json.load(open(response))\nd['object']['commit']=manifest.get('head_commit')\nd['object']['captured_at']=manifest.get('captured_at')\nwith open(response,'w') as f: json.dump(d,f,indent=2); f.write('\\\\n')\nreport='assessment-report.md'\ndigest=hashlib.sha256(open(os.path.join(out,report),'rb').read()).hexdigest()\nrecord={\n 'schema_version':1,\n 'delivery_capture_sha256':json.load(open(os.path.join(out,'judge-target.json')))['capture']['sha256'],\n 'scientific_adequacy':'supported',\n 'report':{'path':report,'sha256':digest},\n 'adequacy_evidence':{'quote':'Scientific adequacy: supported.','start_line':10,'end_line':10},\n 'hypothesis_conclusion':{'quote':'The supplied maps do not support a positive vmPFC gain effect in the NARPS equal-indifference group.','start_line':24,'end_line':24}\n}\nwith open(os.path.join(out,'scientific-judgment.json'),'w') as f: json.dump(record,f,indent=2); f.write('\\\\n')\nprint(json.dumps({'capture':record['delivery_capture_sha256'],'commit':d['object']['commit'],'report_sha256':digest}))\nPY\npython3 \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/finalize-records.py\" > \"$STAMPED_JUDGE_OUTPUT/commands/finalize-records.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/finalize-records.stderr\"; code=$?; printf '\"'exit=%s\\\\n' \\\"\"'$code\" > \"$STAMPED_JUDGE_OUTPUT/commands/finalize-records.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/finalize-records.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/finalize-records.stderr\"\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" validate \"$STAMPED_JUDGE_OUTPUT/response.json\" > \"$STAMPED_JUDGE_OUTPUT/commands/validate-response.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/validate-response.stderr\"; code=$?; printf '\"'exit=%s\\\\n' \\\"\"'$code\" > \"$STAMPED_JUDGE_OUTPUT/commands/validate-response.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/validate-response.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/validate-response.stderr\"\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\" validate scientific-judgment.json --workspace \"$STAMPED_JUDGE_OUTPUT\" --delivery-manifest \"$STAMPED_DELIVERY_MANIFEST\" > \"$STAMPED_JUDGE_OUTPUT/commands/validate-scientific.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/validate-scientific.stderr\"; code=$?; printf '\"'exit=%s\\\\n' \\\"\"'$code\" > \"$STAMPED_JUDGE_OUTPUT/commands/validate-scientific.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/validate-scientific.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/validate-scientific.stderr\"\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response encode \"$STAMPED_JUDGE_OUTPUT/response.json\" > \"$STAMPED_JUDGE_OUTPUT/checklist-link.txt\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/encode-response.stderr\"; code=$?; printf '\"'exit=%s\\\\n' \\\"\"'$code\" > \"$STAMPED_JUDGE_OUTPUT/commands/encode-response.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/checklist-link.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/encode-response.stderr\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
