{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY'\nimport json,os\nroot=os.path.dirname(os.path.dirname(os.environ['STAMPED_JUDGE_TARGET']))\nfor base,dirs,files in os.walk(os.path.dirname(os.environ['STAMPED_JUDGE_TARGET'])):\n if 'judge-target.json' in files:\n  p=os.path.join(base,'judge-target.json'); d=json.load(open(p)); print(p); print(json.dumps(d,indent=2)[:6000])\nfor name in ['STAMPED_DELIVERY_MANIFEST','STAMPED_OPERATIONAL_MANIFEST']:\n p=os.environ[name]; d=json.load(open(p)); print('\\\\n',name, 'workspace',d.get('workspace'),'head_commit',d.get('head_commit'),'kind',d.get('kind'),'status',d.get('capture_status'),'errors',d.get('errors'),'omissions',d.get('omissions'))\n print('git_metadata',json.dumps(d.get('git_metadata'),indent=2)[:3000]); print('git_dependencies',json.dumps(d.get('git_dependencies'),indent=2)[:3000])\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" probes --help\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response --help\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" fresh-rerun --help\nprintf '\"'\\\\n--- target root refs and reports ---\\\\n'\ncd \\\"\"'$STAMPED_JUDGE_TARGET\" && git status --short --untracked-files=all && git rev-parse HEAD && git log -1 --format='\"'%H%n%an%n%ad%n%s' --date=iso-strict && git remote -v && git config --local --list --show-origin | head -80\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
