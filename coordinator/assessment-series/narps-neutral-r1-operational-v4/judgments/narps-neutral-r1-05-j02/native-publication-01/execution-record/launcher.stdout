z\\\",\n    \\\"results/group_p_fwe_max_t.nii.gz\\\",\n    \\\"results/fwe_clusters.csv\\\",\n    \\\"results/participant_qc.csv\\\",\n    \\\"results/summary.json\\\"\n  ],\n  \\\"rtol\\\": 1e-6,\n  \\\"reason\\\": \\\"First helper invocation failed before copying the delivery because the specified destination already existed. A corrected invocation was refused because the frozen helper's one-attempt allowance had been consumed. The worker entrypoint never ran; no target outputs were removed or regenerated.\\\",\n  \\\"attempt_artifacts\\\": [\n    \\\"commands/replay.stdout\\\",\n    \\\"commands/replay.stderr\\\",\n    \\\"commands/replay.exit\\\",\n    \\\"commands/replay-01.stdout\\\",\n    \\\"commands/replay-01.stderr\\\",\n    \\\"commands/replay-01.exit\\\",\n    \\\"commands/replay-command.txt\\\",\n    \\\"replay/replay-plan.md\\\"\n  ],\n  \\\"scientific_outputs_compared\\\": []\n}\nEOF\ncat > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/check-access-routes.py\" <<'\"'PY'\nimport concurrent.futures, json, os, urllib.request\nroot=os.environ['STAMPED_JUDGE_TARGET']; out=os.environ['STAMPED_JUDGE_OUTPUT']\nmanifest=json.load(open(os.path.join(root,'input/sources.json')))\nitems=[(p,d) for p,d in manifest['files'].items() if p.endswith('.nii.gz')]\ndef check(item):\n    rel,info=item\n    req=urllib.request.Request(info['url'],method='HEAD',headers={'User-Agent':'NARPS-group-study/1.0'})\n    try:\n        with urllib.request.urlopen(req,timeout=25) as r:\n            return {'path':rel,'url':info['url'],'host':urllib.request.urlparse(info['url']).hostname,'status':r.status,'content_length':r.headers.get('Content-Length'),'expected_bytes':info['bytes'],'ok':r.status==200 and r.headers.get('Content-Length')==str(info['bytes'])}\n    except Exception as e:\n        return {'path':rel,'url':info['url'],'host':urllib.request.urlparse(info['url']).hostname,'error':type(e).__name__+': '+str(e),'ok':False}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool: rows=list(pool.map(check,items))\nrecord={'route_source':'content/workspace/input/sources.json; retrieval code: content/workspace/scripts/retrieve_maps.py','method':'HEAD only; no scientific bytes downloaded','intended_recipient':'researcher using the declared authorized NeuroVault route','required_artifact_coverage':'54 participant gain-effect maps only; not the full analysis project or environment','tested_host_scope':sorted(set(r.get('host') for r in rows)),'tested_routes':len(rows),'ok':sum(r['ok'] for r in rows),'failures':[r for r in rows if not r['ok']],'results':rows}\nos.makedirs(os.path.join(out,'access'),exist_ok=True)\njson.dump(record,open(os.path.join(out,'access/access-record.json'),'w'),indent=2)\nprint('tested',len(rows),'ok',sum(r['ok'] for r in rows),'failed',len(rows)-sum(r['ok'] for r in rows),'hosts',record['tested_host_scope'])\nPY\npython3 \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/check-access-routes.py\" > \"$STAMPED_JUDGE_OUTPUT/commands/access-check.stdout\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/access-check.stderr\"; code=$?; printf '\"'exit=%s\\\\n' \\\"\"'$code\" > \"$STAMPED_JUDGE_OUTPUT/commands/access-check.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/access-check.stdout\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/access-check.stderr\"\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
