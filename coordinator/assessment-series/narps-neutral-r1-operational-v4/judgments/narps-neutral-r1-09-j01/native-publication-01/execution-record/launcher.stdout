     \"transformation\": \"none\"\n    },\n    \"data/sub-035_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-035_hypo1_cope.nii.gz\",\n      \"image_id\": 118792,\n      \"participant_id\": \"sub-035\",\n      \"bytes\": 1768719,\n      \"sha256\": \"211fd859f33d69891531ad3e5dd66fe0c0891b20c58e6ef8aa21b4d49ff030c9\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-037_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-037_hypo1_cope.nii.gz\",\n      \"image_id\": 118802,\n      \"participant_id\": \"sub-037\",\n      \"bytes\": 1807410,\n      \"sha256\": \"a4d76561e8ba1848572a474afce754310f4ee101cfd99276eb3105289cc0934b\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-039_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-039_hypo1_cope.nii.gz\",\n      \"image_id\": 118812,\n      \"participant_id\": \"sub-039\",\n      \"bytes\": 1775163,\n      \"sha256\": \"744df860cfb8410aae16bcb1742e7390c51306c66959bb19da9f5b57206bba7b\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-041_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-041_hypo1_cope.nii.gz\",\n      \"image_id\": 118822,\n      \"participant_id\": \"sub-041\",\n      \"bytes\": 1801691,\n      \"sha256\": \"f93eeadcd3f57239e4c32c5df2ca2c4013bf424978701bd5beec535ace24669f\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-043_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-043_hypo1_cope.nii.gz\",\n      \"image_id\": 118827,\n      \"participant_id\": \"sub-043\",\n      \"bytes\": 1776243,\n      \"sha256\": \"520f19805c6c4358bc56e9bba290b9b79a80c14385bc7be90e4bd81b3e37e771\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-045_hypo1_cope.nii.gz\": {\n?? .codex/skills/jupyter-notebook/LICENSE.txt\n?? .codex/skills/jupyter-notebook/SKILL.md\n?? .codex/skills/jupyte