rl\": \"https://neurovault.org/media/images/4932/sub-105_hypo1_cope.nii.gz\",\n      \"image_id\": 119224,\n      \"participant_id\": \"sub-105\",\n      \"bytes\": 1795447,\n      \"sha256\": \"12a1b50eaa5be6983990c5e77f985f9750340204eaa3fff7e70829f07707e6a2\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-107_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-107_hypo1_cope.nii.gz\",\n      \"image_id\": 119234,\n      \"participant_id\": \"sub-107\",\n      \"bytes\": 1804121,\n      \"sha256\": \"4580aade93323d0d14f9a3a1932a428004a2f657980b5669f9274102bb370802\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-109_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-109_hypo1_cope.nii.gz\",\n      \"image_id\": 119244,\n      \"participant_id\": \"sub-109\",\n      \"bytes\": 1788268,\n      \"sha256\": \"931ba1128720bbaa99e7fce8f036a331581d6d07e00212a1f402eae7959299cb\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-113_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-113_hypo1_cope.nii.gz\",\n      \"image_id\": 119259,\n      \"participant_id\": \"sub-113\",\n      \"bytes\": 1819506,\n      \"sha256\": \"e5f81435ddc2d5703fa4ea37d6597601e71b50f8c53fb6047fb0067c17282c65\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-115_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-115_hypo1_cope.nii.gz\",\n      \"image_id\": 119269,\n      \"participant_id\": \"sub-115\",\n      \"bytes\": 1797041,\n      \"sha256\": \"5046f7c2fa1c5d1be6237d38f631beca13df8a3a8ded11121082838a533a44bf\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-117_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-117_hypo1_cope.nii.gz\",\n      \"image_id\": 119279,\n      \"participant_id\": \"sub-117\",\n      \"bytes\": 1741472,\n      \"sha256\": \"711159acfa23c45ab82903f658cafe0fa539f39e077e451f6b0728fdb359445f\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-119_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-119_hypo1_cope.nii.gz\",\n      \"image_id\": 119289,\n      \"participant_id\": \"sub-119\",\n      \"bytes\": 1752220,\n      \"sha256\": \"01738a10e34e46c5ea1a4a192b9484595ee352d62375095b76726347455aabd7\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-121_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-121_hypo1_cope.nii.gz\",\n      \"image_id\": 119299,\n      \"participant_id\": \"sub-121\",\n      \"bytes\": 1766758,\n      \"sha256\": \"94357665b89cfa1b9157e71aab10f78b49585a790a4a01d9e4693698e185d892\",\n      \"transformation\": \"none\"\n    },\n    \"data/sub-123_hypo1_cope.nii.gz\": {\n      \"url\": \"https://neurovault.org/media/images/4932/sub-123_hypo1_cope.nii.gz\",\n      \"image_id\": 119304,\n      \"participant_id\": \"sub-123\",\n      \"bytes\": 1745649,\n      \"sha256\": \"1219377e08c306753c1e382d431b1e7a55c7143cdc5f800fb65e92fa7e72f888\",\n      \"transformation\": \"none\"\n    },\n    \"participants.tsv\": {\n      \"bytes\": 1706,\n      \"sha256\": \"faca815bcb042144bdb8dcff915f45de0d27650f60416ed76a5a72557341abbf\"\n    },\n    \"study-task.md\": {\n      \"bytes\": 1483,\n      \"sha256\": \"e92bf2e0c0db4cc49688cce9f9dfff8a236fc4ec151c09961719f49f31310cc8\"\n    },\n    \"upstream-methods.md\": {\n      \"bytes\": 1342,\n      \"sha256\": \"508d832c8787ed8303c3de101c2c76f40a3aa5dec53e6993dc2a49c4b7bcf90b\"\n    }\n  }\n}\n✔ The default environment has been installed.\nusage: run_probes.py [-h] [-o OUTPUT] [--response RESPONSE]\n                     [--only {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--skip {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--check-remote] [--allow GLOB [GLOB ...]]\n                     [--kind {dataset,component,study,skill}] [--overwrite]\n                     [--quiet]\n                     path\n\nRun the STAMPED probes over a checked-out research object.\n\n    run_probes.py <path> [-o probes.json] [--response response.json]\n                  [--only NAME ...] [--skip NAME ...] [--check-remote]\n                  [--kind dataset|component|study|skill]\n\nWrites the per-probe results, and optionally a response JSON (the format in\n``../stamped-conventions/references/response-format.md``) in which every item a\nprobe speaks to carries that probe's verdict and every other item is left\n``not-checked`` for the assessing session to judge.\nWithout a Git commit, ``-o`` retains a limitation receipt and exit code 2;\nno response draft is produced.\n\nThe probes never modify the object.  Nothing here replaces the judgement items:\na response straight out of this script is a draft, not an assessment.\n\npositional arguments:\n  path                  checked-out object to probe\n\noptions:\n  -h, --help            show this help message and exit\n  -o, --output OUTPUT   write the probe results here\n  --response RESPONSE   also write a draft response JSON here\n  --only {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]\n                        run just these probes\n  --skip {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]\n  --check-remote        contact submodule urls (network)\n  --allow GLOB [GLOB ...]\n                        paths no-abs-paths may skip, for files that genuinely\n                        have to carry a host path\n  --kind {dataset,component,study,skill}\n  --overwrite           replace an existing --response file instead of keeping\n                        its judged answers\n  --quiet\n✔ The default environment has been installed.\nusage: assessment.py [-h] --path PATH --entry ENTRY\n                     --outputs OUTPUTS [OUTPUTS ...] --workdir WORKDIR\n                     -o OUTPUT [--rtol RTOL] [--timeout TIMEOUT]\n                     [--max-get-gb MAX_GET_GB] [--in-container IN_CONTAINER]\n\nReplay documented outputs from a verified complete copy, never from HEAD.\n\noptions:\n  -h, --help            show this help message and exit\n  --path PATH\n  --entry ENTRY\n  --outputs OUTPUTS [OUTPUTS ...]\n  --workdir WORKDIR\n  -o, --output OUTPUT\n  --rtol RTOL\n  --timeout TIMEOUT\n  --max-get-gb MAX_GET_GB\n  --in-container IN_CONTAINER\n","exit_code":0,"status":"completed"}}
