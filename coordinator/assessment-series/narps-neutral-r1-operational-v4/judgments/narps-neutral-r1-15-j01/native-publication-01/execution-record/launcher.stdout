ytes\": 1737182,\n        \"git_blob\": \"bd31939be6f91f9b7e4a2dfd9451288dab750fb1\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-009_hypo1_cope.nii.gz\",\n        \"sha256\": \"33af129d8ba13cd4b6175089706c531471be1e0bd7ccd43ece10751c8cc3254c\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1828116--a08c26694622d29085d0ff477e29a87b.nii.gz\",\n        \"bytes\": 1828116,\n        \"git_blob\": \"923ba12454af9382d8df4efcd77a6c048b797edb\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-011_hypo1_cope.nii.gz\",\n        \"sha256\": \"6f74dd449eefa6eff40ec00eb046ec7e8bb13c0b7c2ac1874155a9c166692352\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1760573--53bb0262f6b247c292c82ae02c9ac689.nii.gz\",\n        \"bytes\": 1760573,\n        \"git_blob\": \"5f90449dd485d490155712888fe08924680a7e37\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-013_hypo1_cope.nii.gz\",\n        \"sha256\": \"bfa79b82f931d81d6387e82b8413f1f889a06f36275ba510554669c84a3c026f\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1805181--e17002345578911b778f67d3b8239fe7.nii.gz\",\n        \"bytes\": 1805181,\n        \"git_blob\": \"954e8d8f830a3e23a93baed7093bc88ce91dd054\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-015_hypo1_cope.nii.gz\",\n        \"sha256\": \"5d98f6d74823516768659967f95ef43728584eab024c58af30987783515d7694\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1791857--94f1e4aa88173d0b274894166e19de7e.nii.gz\",\n        \"bytes\": 1791857,\n        \"git_blob\": \"9e45bb85100959d7f7b6384b927c33cbca8616d4\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-017_hypo1_cope.nii.gz\",\n        \"sha256\": \"dca9eac4d6f0ef4e2a3e631b2d10f89c5362863698cec4a7c7b9b14128ae96d9\",\n        \"source_mode\": \"120000\"\n      },\