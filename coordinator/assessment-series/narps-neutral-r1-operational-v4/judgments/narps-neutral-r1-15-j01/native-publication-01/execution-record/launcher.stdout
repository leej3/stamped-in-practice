{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"cat > commands/capture-inspection.py <<'PY'\nimport json,os,subprocess\nfrom pathlib import Path\nout=Path(os.environ['STAMPED_JUDGE_OUTPUT'])/'commands'; target=Path(os.environ['STAMPED_JUDGE_TARGET'])\ncommands={\n 'target-git-status':['git','-C',str(target),'status','--short','--branch'],\n 'target-git-head':['git','-C',str(target),'log','-1','--format=%H%n%an%n%ad%n%s'],\n 'target-git-remotes':['git','-C',str(target),'remote','-v'],\n 'target-inventory':['find',str(target),'-maxdepth','3','-type','f','-not','-path','*/.git/*','-print'],\n 'target-report':['cat',str(target/'report.md')],\n 'analysis-script':['cat',str(target/'analysis/group_analysis.py')],\n 'upstream-methods':['cat',str(target/'input/upstream-methods.md')],\n 'summary':['cat',str(target/'results/summary.json')],\n 'input-qc':['cat',str(target/'results/input_qc.csv')],\n 'fwe-clusters':['cat',str(target/'results/fwe_clusters.csv')],\n 'vmPFC-participant-effects':['cat',str(target/'results/vmPFC_participant_effects.csv')],\n 'vmPFC-mask-definition':['cat',str(target/'results/vmPFC_mask_definition.txt')],\n 'participants':['cat',str(target/'input/participants.tsv')],\n}\nfor name,argv in commands.items():\n p=subprocess.run(argv,cwd=os.environ['STAMPED_JUDGE_OUTPUT'],env=os.environ.copy(),text=True,capture_output=True)\n (out/f'inspect-{name}.stdout').write_text(p.stdout)\n (out/f'inspect-{name}.stderr').write_text(p.stderr)\n (out/f'inspect-{name}.exit').write_text(str(p.returncode)+'\\\\n')\n if p.returncode: raise SystemExit(f'{name}: {p.returncode}')\n# Record only approved receipt/manifest fields, avoiding retained cross-object lists.\nfor name,path,keys in [\n ('canonical-manifest',os.environ['STAMPED_DELIVERY_MANIFEST'],['captured_at','capture_status','head_commit','errors','omissions','git_dependencies','git_metadata','workspace']),\n ('operational-manifest',os.environ['STAMPED_OPERATIONAL_MANIFEST'],['captured_at','capture_status','head_commit','errors','omissions','git_dependencies','git_metadata','workspace']),\n ('worker-stop-receipt',os.environ['STAMPED_WORKER_STOP_RECEIPT'],['capture','captured_at','capture_finished_at','capture_status','errors','head_commit','kind','omissions','worker']),\n ('judge-target',str(Path(os.environ['STAMPED_JUDGE_OUTPUT'])/'judge-target.json'),['reference_limits'])]:\n x=json.load(open(path)); (out/f'inspect-{name}.json').write_text(json.dumps({k:x.get(k) for k in keys},indent=2)+'\\\\n')\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" commands/capture-inspection.py > commands/capture-inspection.stdout 2> commands/capture-inspection.stderr; echo $? > commands/capture-inspection.exit; cat commands/capture-inspection.stdout; cat commands/capture-inspection.stderr'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
