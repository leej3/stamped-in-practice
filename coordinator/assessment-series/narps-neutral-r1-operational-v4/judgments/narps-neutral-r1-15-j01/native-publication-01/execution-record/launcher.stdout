    \"stamped-checklist:must/012\": \"No platform-specific package manager, BSD/GNU-only flag or scheduler command in tracked text \\u2014 all a command scan can settle. Whether the documented route needs a mount, a host install, hardware or a service is a reading.\"\n      }\n    },\n    {\n      \"probe\": \"run-env-linked\",\n      \"status\": \"not-checked\",\n      \"items\": [\n        \"stamped-checklist:must/006\",\n        \"stamped-checklist:must/015\"\n      ],\n      \"reason\": \"must/006 not-checked: No run records, so no record names the environment it ran in. must/015 not-checked: Nothing names an environment to check for a pin.\",\n      \"evidence\": [],\n      \"details\": {\n        \"records\": 0,\n        \"with_env\": 0,\n        \"without_env\": [],\n        \"by_mechanism\": {\n          \"container\": 0,\n          \"lockfile\": 0,\n          \"capture\": 0\n        },\n        \"unpinned\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/006\": \"not-checked\",\n        \"stamped-checklist:must/015\": \"not-checked\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/006\": \"No run records, so no record names the environment it ran in.\",\n        \"stamped-checklist:must/015\": \"Nothing names an environment to check for a pin.\"\n      }\n    },\n    {\n      \"probe\": \"subdatasets-resolvable\",\n      \"status\": \"not-checked\",\n      \"items\": [\n        \"stamped-checklist:must/002\",\n        \"stamped-checklist:may/001\"\n      ],\n      \"reason\": \"No submodules or subdatasets: whether external inputs are linked at all needs a reading of the object.\",\n      \"evidence\": [],\n      \"details\": {\n        \"submodules\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/002\": \"not-checked\",\n        \"stamped-checklist:may/001\": \"not-checked\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/002\": \"No submodules or subdatasets: 