{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"cat > commands/check-integrity.py <<'PY'\nimport hashlib,json,os,stat\nfrom pathlib import Path\nroot=Path(os.environ['STAMPED_JUDGE_TARGET'])\ncanon=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\ninitial=json.load(open(os.environ['STAMPED_OPERATIONAL_MANIFEST']))\nprint('manifest identity equal:', canon==initial)\nignore={'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'}\nexpected={e['path'].removeprefix('content/workspace/'):e for e in initial['entries']}\nactual={}\ndef walk(path,rel=''):\n for ent in os.scandir(path):\n  rp=f'{rel}/{ent.name}' if rel else ent.name\n  st=ent.stat(follow_symlinks=False)\n  mode=stat.S_IMODE(st.st_mode)\n  if ent.is_symlink():\n   actual[rp]={'kind':'symlink','mode':mode,'target':os.readlink(ent.path)}\n  elif ent.is_dir(follow_symlinks=False):\n   actual[rp]={'kind':'directory','mode':mode}; walk(ent.path,rp)\n  elif ent.is_file(follow_symlinks=False):\n   h=hashlib.sha256()\n   with open(ent.path,'rb') as f:\n    for b in iter(lambda:f.read(1024*1024),b''): h.update(b)\n   actual[rp]={'kind':'file','mode':mode,'sha256':h.hexdigest(),'size':st.st_size}\n  else: actual[rp]={'kind':'other','mode':mode}\nwalk(root)\nchanges=[]\nfor p in sorted(set(expected)|set(actual)):\n if p in ignore: continue\n a=expected.get(p); b=actual.get(p)\n if a \"'!= b: changes.append((p,a,b))\nprint('\"'non-metadata changes:',len(changes))\nfor c in changes[:25]: print(c)\nmeta=[]\nfor p in sorted(ignore):\n a=expected.get(p); b=actual.get(p)\n if a\"'!=b: meta.append({'\"'path':p,'initial':a,'final':b})\nprint('permitted metadata differences:',json.dumps(meta))\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" commands/check-integrity.py > commands/check-integrity.stdout 2> commands/check-integrity.stderr; echo $? > commands/check-integrity.exit; cat commands/check-integrity.stdout; cat commands/check-integrity.stderr; git -C \"$STAMPED_JUDGE_TARGET\" status --porcelain=v2 > commands/final-git-status.stdout 2> commands/final-git-status.stderr; echo $? > commands/final-git-status.exit; cat commands/final-git-status.stdout'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
