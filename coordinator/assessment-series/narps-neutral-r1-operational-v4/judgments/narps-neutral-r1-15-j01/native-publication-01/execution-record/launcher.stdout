 [\n        {\n          \"uri\": \"git ls-tree -r -l HEAD\",\n          \"description\": \"largest text blob under 10485760 bytes\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {},\n      \"item_status\": {},\n      \"item_reason\": {}\n    },\n    {\n      \"probe\": \"derived-have-records\",\n      \"status\": \"not-applicable\",\n      \"items\": [\n        \"stamped-checklist:must/006\"\n      ],\n      \"reason\": \"N/A: no tracked file looks like a product of this object (no derivatives, tables or figures).\",\n      \"evidence\": [],\n      \"details\": {\n        \"records\": 0,\n        \"workflow_sources\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/006\": \"not-applicable\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/006\": \"N/A: no tracked file looks like a product of this object (no derivatives, tables or figures).\"\n      }\n    },\n    {\n      \"probe\": \"entry-point\",\n      \"status\": \"unmet\",\n      \"items\": [\n        \"stamped-checklist:must/007\",\n        \"stamped-checklist:must/008\"\n      ],\n      \"reason\": \"must/007 unmet: Neither a README with install/usage instructions nor a Makefile. must/008 unmet: No script, make target or workflow definition that a reader could start from.\",\n      \"evidence\": [],\n      \"details\": {\n        \"readmes\": [],\n        \"makefiles\": [],\n        \"named\": [],\n        \"targets\": [],\n        \"workflow\": [],\n        \"has_section\": false,\n        \"documented_targets\": [],\n        \"missing_targets\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/007\": \"unmet\",\n        \"stamped-checklist:must/008\": \"unmet\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/007\": \"Neither a README with install/usage instructions nor a Makefile.\",\n        \"stamped-checklist:must/008\": \"No script, make target or workflow definition that a reader could start from.\"\n      }\n    },\n    {\n      \"probe\": \"env-spec-tracked\",\n      \"status\": \"unmet\",\n      \"items\": [\n        \"stamped-checklist:must/010\",\n        \"stamped-checklist:must/013\",\n        \"stamped-checklist:must/016\"\n      ],\n      \"reason\": \"must/010 unmet: No tracked environment specification (lockfile, container definition or registration). must/013 unmet. must/016 unmet.\",\n      \"evidence\": [],\n      \"details\": {\n        \"specs\": {},\n        \"uninstalled_modules\": [],\n        \"preconditions\": [],\n        \"remote\": null,\n        \"publication\": null\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/010\": \"unmet\",\n        \"stamped-checklist:must/013\": \"unmet\",\n        \"stamped-checklist:must/016\": \"unmet\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/010\": \"No tracked environment specification (lockfile, container definition or registration).\",\n        \"stamped-checklist:must/013\": \"No tracked environment specification (lockfile, container definition or registration).\",\n        \"stamped-checklist:must/016\": \"Nothing to share: No tracked environment specification (lockfile, container definition or registration).\"\n      }\n    },\n    {\n      \"probe\": \"inputs-untouched\",\n      \"status\": \"not-applicable\",\n      \"items\": [],\n      \"reason\": \"N/A: no linked modules, so there is no recorded input state to compare against.\",\n      \"evidence\": [],\n      \"details\": {},\n      \"item_status\": {},\n      \"item_reason\": {}\n    },\n    {\n      \"probe\": \"large-in-annex\",\n      \"status\": \"met\",\n      \"items\": [\n        \"stamped-checklist:must/005\"\n      ],\n      \"reason\": \"git-annex carries the binary content (54 pointer(s) tracked) and no binary blob over 10 MiB is in git.\",\n      \"evidence\": [\n        {\n          \"uri\": \"git ls-tree -r -l HEAD\",\n          \"description\": \"no binary blob over 10485760 bytes\",\n          \"sha256\": null\n        },\n        {\n          \"uri\": \".datalad/config\",\n          \"description\": \"git-annex in use for large content\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"mechanism\": \"git-annex\",\n        \"annex_pointers\": 54,\n        \"large_binary\": []\n      },\n      \"item_status\": {\n        \"stamped-checklist:must/005\": \"met\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:must/005\": \"git-annex carries the binary content (54 pointer(s) tracked) and no binary blob over 10 MiB is in git.\"\n      }\n    },\n    {\n      \"probe\": \"license-declared\",\n      \"status\": \"unmet\",\n      \"items\": [],\n      \"reason\": \"No LICENSE, LICENSES/, REUSE.toml or BIDS License field: reuse terms are unstated.\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:license-declared\",\n          \"description\": \"no licence file among 58 tracked paths, and no License field in any dataset_description.json\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {},\n      \"item_status\": {},\n      \"item_reason\": {}\n    },\n    {\n      \"probe\": \"modules-separated\",\n      \"status\": \"partial\",\n      \"items\": [\n        \"stamped-checklist:should/003\"\n      ],\n      \"reason\": \"Only inputs are separate here; no distinct place for code, derived, environment.\",\n      \"evidence\": [\n        {\n          \"uri\": \"input\",\n          \"description\": \"inputs module\",\n          \"sha256\": null\n        }\n      ],\n      \"details\": {\n        \"found\": {\n          \"inputs\": [\n            \"input\"\n          ],\n          \"code\": [],\n          \"derived\": [],\n          \"environment\": []\n        }\n      },\n      \"item_status\": {\n        \"stamped-checklist:should/003\": \"partial\"\n      },\n      \"item_reason\": {\n        \"stamped-checklist:should/003\": \"Only inputs are se