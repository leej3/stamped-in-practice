{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat > \"$STAMPED_JUDGE_OUTPUT/commands/verify_copy.py\" <<'\"'PY'\nimport hashlib, json, os, pathlib, stat\nroot = pathlib.Path(os.environ['STAMPED_JUDGE_TARGET'])\nmanifest = json.load(open(os.environ['STAMPED_OPERATIONAL_MANIFEST']))\nprefix='content/workspace'\nexpected={}\nfor e in manifest['entries']:\n    p=e['path']\n    if p==prefix: rel='.'\n    elif p.startswith(prefix+'/'): rel=p[len(prefix)+1:]\n    else: continue\n    expected[rel]=e\nobserved=[]\nmetadata=[]\nfor rel,e in expected.items():\n    p=root if rel=='.' else root/rel\n    try: st=p.lstat()\n    except FileNotFoundError:\n        observed.append({'path':rel,'difference':'missing'}); continue\n    kind='symlink' if stat.S_ISLNK(st.st_mode) else 'directory' if stat.S_ISDIR(st.st_mode) else 'file' if stat.S_ISREG(st.st_mode) else 'other'\n    if kind \"'!= e['\"'kind']:\n        observed.append({'path':rel,'difference':'kind','expected':e['kind'],'actual':kind}); continue\n    if kind=='symlink': actual=hashlib.sha256(os.readlink(p).encode()).hexdigest()\n    elif kind=='file':\n        h=hashlib.sha256()\n        with p.open('rb') as f:\n            for block in iter(lambda:f.read(1<<20),b''): h.update(block)\n        actual=h.hexdigest()\n    else: actual=None\n    changed=(actual is not None and actual\"'!=e.get('\"'sha256'))\n    mode_changed=kind\"'!='\"'symlink' and stat.S_IMODE(st.st_mode)\"'!=e.get('\"'mode')\n    if changed or mode_changed:\n        record={'path':rel,'difference':'sha256' if changed else 'mode','expected_sha256':e.get('sha256'),'actual_sha256':actual,'expected_mode':e.get('mode'),'actual_mode':stat.S_IMODE(st.st_mode)}\n        if kind=='file' and rel.startswith('.git/annex/keysdb/') and pathlib.PurePosixPath(rel).name in {'db','db-shm','db-wal'}:\n            metadata.append(record)\n        else: observed.append(record)\n# Check for paths not represented by the complete operational manifest.\nfor dp, dns, fns in os.walk(root, topdown=True, followlinks=False):\n    base=pathlib.Path(dp)\n    for name in list(dns)+fns:\n        p=base/name\n        rel=p.relative_to(root).as_posix()\n        if rel not in expected: observed.append({'path':rel,'difference':'unexpected'})\n        if p.is_symlink() and name in dns: dns.remove(name)\nprint(json.dumps({'operational_manifest_matches':not observed,'non_metadata_differences':observed,'annex_keydb_metadata_differences':metadata,'entry_count':len(expected)},indent=2))\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_JUDGE_OUTPUT/commands/verify_copy.py\" > \"$STAMPED_JUDGE_OUTPUT/integrity-check.json\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stderr\"; status=$?; printf '\"'%s\\\\n' \\\"\"'$status\" > \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/integrity-check.json\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stderr\" >&2; exit \"$status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
