rd/HarvardOxford-cortl-maxprob-thr0-1mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford/HarvardOxford-cortl-prob-1mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford/HarvardOxford-cort-maxprob-thr0-1mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford/HarvardOxford-cort-maxprob-thr50-1mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford/HarvardOxford-sub-maxprob-thr50-1mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford/HarvardOxford-cort-prob-2mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford/HarvardOxford-cortl-maxprob-thr25-2mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford-Cortical.xml\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/fsl/data/atlases/HarvardOxford-Subcortical.xml\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/atlas/mni152_template_2mm.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/figure1_whole_brain.png\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/group_mean_cope.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/vmPFC_atlas_roi.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/minus_log10_p_uncorrected.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/significant_fwe05.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/permutation_max_t.tsv\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/group_t.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/results.json\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/analysis_mask.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/participant_qc.tsv\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/results/figure2_vmPFC_participants.png\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/report.md\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/input/participants.tsv\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/input/upstream-methods.md\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/input/study-task.md\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/input/sources.json\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-11-j01/operational/content/workspace/analysis/run_analysis.py\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-11-j01/attempt-01/frozen-inputs/coordinator-gu