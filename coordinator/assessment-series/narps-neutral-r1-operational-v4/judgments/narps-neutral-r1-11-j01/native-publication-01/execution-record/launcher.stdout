{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'ls -l \"$STAMPED_JUDGE_TARGET/input/data\" | head -8; \"$STAMPED_ASSESSMENT_PYTHON\" -c '\"'import nibabel as n, numpy as np, pathlib; p=pathlib.Path(__import__(\\\"os\\\").environ[\\\"STAMPED_JUDGE_TARGET\\\"]); q=list((p/\\\"input/data\\\").glob(\\\"*.nii.gz\\\")); print(\\\"maps\\\",len(q)); imgs=[n.load(str(x)) for x in q]; a=np.stack([np.asarray(i.dataobj) for i in imgs]); print(\\\"shape\\\",a.shape[1:],\\\"same affine\\\",all(np.allclose(imgs[0].affine,i.affine) for i in imgs)); print(\\\"zero fraction range\\\",float((a==0).mean(axis=(1,2,3)).min()),float((a==0).mean(axis=(1,2,3)).max())); print(\\\"nonzero coverage distribution\\\",{str(k):int(np.sum((a\"'!=0).mean(axis=0)>=k)) for k in [0.9,0.95,0.99,1.0]}); roi=np.asarray(n.load(str(p/\"results/vmPFC_atlas_roi.nii.gz\")).dataobj)>0; c=(a[:,roi]!=0).mean(axis=0); print(\"roi voxels\",int(roi.sum()),\"roi coverage distribution\",{str(k):int(np.sum(c>=k)) for k in [0.9,0.95,0.99,1.0]},\"roi voxels varying support\",int(np.sum((a[:,roi]==0).any(axis=0))))'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
