y the complete operational manifest.\nfor dp, dns, fns in os.walk(root, topdown=True, followlinks=False):\n    base=pathlib.Path(dp)\n    for name in list(dns)+fns:\n        p=base/name\n        rel=p.relative_to(root).as_posix()\n        if rel not in expected: observed.append({'path':rel,'difference':'unexpected'})\n        if p.is_symlink() and name in dns: dns.remove(name)\nprint(json.dumps({'operational_manifest_matches':not observed,'non_metadata_differences':observed,'annex_keydb_metadata_differences':metadata,'entry_count':len(expected)},indent=2))\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_JUDGE_OUTPUT/commands/verify_copy.py\" > \"$STAMPED_JUDGE_OUTPUT/integrity-check.json\" 2> \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stderr\"; status=$?; printf '\"'%s\\\\n' \\\"\"'$status\" > \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.exit\"; cat \"$STAMPED_JUDGE_OUTPUT/integrity-check.json\"; cat \"$STAMPED_JUDGE_OUTPUT/commands/integrity-check.stderr\" >&2; exit \"$status\"'","aggregated_output":"{\n  \"operational_manifest_matches\": false,\n  \"non_metadata_differences\": [\n    {\n      \"path\": \".git/annex/keysdb/db-shm\",\n      \"difference\": \"missing\"\n    },\n    {\n      \"path\": \".git/annex/keysdb/db-wal\",\n      \"difference\": \"missing\"\n    }\n  ],\n  \"annex_keydb_metadata_differences\": [],\n  \"entry_count\": 1164\n}\n","exit_code":0,"status":"completed"}}
