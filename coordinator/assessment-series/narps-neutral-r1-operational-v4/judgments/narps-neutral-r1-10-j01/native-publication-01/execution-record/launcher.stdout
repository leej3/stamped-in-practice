"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"judgement\",\n      \"flags\": []\n    },\n    \"stamped-checklist:must/004\": {\n      \"value\": \"no\",\n      \"reason\": \"5 path(s) are not committed, so the repository is not the whole state: ?? .task-skills/, ?? REPORT.md, ?? analysis/, ?? figures/, ?? results/\",\n      \"status\": \"unmet\",\n      \"evidence\": [\n        {\n          \"uri\": \"git status --porcelain\",\n          \"description\": \"?? .task-skills/, ?? REPORT.md, ?? analysis/, ?? figures/, ?? results/\",\n          \"sha256\": null\n        }\n      ],\n      \"source\": \"probe:tree-clean\",\n      \"flags\": []\n    },\n    \"stamped-checklist:must/005\": {\n      \"value\": \"yes\",\n      \"reason\": \"git-annex carries the binary content (54 pointer(s) tracked) and no binary blob over 10 MiB is in git.\",\n      \"status\": \"met\",\n      \"evidence\": [\n        {\n          \"uri\": \"git ls-tree -r -l HEAD\",\n          \"description\": \"no binary blob over 10485760 bytes\",\n          \"sha256\": null\n        },\n        {\n          \"uri\": \".datalad/config\",\n          \"description\": \"git-annex in use for large content\",\n          \"sha256\": null\n        }\n      ],\n      \"source\": \"probe:large-in-annex\",\n      \"flags\": []\n    },\n    \"stamped-checklist:must/006\": {\n      \"value\": null,\n      \"reason\": \"No run records, so no record names the environment it ran in.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"probe:run-env-linked\",\n      \"flags\": []\n    },\n    \"stamped-checklist:must/007\": {\n      \"value\": \"no\",\n      \"reason\": \"Neither a README with install/usage instructions nor a Makefile.\",\n      \"status\": \"unmet\",\n      \"evidence\": [],\n      \"source\": \"probe:entry-point\",\n      \"flags\": []\n    },\n    \"stamped-checklist:must/008\": {\n      \"value\": \"no\",\n      \"reason\": \"No script, make target or workflow definition that a reader could start from.\",\n      \"status\": \"unmet\",\n      \"evidence\": [],\n      \"source\": \"probe:entry-point\",\n      \"flags\": []\n    },\n    \"stamped-checklist:must/009\": {\n      \"value\": \"yes\",\n      \"reason\": \"No host-specific absolute paths in tracked text files.\",\n      \"status\": \"met\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:no-abs-paths\",\n          \"description\": \"scanned 58 tracked paths, 0 /tmp hit(s), 0 host-specific\",\n          \"sha256\": null\n        }\n      ],\n      \"source\": \"probe:no-abs-paths\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/001\": {\n      \"value\": null,\n      \"reason\": \"No probe covers this item; a reading of the object is required.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"judgement\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/002\": {\n      \"value\": null,\n      \"reason\": \"No recognized CI configuration; inspect equivalent repeated-testing records.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:ci-present\",\n          \"description\": \"no tracked .github/workflows/, .gitlab-ci.yml, .circleci/, .forgejo/workflows/, .gitea/workflows/ in 58 tracked paths\",\n          \"sha256\": null\n        }\n      ],\n      \"source\": \"probe:ci-present\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/003\": {\n      \"value\": \"no\",\n      \"reason\": \"Only inputs are separate here; no distinct place for code, derived, environment.\",\n      \"status\": \"partial\",\n      \"evidence\": [\n        {\n          \"uri\": \"input\",\n          \"description\": \"inputs module\",\n          \"sha256\": null\n        }\n      ],\n      \"source\": \"probe:modules-separated\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/009\": {\n      \"value\": null,\n      \"reason\": \"No probe covers this item; a reading of the object is required.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"judgement\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/004\": {\n      \"value\": null,\n      \"reason\": \"No probe covers this item; a reading of the object is required.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"judgement\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/005\": {\n      \"value\": null,\n      \"reason\": \"No probe covers this item; a reading of the object is required.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"judgement\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/006\": {\n      \"value\": null,\n      \"reason\": \"No recognized CI configuration; inspect equivalent environment-reconstitution records.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [\n        {\n          \"uri\": \"probe:ci-present\",\n          \"description\": \"no tracked .github/workflows/, .gitlab-ci.yml, .circleci/, .forgejo/workflows/, .gitea/workflows/ in 58 tracked paths\",\n          \"sha256\": null\n        }\n      ],\n      \"source\": \"probe:ci-present\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/007\": {\n      \"value\": null,\n      \"reason\": \"No probe covers this item; a reading of the object is required.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"judgement\",\n      \"flags\": []\n    },\n    \"stamped-checklist:should/008\": {\n      \"value\": null,\n      \"reason\": \"No probe covers this item; a reading of the object is required.\",\n      \"status\": \"not-checked\",\n      \"evidence\": [],\n      \"source\": \"judgement\",\n      \"flags\": []\n    },\n    \"stamped-checklist:may/001\": {\n      \"value\": null,\n      \"reason\": \"Inspect independently maintained project components;