{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"cat > replay-record.json <<'EOF'\n{\n  \\\"status\\\": \\\"not-checked\\\",\n  \\\"attempts\\\": 0,\n  \\\"scope\\\": \\\"inspection-retrieval-conditional-complete-delivery-replay\\\",\n  \\\"canonical_capture_sha256\\\": \\\"30c1789617c94c9281de732c088ff1cb50ca8c42114be533237ab3e53e76d06f\\\",\n  \\\"worker_stop_receipt_sha256\\\": \\\"48129fa8fe6dbcf60b02077ede0587888bc760ebd714bffd490c9a5c11f541fa\\\",\n  \\\"candidate_entrypoint\\\": \\\"python analysis/group_analysis.py\\\",\n  \\\"entrypoint_evidence\\\": \\\"REPORT.md identifies analysis/group_analysis.py as the executable analysis, but gives no command or setup procedure.\\\",\n  \\\"required_prerequisites\\\": [\n    \\\"Python 3.13.16\\\",\n    \\\"NumPy 2.5.4\\\",\n    \\\"SciPy 1.18.1\\\",\n    \\\"NiBabel 5.4.2\\\",\n    \\\"Nilearn 0.14.1\\\",\n    \\\"pandas and matplotlib (imported by the script but omitted from the report package list)\\\",\n    \\\"network access to retrieve the Harvard-Oxford atlas and MNI template\\\"\n  ],\n  \\\"reason_not_checked\\\": \\\"No complete environment or runnable setup instructions are supplied. The documented script also fetches atlas and template resources at runtime; this assessment cannot reconstruct the missing environment or permit scientific-input retrieval. No replay copy was created, no shipped outputs were removed, and no scientific replay was attempted.\\\",\n  \\\"selected_generated_outputs_if_replay_were_safe\\\": [\n    \\\"results/group_mean_effect.nii.gz\\\",\n    \\\"results/group_t.nii.gz\\\",\n    \\\"results/group_p_fwe.nii.gz\\\",\n    \\\"results/analysis_mask.nii.gz\\\",\n    \\\"results/analysis_summary.json\\\",\n    \\\"results/quality_checks.json\\\",\n    \\\"results/significant_clusters.csv\\\",\n    \\\"figures/mean_effect.png\\\",\n    \\\"figures/whole_brain_fwe.png\\\",\n    \\\"figures/vmPFC_distribution.png\\\"\n  ],\n  \\\"comparison_if_replay_were_safe\\\": {\n    \\\"frozen_rtol\\\": 0.000001,\n    \\\"scientific_quantities\\\": \\\"Compare numerical voxel values in generated NIfTI maps and numeric summary/table fields at relative tolerance 1e-6; assess generated images separately for scientific content, not byte equality.\\\",\n    \\\"non_scientific_differences\\\": \\\"Ignore timestamps, logs, prose and formatting when interpreting numerical results.\\\",\n    \\\"source\\\": \\\"frozen replay scope\\\"\n  },\n  \\\"shipped_outputs_are_not_replay_evidence\\\": true\n}\nEOF\ncat > access-record.json <<'EOF'\n{\n  \\\"intended_recipient\\\": \\\"A researcher using the worker-declared authorized route\\\",\n  \\\"declared_authorized_route\\\": null,\n  \\\"route_status\\\": \\\"No worker-declared project retrieval route was found in the worker-stop workspace, report, or Git remote configuration.\\\",\n  \\\"route_test\\\": \\\"not performed; no authorized route was declared to test\\\",\n  \\\"required_artifact_coverage\\\": [\n    \\\"the 54 supplied participant maps and metadata\\\",\n    \\\"analysis code and notebook\\\",\n    \\\"scientific report and figures\\\",\n    \\\"generated group maps, tables, and quality/summary files\\\",\n    \\\"the exact runnable environment and instructions\\\"\n  ],\n  \\\"coverage_via_declared_route\\\": \\\"none established\\\",\n  \\\"host_scope_tested\\\": \\\"none; there was no declared route or host to test\\\",\n  \\\"notes\\\": \\\"input/sources.json lists upstream NeuroVault source URLs for participant maps, but these are input provenance references, not a worker-declared route for retrieving the complete project and its results. Coordinator delivery and later preservation are not worker publication evidence.\\\"\n}\nEOF\ncat > commands/08-target-status.sh <<'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\ngit -C \"$STAMPED_JUDGE_TARGET\" status --short --ignored\ngit -C \"$STAMPED_JUDGE_TARGET\" log -1 --format='\"'%H%n%ci%n%s'\ngit -C \\\"\"'$STAMPED_JUDGE_TARGET\" remote -v\ngit -C \"$STAMPED_JUDGE_TARGET\" config --local --list --show-origin\nEOF\nchmod +x commands/08-target-status.sh\ncommands/08-target-status.sh > commands/08-target-status.stdout.txt 2> commands/08-target-status.stderr.txt\ncat > commands/09-analysis-inspection.sh <<'\"'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\nnl -ba \"$STAMPED_JUDGE_TARGET/REPORT.md\"\nnl -ba \"$STAMPED_JUDGE_TARGET/analysis/group_analysis.py\"\ncat \"$STAMPED_JUDGE_TARGET/input/upstream-methods.md\"\ncat \"$STAMPED_JUDGE_TARGET/results/analysis_summary.json\"\ncat \"$STAMPED_JUDGE_TARGET/results/quality_checks.json\"\ncat \"$STAMPED_JUDGE_TARGET/results/significant_clusters.csv\"\nEOF\nchmod +x commands/09-analysis-inspection.sh\ncommands/09-analysis-inspection.sh > commands/09-analysis-inspection.stdout.txt 2> commands/09-analysis-inspection.stderr.txt'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
