tlas README ---\n# Nilearn data folder\n\nThis directory is used by Nilearn to store datasets\nand atlases downloaded from the internet.\nIt can be safely deleted.\nIf you delete it, previously downloaded data will be downloaded again.--- worker git summary ---\n8a84ddc3eec68d0b7513f9a15ce37174288b36b7\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'find \"$(dirname \"$(dirname \"$STAMPED_DELIVERY_MANIFEST\")\")\" -maxdepth 2 -name judge-target.json -print\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" probes --help\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" validate --help\nfind \"$STAMPED_JUDGE_TARGET/atlas_cache\" -type f -maxdepth 5 -print\npython - <<'\"'PY'\nimport json,os\nroot=os.path.dirname(os.path.dirname(os.environ['STAMPED_DELIVERY_MANIFEST']))\nprint('manifestbase',root)\nfor p in [os.path.join(root,'judge-target.json'), os.path.join(os.path.dirname(root),'judge-target.json')]:\n if os.path.exists(p):\n  d=json.load(open(p)); print('FOUND',p); print(json.dumps(d,indent=2)[:12000])\nm=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nprint('head_commit=',m.get('head_commit'))\nprint('workspace=',m.get('workspace'))\nprint('policy=',json.dumps(m.get('policy'),indent=2))\nprint('git_metadata=',json.dumps(m.get('git_metadata'),indent=2)[:5000])\nprint('git_dependencies=',json.dumps(m.get('git_dependencies'),indent=2)[:3000])\nprint('omissions=',json.dumps(m.get('omissions'),indent=2)[:1000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'find \"$(dirname \"$(dirname \"$STAMPED_DELIVERY_MANIFEST\")\")\" -maxdepth 2 -name judge-target.json -print\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" probes --help\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" validate --help\nfind \"$STAMPED_JUDGE_TARGET/atlas_cache\" -type f -maxdepth 5 -print\npython - <<'\"'PY'\nimport json,os\nroot=os.path.dirname(os.path.dirname(os.environ['STAMPED_DELIVERY_MANIFEST']))\nprint('manifestbase',root)\nfor p in [os.path.join(root,'judge-target.json'), os.path.join(os.path.dirname(root),'judge-target.json')]:\n if os.path.exists(p):\n  d=json.load(open(p)); print('FOUND',p); print(json.dumps(d,indent=2)[:12000])\nm=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nprint('head_commit=',m.get('head_commit'))\nprint('workspace=',m.get('workspace'))\nprint('policy=',json.dumps(m.get('policy'),indent=2))\nprint('git_metadata=',json.dumps(m.get('git_metadata'),indent=2)[:5000])\nprint('git_dependencies=',json.dumps(m.get('git_dependencies'),indent=2)[:3000])\nprint('omissions=',json.dumps(m.get('omissions'),indent=2)[:1000])\nPY\"","aggregated_output":"✔ The default environment has been installed.\nusage: run_probes.py [-h] [-o OUTPUT] [--response RESPONSE]\n                     [--only {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--skip {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--check-remote] [--allow GLOB [GLOB ...]]\n                     [--kind {dataset,component,study,skill}] [--overwrite]\n                     [--quiet]\n                     path\n\nRun the STAMPED probes over a checked-out research object.\n\n    run_probes.py <path> [-o probes.json] [--response response.json]\n                  [--only NAME ...] [--skip NAME ...] [--check-remote]\n                  [--kind dataset|component|study|skill]\n\nWrites the per-probe results, and optionally a response JSON (the format in\n``../stamped-conventions/references/response-format.md``) in which every item a\nprobe speaks to carries that probe's verdict and every other item is left\n``not-checked`` for the assessing session to judge.\nWithout a Git commit, ``-o`` retains a limitation receipt and exit code 2;\nno response draft is produced.\n\nThe probes never modify the object.  Nothing here replaces the judgement items:\na response straight out of this script is a draft, not an assessment.\n\npositional arguments:\n  path                  checked-out object to probe\n\noptions:\n  -h, --help            show this help message and exit\n  -o, --output OUTPUT   write the probe results here\n  --response RESPONSE   also write a draft response JSON here\n  --only {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]\n                        run just these probes\n  --skip {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]\n  --check-remote        contact submodule urls (network)\n  --allow GLOB [GLOB ...]\n                        paths no-abs-paths may skip, for files that genuinely\n                        have to carry a host path\n  --kind {dataset,component,study,skill}\n  --overwrite           replace an existing --response file instead of keeping\n                        its judged answers\n  --quiet\n✔ The default environment has been installed.\nusage: encode_response.py validate [-h] response\n\npositional arguments:\n  response\n\noptions:\n  -h, --help  show this help message and exit\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j01/operational/content/workspace/atlas_cache/README.md\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j01/operational/content/workspace/atlas_cache/aal_3v2/AAL3/ROI_MNI_V7_1mm.nii\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j01/operational/content/workspace/atlas_cache/aal_3v2/AAL3/ROI_MNI_V7_1mm_Border.mat\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j01/operational