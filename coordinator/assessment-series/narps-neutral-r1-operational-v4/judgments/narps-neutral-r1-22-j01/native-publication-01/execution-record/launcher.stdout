1b44ff02ee6514db.nii.gz\",\n        \"bytes\": 1814013,\n        \"git_blob\": \"488709e275ff739ad94f59bd51a62733ea9f321b\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-103_hypo1_cope.nii.gz\",\n        \"sha256\": \"a088633f18ac3e35fc2512e9dc21ec3d92efd06749d4027338ccb448a635919c\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1795447--0d2e10b282f31b79333df03d7185c7fd.nii.gz\",\n        \"bytes\": 1795447,\n        \"git_blob\": \"feffa1f5e0a52d1454b153002a776b749eeb21c4\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-105_hypo1_cope.nii.gz\",\n        \"sha256\": \"12a1b50eaa5be6983990c5e77f985f9750340204eaa3fff7e70829f07707e6a2\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1804121--5b49e871d66e1c1044c7ae399be7dfa6.nii.gz\",\n        \"bytes\": 1804121,\n        \"git_blob\": \"687403d4670f20cedc0a498fb45b92b39676ffa6\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-107_hypo1_cope.nii.gz\",\n        \"sha256\": \"4580aade93323d0d14f9a3a1932a428004a2f657980b5669f9274102bb370802\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1788268--539e7f0b6d71a436a8219092adbc52f1.nii.gz\",\n        \"bytes\": 1788268,\n        \"git_blob\": \"f2ace72aba03a9fe0c26e494881bd7a595b46271\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-109_hypo1_cope.nii.gz\",\n        \"sha256\": \"931ba1128720bbaa99e7fce8f036a331581d6d07e00212a1f402eae7959299cb\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1819506--71c75230fe451790817cf16b6da9ff58.nii.gz\",\n        \"bytes\": 1819506,\n        \"git_blob\": \"ea27e5b0c0c8427814e781a676c8d5fa6f37cf3e\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-113_hypo1_cope.nii.gz\",\n        \"sha256\": \"e5f81435ddc2d5703fa4ea37d6597601e71b50f8c53fb6047fb0067c17282c65\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1797041--fe43c7de7c84d8f43b58e4aa086b53ba.nii.gz\",\n        \"bytes\": 1797041,\n        \"git_blob\": \"b631000896ccbd898c6815bd7fd3cc37d5c63397\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-115_hypo1_cope.nii.gz\",\n        \"sha256\": \"5046f7c2fa1c5d1be6237d38f631beca13df8a3a8ded11121082838a533a44bf\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1741472--1b6b2c3638000fc53dd7fb8dbb61acf7.nii.gz\",\n        \"bytes\": 1741472,\n        \"git_blob\": \"893b02820b0ab583d89f48cb0d79d3379214db3f\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-117_hypo1_cope.nii.gz\",\n        \"sha256\": \"711159acfa23c45ab82903f658cafe0fa539f39e077e451f6b0728fdb359445f\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1752220--b816d25a8c2c7bff1aa1edad085b28a8.nii.gz\",\n        \"bytes\": 1752220,\n        \"git_blob\": \"a982444d0e8863ef8ae92b6cca5241220a6f2567\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-119_hypo1_cope.nii.gz\",\n        \"sha256\": \"01738a10e34e46c5ea1a4a192b9484595ee352d62375095b76726347455aabd7\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1766758--e3eb3d7581b6d2fe23cad501f55633b1.nii.gz\",\n        \"bytes\": 1766758,\n        \"git_blob\": \"d54f02fb894923015ce51e6396f85790a2d5337c\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-121_hypo1_cope.nii.gz\",\n        \"sha256\": \"94357665b89cfa1b9157e71aab10f78b49585a790a4a01d9e4693698e185d892\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1745649--b676063de1663e99a46507e0ceb79fad.nii.gz\",\n        \"bytes\": 1745649,\n        \"git_blob\": \"8595d8b8005c7e26b27b3005c58c8e7d96659ec5\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-123_hypo1_cope.nii.gz\",\n        \"sha256\": \"1219377e08c306753c1e382d431b1e7a55c7143cdc5f800fb65e92fa7e72f888\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"bytes\": 1706,\n        \"git_blob\": \"ffec3809a59a904eb1110bf8823d494112a0413e\",\n        \"mode\": \"100644\",\n        \"path\": \"input/participants.tsv\",\n        \"sha256\": \"faca815bcb042144bdb8dcff915f45de0d27650f60416ed76a5a72557341abbf\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 19843,\n        \"git_blob\": \"1d3637a98c93a1bdd00da5f988eda0c7fae3d5d7\",\n        \"mode\": \"100644\",\n        \"path\": \"input/sources.json\",\n        \"sha256\": \"919be9b4278c31f7e39ae3d02fcf159eb4ae222a2fb96c90df7c3a92e5fb19cd\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 1483,\n        \"git_blob\": \"8dd89ecab97a46f4862d68bb9ca6fd455fd171ca\",\n        \"mode\": \"100644\",\n        \"path\": \"input/study-task.md\",\n        \"sha256\": \"e92bf2e0c0db4cc49688cce9f9dfff8a236fc4ec151c09961719f49f31310cc8\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 1342,\n        \"git_blob\": \"08d82cf379f81ada98a79bf2e6d837ce08af0bb3\",\n        \"mode\": \"100644\",\n        \"path\": \"input/upstream-methods.md\",\n        \"sha256\": \"508d832c8787ed8303c3de101c2c76f40a3aa5dec53e6993dc2a49c4b7bcf90b\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 2362,\n        \"mode\": \"100644\",\n        \"path\": \".codex/hooks.json\",\n        \"sha256\": \"d0ed5dd1cf5d2d269abfdb6c00161b406d0233b7a4bf1ff72f288405b4959b10\"\n      },\n      {\n        \"bytes\": 310,\n        \"mode\": \"100644\",\n        \"path\": \".entire/settings.local.json\",\n        \"sha256\": \"b8d01a092e151ab8c251ff67b17f16cba06e3550932513174b727816c52ac185\"\n      },\n      {\n        \"bytes\": 58,\n        \"mode\": \"100644\",\n        \"path\": \".entire/.gitignore\",\n        \"sha256\": \"e0d32a3775837a6a1df279f0e6b0e04c02cf3b472781a406aa4586c8ffe02e64\"\n      }\n    ]\n  },\n  \"worker\": {\n    \"pid\": 59608,\n    \"returncode\": 0,\n    \"stop_reason\": \"exited\",\n    \"stopped_at\": \"2026-10-16T06:59:04.511404+00:00\",\n    \"timed_out\": false\n  }\n}\n\n STAMPED_ASSESSMENT_VERSION /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-22-j01/attempt-01/frozen-inputs/assessment-version.json\n{\n  \"version\": 1,\n  \"source_commit\": \"9852d8360f9519d21d11099b45f5deb8ba80cb28\",\n  \"environment_commit\": \"3552d5003a2485b6405805236d5c54e7ed42f097\",\n  \"sha256\": {\n    \"pixi.toml\": \"131fc78549d9fe54a3e6c055e59ef753b1794df77507777b21c9529a611e7b89\",\n    \"pixi.lock\": \"f8fff1394fbeaa2ab1c4993fceb0dd6463fe0c08c81fcda397f3e752a72c4249\"\n  },\n  \"environment_repository\": \"https://github.com/leej3/stamped-ai-research-next.git\"\n}\n--- worker-authored files ---\n### REPORT.md\n# Potential gains and vmPFC activity\n\n## Question and conclusion\n\nIn the 54-person NARPS equal-indifference group, the supplied gain-effect maps do **not** support a positive gain association in vmPFC under whole-brain family-wise error (FWE) correction. In a bilateral medial orbitofrontal anatomical proxy for vmPFC, the mean participant effect was −0.008 supplied units (95% t interval −0.035 to 0.019); no voxel in that proxy survived whole-brain correction. This is absence of evidence for the predicted positive effect in these maps, not evidence that the true effect is exactly zero.\n\nThe whole-brain test did identify 23 positive FWE-significant voxels in three small posterior-inferior foci (peak t=6.62 at MNI [−26, −102, −3.6]; two other peaks are listed in `results/fwe_clusters.tsv`). These do not overlap the vmPFC proxy. They lie near the posterior-inferior edge of the analyzed brain; one peak is outside AAL3-labeled tissue. I therefore do not interpret them as evidence about gain coding or as a vmPFC finding.\n\n## Group model and inference\n\nI tested whether the unweighted mean of the 54 participant gain-effect estimates was greater than zero at each voxel. The maps are participant contrast parameter estimates, not t/z statistics. Because participant variance maps were not supplied, I used an unweighted one-sample group t statistic rather than precision-weighted second-level inference. A one-sided sign-flip randomization test (5,000 random sign patterns; fixed seed 20261016) evaluated the positive-direction hypothesis. For each randomization, I recorded the maximum t over the analysis mask; voxel p-values are adjusted against that maximum distribution, controlling whole-brain voxelwise FWE at 0.05. The 95th percentile maximum-t threshold was 5.39. Sign flipping assumes independent participants and a symmetric null distribution of participant effects. The original NARPS instructions posed a positive, region-specific hypothesis and required support decisions from whole-brain-corrected analyses; this analysis keeps that whole-brain correction rather than treating an uncorrected ROI result as support ([NARPS analysis instructions](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf); [permutation inference background](https://pmc.ncbi.nlm.nih.gov/articles/PMC6871862/)).\n\nThe analysis mask intersected an MNI152 standard brain mask with voxels nonzero in at least 49 of 54 maps and finite in every map (192,339 voxels). The vmPFC anatomical proxy was the bilateral `Frontal_Med_Orb` parcel in AAL3v2, mapped to the input grid using nearest-neighbor resampling. This is an explicit reproducible anatomical proxy, not a claim that one atlas parcel exhaustively defines functional vmPFC ([AAL3 atlas paper](https://pubmed.ncbi.nlm.nih.gov/31521825/)). The ROI summary is descriptive; it does not replace or relax whole-brain correction.\n\n## Data checks and limitations\n\nAll 54 supplied maps matched the equal-indifference participant IDs, shared the same MNI grid, loaded with finite data, and passed the SHA256 values in the supplied manifest. No participant was excluded. The task’s potential-gain range was twice its potential-loss range, as described in the supplied methods. However, the upstream gain regressor was mean-centered and variance-normalized before HRF convolution, so these coefficients are not change per currency unit. The estimates are conditional on the upstream choice to model gain separately from loss and on its other fixed first-level terms. This group analysis cannot revisit those modeling decisions.\n\nThe lack of participant variance maps prevents a precision-weighted mixed-effects analysis and limits uncertainty modeling to variation across the supplied participant estimates. The permutation result relies on sign-flip symmetry. AAL3 medial orbitofrontal cortex is an imperfect vmPFC proxy, and the maps’ MNI152NLin2009cAsym space and the standard mask/atlas are not identical templates. The interval around the proxy mean includes zero and is not an equivalence interval: modest positive or spatially heterogeneous effects remain possible. A non-significant whole-brain-corrected result therefore means this group analysis did not establish a positive vmPFC effect at the chosen error rate; it does not show that increasing gains have no neural correlate. More broadly, the parametric map association does not establish that potential gain causally produces a response.\n\n## Figures\n\n**Figure 1.** Participant-average effect within bilateral medial orbitofrontal vmPFC proxy. Each dot is one participant; the diamond and interval show the mean and descriptive 95% t interval across participants.\n\n![Participant effects in vmPFC proxy](results/vmPFC_proxy_effects.png)\n\n**Figure 2.** Positive t statistics exceeding the 95th percentile of the whole-brain maximum-t null distribution; green outline is the vmPFC proxy. Small corrected foci occur posterior-inferior to the proxy and are not interpreted anatomically.\n\n![Whole-brain corrected map](results/wholebrain_fwe_map.png)\n\n## Reproducibility files\n\n- `analyze.py` — complete group-analysis and figure-generation script (Python with NumPy, pandas, SciPy, NiBabel, Nilearn, and Matplotlib).\n- `results/summary.json` — numeric analysis summary and QC decisions.\n- `results/fwe_clusters.tsv` — descriptive extents and peak coordinates for corrected voxels; cluster extent itself was not the inferential correction.\n- `results/participant_qc.tsv` — per-participant coverage and effect summaries.\n- `results/group_mask.nii.gz`, `results/mean_effect.nii.gz`, `results/t_statistic.nii.gz`, `results/p_fwe_maxT.nii.gz` — analysis mask, mean, t, and max-T adjusted p maps.\n- `results/vmPFC_proxy_aal3.nii.gz` — resampled anatomical proxy used for localization.\n\nReproduce from the workspace root with:\n\n```bash\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/common-environment/.pixi/envs/default/bin/python analyze.py\n```\n### analyze.py\n#!/usr/bin/env python3\n\"\"\"Group analysis of supplied NARPS AO86 Hypothesis 1 participant cope maps.\"\"\"\nfrom pathlib import Path\nimport json\nimport hashlib\nimport numpy as np\nimport pandas as pd\nimport nibabel as nib\nfrom nilearn import datasets, image, plotting\nimport matplotlib.pyplot as plt\nfrom scipy import stats, ndimage\n\nROOT = Path(__file__).resolve().parent\nOUT = ROOT / \"results\"\nOUT.mkdir(exist_ok=True)\nDATA = ROOT / \"input\" / \"data\"\nN_PERM = 5000\nSEED = 20261016\n\nfiles = sorted(DATA.glob(\"sub-*_hypo1_cope.nii.gz\"))\nassert len(files) == 54, f\"Expected 54 maps, found {len(files)}\"\nparticipants = pd.read_csv(ROOT / \"input\" / \"participants.tsv\", sep=\"\\t\")\nexpected_ids = set(participants.loc[participants[\"group\"] == \"equalIndifference\", \"participant_id\"].astype(str))\nfound_ids = {p.name.split(\"_\")[0] for p in files}\nassert expected_ids == found_ids and len(expected_ids) == 54\nsource_manifest = json.loads((ROOT / \"input\" / \"sources.json\").read_text())\nhash_checks = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() == source_manifest[\"files\"][f\"data/{p.name}\"][\"sha256\"]\n               for p in files}\nassert len(hash_checks) == 54 and all(hash_checks.values()), \"Input checksum mismatch\"\nimgs = [nib.load(str(p)) for p in files]\nref = imgs[0]\nassert all(im.shape == ref.shape and np.allclose(im.affine, ref.affine) for im in imgs)\narr = np.stack([im.get_fdata(dtype=np.float32) for im in imgs])\nfinite = np.isfinite(arr)\nnonzero = finite & (arr != 0)\ncoverage = nonzero.sum(axis=0)\n# Intersect map coverage with an independent standard brain mask.\nstandard_mask = datasets.load_mni152_brain_mask(resolution=2, threshold=.2)\nstandard_mask_on_ref = image.resample_to_img(standard_mask, ref, interpolation=\"nearest\",\n                                              force_resample=True, copy_header=True)\nmask = ((coverage >= int(np.ceil(.90 * len(files)))) & np.all(finite, axis=0)\n        & (np.asarray(standard_mask_on_ref.dataobj) > 0))\nX = arr[:, mask].astype(np.float64)\nn, v = X.shape\nassert n == 54 and v > 10000\n\n# One-sample t statistic, positive direction. Random sign flips test the zero-mean null.\n# The same maximum statistic from every permutation controls whole-brain voxelwise FWER.\nsum_sq = np.sum(X * X, axis=0)\ndef t_from_sum(s):\n    denom2 = (n * sum_sq - s * s) / (n - 1)\n    return s / np.sqrt(np.maximum(denom2, np.finfo(float).tiny))\n\nt_obs = t_from_sum(X.sum(axis=0))\nrng = np.random.default_rng(SEED)\nmax_t = np.empty(N_PERM, dtype=np.float64)\nbatch = 32\nfor start in range(0, N_PERM, batch):\n    b = min(batch, N_PERM - start)\n    signs = rng.choice(np.array([-1.0, 1.0]), size=(b, n))\n    sums = signs @ X\n    t_perm = sums / np.sqrt(np.maximum((n * sum_sq[None, :] - sums * sums) / (n - 1), np.finfo(float).tiny))\n    max_t[start:start+b] = np.max(t_perm, axis=1)\nsorted_max = np.sort(max_t)\n# plus-one Monte Carlo correction; adjusted p is based on whole-brain maximum T.\nidx = np.searchsorted(sorted_max, t_obs, side=\"left\")\np_fwe = (N_PERM - idx + 1) / (N_PERM + 1)\n\ndef full_img(vals, dtype=np.float32):\n    a = np.zeros(ref.shape, dtype=dtype)\n    a[mask] = vals\n    return nib.Nifti1Image(a, ref.affine, ref.header)\n\nmean = X.mean(axis=0)\nsd = X.std(axis=0, ddof=1)\nnib.save(nib.Nifti1Image(mask.astype(np.uint8), ref.affine, ref.header), OUT / \"group_mask.nii.gz\")\nnib.save(full_img(mean), OUT / \"mean_effect.nii.gz\")\nnib.save(full_img(t_obs), OUT / \"t_statistic.nii.gz\")\nnib.save(full_img(p_fwe), OUT / \"p_fwe_maxT.nii.gz\")\n\n# Anatomical vmPFC proxy: bilateral medial orbitofrontal cortex from AAL3v2.\natlas = datasets.fetch_atlas_aal(version=\"3v2\", data_dir=str(ROOT / \"atlas_cache\"), verbose=0)\natlas_img = nib.load(atlas.maps) if isinstance(atlas.maps, str) else atlas.maps\nlabels = list(atlas.labels)\nlabel_text = [x.decode() if isinstance(x, bytes) else str(x) for x in labels]\nroi_ids = [i for i, name in enumerate(label_text) if \"Frontal_Med_Orb\" in name]\nif not roi_ids:\n    raise RuntimeError(f\"AAL3 medial orbitofrontal labels not found: {label_text}\")\n# AAL uses background label 0; IDs align with label-table index.\natlas_on_ref = image.resample_to_img(atlas_img, ref, interpolation=\"nearest\")\nroi_native = np.isin(np.asarray(atlas_on_ref.dataobj), roi_ids)\nroi = roi_native & mask\nif not roi.any():\n    raise RuntimeError(\"vmPFC proxy ROI has no overlap with group mask\")\nroi_values = X[:, roi[mask]]\nroi_mean = roi_values.mean(axis=1)\nroi_sd = float(roi_mean.std(ddof=1))\nroi_se = roi_sd / np.sqrt(n)\nroi_t = float(roi_mean.mean() / roi_se)\nroi_ci = [float(roi_mean.mean() - stats.t.ppf(.975, n-1) * roi_se),\n          float(roi_mean.mean() + stats.t.ppf(.975, n-1) * roi_se)]\nroi_mask_img = nib.Nifti1Image(roi.astype(np.uint8), ref.affine, ref.header)\nnib.save(roi_mask_img, OUT / \"vmPFC_proxy_aal3.nii.gz\")\n\n# Summaries and QC, no data-driven subject exclusions.\nparticipant_mean = arr[:, mask].mean(axis=1)\nparticipant_sd = arr[:, mask].std(axis=1, ddof=1)\nparticipant_roi_mean = roi_values.mean(axis=1)\nqc = pd.DataFrame({\"participant\": [p.name.split(\"_\")[0] for p in files],\n                   \"mean_in_mask\": participant_mean, \"sd_in_mask\": participant_sd,\n                   \"mean_in_vmPFC_proxy\": participant_roi_mean,\n                   \"fraction_finite\": finite.reshape(n, -1).mean(axis=1),\n                   \"fraction_nonzero\": nonzero.reshape(n, -1).mean(axis=1)})\nqc.to_csv(OUT / \"participant_qc.tsv\", sep=\"\\t\", index=False)\n\nsumm = {\n    \"n_maps\": n, \"input_sha256_checks_passed\": bool(all(hash_checks.values())),\n    \"n_voxels_whole_brain_mask\": int(v), \"mask_rule\": \"MNI152 standard brain mask intersected with finite voxels nonzero in >=90% (>=49/54) maps\",\n    \"n_permutations\": N_PERM, \"seed\": SEED, \"test\": \"one-sided positive one-sample t with random sign flips and whole-brain maximum-T FWER\",\n    \"fwe_alpha\": 0.05, \"max_t_critical_95\": float(np.quantile(max_t, .95, method=\"higher\")),\n    \"whole_brain_sig_voxels\": int(np.sum(p_fwe <= .05)),\n    \"max_t_observed\": float(np.max(t_obs)), \"minimum_p_fwe\": float(np.min(p_fwe)),\n    \"group_mean_effect_range\": [float(mean.min()), float(mean.max())],\n    \"group_mean_effect_peak_mni\": [float(x) for x in nib.affines.apply_affine(ref.affine, np.array(np.unravel_index(int(np.argmax(full_img(t_obs).get_fdata())), ref.shape)))],\n    \"vmPFC_proxy_atlas\": \"AAL3v2 bilateral Frontal_Med_Orb\", \"vmPFC_label_ids\": roi_ids,\n    \"vmPFC_proxy_voxels\": int(roi.sum()), \"vmPFC_proxy_mean_effect\": float(roi_mean.mean()),\n    \"vmPFC_proxy_sd_between_participants\": roi_sd,\n    \"vmPFC_proxy_mean_effect_95CI_t_descriptive\": roi_ci,\n    \"vmPFC_proxy_mean_t_descriptive\": roi_t,\n    \"vmPFC_proxy_p_positive_t_descriptive\": float(stats.t.sf(roi_t, n-1)),\n    \"vmPFC_proxy_min_whole_brain_adjusted_p\": float(p_fwe[roi[mask]].min()),\n    \"vmPFC_proxy_significant_voxels_fwe05\": int(np.sum(p_fwe[roi[mask]] <= .05)),\n    \"participant_mean_effect_mean\": float(participant_mean.mean()),\n    \"participant_mean_effect_sd\": float(participant_mean.std(ddof=1)),\n    \"exclusions\": [],\n}\n(OUT / \"summary.json\").write_text(json.dumps(summ, indent=2) + \"\\n\")\n\n# Connected components are descriptive summaries of the globally corrected voxels.\nsig_data = np.zeros(ref.shape, dtype=bool)\nsig_data[mask] = p_fwe <= .05\ncomponents, n_comp = ndimage.label(sig_data, structure=ndimage.generate_binary_structure(3, 3))\nt_full = np.zeros(ref.shape, dtype=np.float64)\nt_full[mask] = t_obs\ncluster_rows = []\nfor lab in range(1, n_comp + 1):\n    ijk = np.argwhere(components == lab)\n    tvals = t_full[tuple(ijk.T)]\n    peak_ijk = ijk[int(np.argmax(tvals))]\n    xyz = nib.affines.apply_affine(ref.affine, peak_ijk)\n    cluster_rows.append({\"cluster\": lab, \"voxels_input_grid\": len(ijk), \"peak_t\": float(tvals.max()),\n                         \"peak_mni_x\": float(xyz[0]), \"peak_mni_y\": float(xyz[1]), \"peak_mni_z\": float(xyz[2])})\npd.DataFrame(cluster_rows).to_csv(OUT / \"fwe_clusters.tsv\", sep=\"\\t\", index=False)\n\n# Participant vmPFC proxy averages: one value per participant, with a descriptive t interval.\nplt.rcParams.update({\"font.size\": 9, \"axes.spines.top\": False, \"axes.spines.right\": False})\nfig, ax = plt.subplots(figsize=(5.8, 4.2), constrained_layout=True)\nax.scatter(np.random.default_rng(SEED).normal(0, .045, n), roi_mean, s=24, alpha=.75,\n           color=\"#547a9a\", edgecolor=\"white\", linewidth=.3)\nax.errorbar(0, roi_mean.mean(), yerr=[[roi_mean.mean()-roi_ci[0]], [roi_ci[1]-roi_mean.mean()]],\n            fmt=\"D\", color=\"#b54b3a\", capsize=4, markersize=7, label=\"Mean and 95% t CI\")\nax.axhline(0, color=\"black\", linewidth=1, linestyle=\"--\")\nax.set(xlim=(-.25,.25), xlabel=\"Participants (jittered)\", ylabel=\"Mean effect in vmPFC proxy (supplied units)\",\n       title=\"Bilateral medial orbitofrontal proxy\")\nax.set_xticks([])\nax.legend(frameon=False, fontsize=8)\nfig.savefig(OUT / \"vmPFC_proxy_effects.png\", dpi=180)\nplt.close(fig)\n\n# Whole-brain corrected positive group findings; green outline shows the independent ROI proxy.\nfig = plt.figure(figsize=(7.0, 5.0))\ntemplate = datasets.load_mni152_template(resolution=2)\ndisplay = plotting.plot_stat_map(full_img(t_obs), bg_img=template, threshold=float(np.quantile(max_t, .95, method=\"higher\")),\n                                 display_mode=\"ortho\", cut_coords=(-26, -102, -4), cmap=\"hot\", colorbar=True,\n                                 black_bg=False, figure=fig, title=None, draw_cross=True)\ndisplay.add_contours(roi_mask_img, levels=[.5], colors=[\"#18a558\"], linewidths=1.5)\nfig.suptitle(\"Positive t above whole-brain max-T FWE threshold\\nGreen: bilateral vmPFC proxy\", fontsize=12)\nfig.savefig(OUT / \"wholebrain_fwe_map.png\", dpi=180)\nplt.close(fig)\n\nprint(json.dumps(summ, indent=2))\n### input/upstream-methods.md\n# Fixed upstream analysis\n\nEach map is one participant's unthresholded gain-effect estimate from NARPS team AO86, averaged across four runs.\nThe 54 participants comprise the complete equal-indifference group in OpenNeuro ds001734 version 1.0.4.\nThese are effect estimates, not standardized test statistics or group results.\nMaps are reported in MNI152NLin2009cAsym space.\n\nAO86 used fMRIPrep outputs and nistats participant models.\nTheir reported gain regressor was mean-centered and variance-normalized before HRF convolution; its coefficients must not be interpreted as change per currency unit.\nResponse trials used response-time durations, with separate response-choice and gain modulators.\nNonresponse trials, motion terms, flagged volumes and drift terms were also modeled; runs were combined within participant.\nGain and loss used separate models, so the supplied gain effect is conditional on that modeling choice.\n\nThe reported upstream choices are fixed for this task.\nParticipant variance maps and a complete executable upstream pipeline are not supplied; account for these limits when choosing and interpreting group inference.\n`participants.tsv` retains the source group, age and gender columns.\n`sources.json` identifies each original image, its retrieved-byte checksum, the pinned cohort table and the original methods report.\n### input/participants.tsv\nparticipant_id\tgroup\tgender\tage\nsub-001\tequalIndifference\tM\t24\nsub-003\tequalIndifference\tF\t27\nsub-005\tequalIndifference\tM\t27\nsub-009\tequalIndifference\tM\t26\nsub-011\tequalIndifference\tM\t30\nsub-013\tequalIndifference\tM\t26\nsub-015\tequalIndifference\tF\t26\nsub-017\tequalIndifference\tF\t24\nsub-019\tequalIndifference\tM\t25\nsub-021\tequalIndifference\tF\t22\nsub-025\tequalIndifference\tM\t25\nsub-027\tequalIndifference\tF\t27\nsub-029\tequalIndifference\tM\t25\nsub-033\tequalIndifference\tM\t23\nsub-035\tequalIndifference\tM\t32\nsub-037\tequalIndifference\tF\t25\nsub-039\tequalIndifference\tF\t28\nsub-041\tequalIndifference\tF\t27\nsub-043\tequalIndifference\tM\t28\nsub-045\tequalIndifference\tF\t28\nsub-047\tequalIndifference\tM\t27\nsub-049\tequalIndifference\tF\t27\nsub-051\tequalIndifference\tF\t28\nsub-053\tequalIndifference\tF\t30\nsub-055\tequalIndifference\tF\t37\nsub-057\tequalIndifference\tF\t23\nsub-059\tequalIndifference\tM\t24\nsub-061\tequalIndifference\tF\t32\nsub-063\tequalIndifference\tF\t25\nsub-067\tequalIndifference\tF\t24\nsub-069\tequalIndifference\tF\t23\nsub-071\tequalIndifference\tF\t21\nsub-073\tequalIndifference\tM\t23\nsub-075\tequalIndifference\tF\t23\nsub-077\tequalIndifference\tM\t22\nsub-079\tequalIndifference\tF\t28\nsub-081\tequalIndifference\tF\t33\nsub-083\tequalIndifference\tM\t26\nsub-085\tequalIndifference\tM\t26\nsub-087\tequalIndifference\tF\t22\nsub-089\tequalIndifference\tM\t26\nsub-093\tequalIndifference\tF\t30\nsub-095\tequalIndifference\tM\t26\nsub-099\tequalIndifference\tM\t27\nsub-103\tequalIndifference\tF\t26\nsub-105\tequalIndifference\tF\t26\nsub-107\tequalIndifference\tM\t25\nsub-109\tequalIndifference\tM\t27\nsub-113\tequalIndifference\tF\t21\nsub-115\tequalIndifference\tM\t25\nsub-117\tequalIndifference\tF\t24\nsub-119\tequalIndifference\tF\t26\nsub-121\tequalIndifference\tF\t25\nsub-123\tequalIndifference\tM\t24\n### input/study-task.md\n# Potential gains and brain activity\n\nDoes increasing potential monetary gain produce a greater fMRI response in the ventromedial prefrontal cortex (vmPFC) in the NARPS equal-indifference group?\n\nTest the hypothesis that this response increases with potential gain.\nParticipants performed a mixed-gambles task, deciding whether to accept gambles with possible gains and losses.\nIn this group, the range of potential gains was twice the range of potential losses.\n\nInvestigate the question at the group-analysis stage using the supplied 54 participant gain-effect maps and metadata.\nPreprocessing and individual modeling are fixed inputs, described in `upstream-methods.md`; do not repeat them or download time-series scans.\nChoose scientifically defensible group models, quality checks, software and visualizations.\nAccount for what the supplied effect estimates measure and the limits of their upstream model.\nUse whole-brain correction for multiple comparisons when evaluating support for the hypothesis, as required by the original study; justify how you identify vmPFC.\n\nProduce a concise scientific report with informative figures and the code and results supporting your conclusions.\nExplain uncertainty, exclusions and limitations, including what a lack of support would mean.\nPrior teams' answers are not ground truth or a required result.\n\nSource: [NARPS original analysis instructions, Hypothesis 1](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf).\n--- assessment-related frozen input files ---\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-22-j01/attempt-01/frozen-inputs/assessment-version.json\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-22-j01/attempt-01/frozen-inputs/coordinator-guidance/judging.md\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-22-j01/attempt-01/frozen-inputs/prompts/neutral-judge-operational.md\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$(dirname \"$STAMPED_ASSESSMENT_VERSION\")/coordinator-guidance/judging.md\"\npython - <<'\"'PY'\nimport json, os\np=os.path.join(os.path.dirname(os.environ['STAMPED_DELIVERY_MANIFEST']),'judge-target.json')\nprint('JUDGE_TARGET',p)\nd=json.load(open(p)); print(json.dumps(d,indent=2)[:12000])\nm=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nprint('MANIFEST_HEAD',m.get('head_commit'))\nprint('MANIFEST_GIT_METADATA',json.dumps(m.get('git_metadata'),indent=2)[:8000])\nprint('MANIFEST_POLICY',json.dumps(m.get('policy'),indent=2))\nprint('MANIFEST_OMISSIONS',json.dumps(m.get('omissions'),indent=2)[:3000])\nprint('MANIFEST_ERRORS',m.get('errors'))\nprint('MANIFEST_GIT_DEPS',json.dumps(m.get('git_dependencies'),indent=2)[:4000])\nPY\ncat \\\"\"'$STAMPED_JUDGE_TARGET/results/summary.json\"\ncat \"$STAMPED_JUDGE_TARGET/results/fwe_clusters.tsv\"\ncat \"$STAMPED_JUDGE_TARGET/results/participant_qc.tsv\"\nls -l \"$STAMPED_JUDGE_TARGET/input/data\" \"$STAMPED_JUDGE_TARGET/atlas_cache\"\nprintf '\"'%s\\\\n' '--- cached atlas README ---'\ncat \\\"\"'$STAMPED_JUDGE_TARGET/atlas_cache/README.md\"\nprintf '\"'%s\\\\n' '--- worker git summary ---'\ngit -C \\\"\"'$STAMPED_JUDGE_TARGET\" rev-parse HEAD\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$(dirname \"$STAMPED_ASSESSMENT_VERSION\")/coordinator-guidance/judging.md\"\npython - <<'\"'PY'\nimport json, os\np=os.path.join(os.path.dirname(os.environ['STAMPED_DELIVERY_MANIFEST']),'judge-target.json')\nprint('JUDGE_TARGET',p)\nd=json.load(open(p)); print(json.dumps(d,indent=2)[:12000])\nm=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nprint('MANIFEST_HEAD',m.get('head_commit'))\nprint('MANIFEST_GIT_METADATA',json.dumps(m.get('git_metadata'),indent=2)[:8000])\nprint('MANIFEST_POLICY',json.dumps(m.get('policy'),indent=2))\nprint('MANIFEST_OMISSIONS',json.dumps(m.get('omissions'),indent=2)[:3000])\nprint('MANIFEST_ERRORS',m.get('errors'))\nprint('MANIFEST_GIT_DEPS',json.dumps(m.get('git_dependencies'),indent=2)[:4000])\nPY\ncat \\\"\"'$STAMPED_JUDGE_TARGET/results/summary.json\"\ncat \"$STAMPED_JUDGE_TARGET/results/fwe_clusters.tsv\"\ncat \"$STAMPED_JUDGE_TARGET/results/participant_qc.tsv\"\nls -l \"$STAMPED_JUDGE_TARGET/input/data\" \"$STAMPED_JUDGE_TARGET/atlas_cache\"\nprintf '\"'%s\\\\n' '--- cached atlas README ---'\ncat \\\"\"'$STAMPED_JUDGE_TARGET/atlas_cache/README.md\"\nprintf '\"'%s\\\\n' '--- worker git summary ---'\ngit -C \\\"\"'$STAMPED_JUDGE_TARGET\" rev-parse HEAD\n'","aggregated_output":"# Scientific assessment context\n\nAssess the original NARPS Hypothesis 1: a positive parametric effect of potential gain in vmPFC for the equal-indifference group.\nThe original [analysis instructions](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf) require whole-brain-corrected inference.\nThe scientific task is in `input/study-task.md`.\n\nWorkers receive 54 participant gain-effect maps from team AO86 and the corresponding cohort metadata.\nPreprocessing and participant modeling are fixed; evaluate group inference conditional on those inputs.\nJudge whether the analysis handles the intended participants, image geometry, quality, gain scaling, uncertainty and anatomical interpretation appropriately.\nThe maps represent independent participants; runs have already been combined within each person.\nEvaluate exclusions, uncertainty and multiple-comparison correction against the actual method.\nDefensible approaches can reach different conclusions; matching a prior team's answer is not the criterion.\nKeep scientific validity separate from the frozen STAMPED assessment.\nCheck how image coverage and missing observations enter the analysis; whether spatial alignment, vmPFC definition, group-model assumptions and whole-brain correction support the claimed inference; and whether quality checks, uncertainty and figures make those decisions inspectable.\nDo not require a particular mask, atlas, model or numerical result.\nParticipant variance maps are absent; judge methods against the supplied data.\nTraceback (most recent call last):\n  File \"<stdin>\", line 4, in <module>\nJUDGE_TARGET /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j01/canonical/judge-target.json\nFileNotFoundError: [Errno 2] No such file or directory: '/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j01/canonical/judge-target.json'\n{\n  \"n_maps\": 54,\n  \"input_sha256_checks_passed\": true,\n  \"n_voxels_whole_brain_mask\": 192339,\n  \"mask_rule\": \"MNI152 standard brain mask intersected with finite voxels nonzero in >=90% (>=49/54) maps\",\n  \"n_permutations\": 5000,\n  \"seed\": 20261016,\n  \"test\": \"one-sided positive one-sample t with random sign flips and whole-brain maximum-T FWER\",\n  \"fwe_alpha\": 0.05,\n  \"max_t_critical_95\": 5.392971720527866,\n  \"whole_brain_sig_voxels\": 23,\n  \"max_t_observed\": 6.617173246302241,\n  \"minimum_p_fwe\": 0.0009998000399920016,\n  \"group_mean_effect_range\": [\n    -0.2044838157943795,\n    0.3049117018365198\n  ],\n  \"group_mean_effect_peak_mni\": [\n    -26.0,\n    -102.0,\n    -3.599997043609619\n  ],\n  \"vmPFC_proxy_atlas\": \"AAL3v2 bilateral Frontal_Med_Orb\",\n  \"vmPFC_label_ids\": [\n    21,\n    22\n  ],\n  \"vmPFC_proxy_voxels\": 1299,\n  \"vmPFC_proxy_mean_effect\": -0.007950366338994166,\n  \"vmPFC_proxy_sd_between_participants\": 0.09743626246213145,\n  \"vmPFC_proxy_mean_effect_95CI_t_descriptive\": [\n    -0.03454534648509121,\n    0.01864461380710288\n  ],\n  \"vmPFC_proxy_mean_t_descriptive\": -0.5996024572361922,\n  \"vmPFC_proxy_p_positive_t_descriptive\": 0.7243369630493834,\n  \"vmPFC_proxy_min_whole_brain_adjusted_p\": 1.0,\n  \"vmPFC_proxy_significant_voxels_fwe05\": 0,\n  \"participant_mean_effect_mean\": -0.00708580669015646,\n  \"participant_mean_effect_sd\": 0.052998702973127365,\n  \"exclusions\": []\n}\ncluster\tvoxels_input_grid\tpeak_t\tpeak_mni_x\tpeak_mni_y\tpeak_mni_z\n1\t16\t6.617173246302241\t-26.0\t-102.0\t-3.599997043609619\n2\t2\t5.760898732461179\t26.0\t-98.0\t-1.1999969482421875\n3\t5\t6.193402982181889\t30.0\t-94.0\t-8.399997234344482\nparticipant\tmean_in_mask\tsd_in_mask\tmean_in_vmPFC_proxy\tfraction_finite\tfraction_nonzero\nsub-001\t-0.045657627\t0.15179056\t-0.09316633111705235\t1.0\t0.2495044573932965\nsub-003\t-0.079377584\t0.17811924\t0.04299582584493295\t1.0\t0.24497899961817488\nsub-005\t0.062092837\t0.18760751\t0.004279070618804641\t1.0\t0.25719519011017594\nsub-009\t0.0040607597\t0.15382732\t0.09330514319552148\t1.0\t0.24132233234280148\nsub-011\t0.08487638\t0.23814788\t0.11776492658728778\t1.0\t0.2543176674358506\nsub-013\t-0.03978869\t0.23376077\t-0.055752237290318335\t1.0\t0.24461709580490396\nsub-015\t0.0011088344\t0.17652908\t0.004704092904314048\t1.0\t0.2510339713686494\nsub-017\t0.012226382\t0.16730577\t0.0070571964515455205\t1.0\t0.24915140749594655\nsub-019\t0.025094692\t0.22087263\t-0.0773668902387827\t1.0\t0.2485316333814765\nsub-021\t0.07853235\t0.197000