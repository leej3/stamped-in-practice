 {\n    \".\": 493,\n    \"content\": 493,\n    \"content/external\": 493,\n    \"manifest.json\": 420\n  }\n}\n\n--- ANNEX DB SIDE FILE TYPES ---\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/.git/annex/keysdb/db Regular File -rw-r--r-- 53248\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/.git/annex/keysdb/db-shm Regular File -rw-r--r-- 32768\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/.git/annex/keysdb/db-wal Regular File -rw-r--r-- 0\n","exit_code":0,"status":"completed"}}
