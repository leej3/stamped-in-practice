{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$STAMPED_JUDGE_TARGET/results/summary.json\"; printf '\"'\\\\n--- FWE CLUSTERS ---\\\\n'; cat \\\"\"'$STAMPED_JUDGE_TARGET/results/fwe_clusters.tsv\"; printf '\"'\\\\n--- PARTICIPANT QC DIMENSIONS ---\\\\n'; python3 - <<'PY'\nimport csv,os\np=os.path.join(os.environ['STAMPED_JUDGE_TARGET'],'results','participant_qc.tsv')\nrows=list(csv.DictReader(open(p),delimiter='\\\\t')); print('rows',len(rows),'columns',list(rows[0]) if rows else [])\nif rows:\n for c in rows[0]:\n  if c=='participant': continue\n  vals=[float(r[c]) for r in rows]\n  print(c,'min',min(vals),'max',max(vals))\nPY\"","aggregated_output":"{\n  \"n_maps\": 54,\n  \"input_sha256_checks_passed\": true,\n  \"n_voxels_whole_brain_mask\": 192339,\n  \"mask_rule\": \"MNI152 standard brain mask intersected with finite voxels nonzero in >=90% (>=49/54) maps\",\n  \"n_permutations\": 5000,\n  \"seed\": 20261016,\n  \"test\": \"one-sided positive one-sample t with random sign flips and whole-brain maximum-T FWER\",\n  \"fwe_alpha\": 0.05,\n  \"max_t_critical_95\": 5.392971720527866,\n  \"whole_brain_sig_voxels\": 23,\n  \"max_t_observed\": 6.617173246302241,\n  \"minimum_p_fwe\": 0.0009998000399920016,\n  \"group_mean_effect_range\": [\n    -0.2044838157943795,\n    0.3049117018365198\n  ],\n  \"group_mean_effect_peak_mni\": [\n    -26.0,\n    -102.0,\n    -3.599997043609619\n  ],\n  \"vmPFC_proxy_atlas\": \"AAL3v2 bilateral Frontal_Med_Orb\",\n  \"vmPFC_label_ids\": [\n    21,\n    22\n  ],\n  \"vmPFC_proxy_voxels\": 1299,\n  \"vmPFC_proxy_mean_effect\": -0.007950366338994166,\n  \"vmPFC_proxy_sd_between_participants\": 0.09743626246213145,\n  \"vmPFC_proxy_mean_effect_95CI_t_descriptive\": [\n    -0.03454534648509121,\n    0.01864461380710288\n  ],\n  \"vmPFC_proxy_mean_t_descriptive\": -0.5996024572361922,\n  \"vmPFC_proxy_p_positive_t_descriptive\": 0.7243369630493834,\n  \"vmPFC_proxy_min_whole_brain_adjusted_p\": 1.0,\n  \"vmPFC_proxy_significant_voxels_fwe05\": 0,\n  \"participant_mean_effect_mean\": -0.00708580669015646,\n  \"participant_mean_effect_sd\": 0.052998702973127365,\n  \"exclusions\": []\n}\n\n--- FWE CLUSTERS ---\ncluster\tvoxels_input_grid\tpeak_t\tpeak_mni_x\tpeak_mni_y\tpeak_mni_z\n1\t16\t6.617173246302241\t-26.0\t-102.0\t-3.599997043609619\n2\t2\t5.760898732461179\t26.0\t-98.0\t-1.1999969482421875\n3\t5\t6.193402982181889\t30.0\t-94.0\t-8.399997234344482\n\n--- PARTICIPANT QC DIMENSIONS ---\nrows 54 columns ['participant', 'mean_in_mask', 'sd_in_mask', 'mean_in_vmPFC_proxy', 'fraction_finite', 'fraction_nonzero']\nmean_in_mask min -0.12701517 max 0.102879085\nsd_in_mask min 0.08770106 max 0.2730504\nmean_in_vmPFC_proxy min -0.19601099112425452 max 0.28868522375900574\nfraction_finite min 1.0 max 1.0\nfraction_nonzero min 0.24085418153847857 max 0.25719519011017594\n","exit_code":0,"status":"completed"}}
