{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'find \"$(dirname \"$STAMPED_JUDGE_OUTPUT\")\" -maxdepth 2 -type f -name judge-target.json -print; cat >\"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit.py\" <<'\"'PY'\nimport hashlib, json, os, pathlib, stat\nmanifest = json.load(open(os.environ['STAMPED_OPERATIONAL_MANIFEST']))\nroot = pathlib.Path(os.environ['STAMPED_JUDGE_TARGET'])\nexpected = {}\nfor e in manifest['entries']:\n    p=e['path']\n    if p == 'content/workspace': rel='.'\n    elif p.startswith('content/workspace/'): rel=p[len('content/workspace/'):]\n    else: continue\n    expected[rel]=e\nactual={}\nfor base, dirs, files in os.walk(root, topdown=True, followlinks=False):\n    b=pathlib.Path(base)\n    for name in list(dirs):\n        p=b/name; rel=p.relative_to(root).as_posix()\n        if p.is_symlink():\n            dirs.remove(name)\n            actual[rel]=p\n        else: actual[rel]=p\n    for name in files:\n        p=b/name; actual[p.relative_to(root).as_posix()]=p\nactual['.']=root\nmismatches=[]\nfor rel in sorted(set(expected)|set(actual)):\n    e=expected.get(rel); p=actual.get(rel)\n    if e is None: mismatches.append({'path':rel,'issue':'unexpected'}); continue\n    if p is None: mismatches.append({'path':rel,'issue':'missing'}); continue\n    st=p.lstat(); mode=stat.S_IMODE(st.st_mode)\n    if mode \"'!= e.get('\"'mode'): mismatches.append({'path':rel,'issue':'mode','expected':e.get('mode'),'actual':mode})\n    if p.is_symlink():\n        kind='symlink'; target=os.readlink(p); digest=hashlib.sha256(os.fsencode(target)).hexdigest(); size=len(os.fsencode(target))\n    elif p.is_dir(): kind='directory'; digest=None; size=None\n    elif p.is_file():\n        kind='file'; h=hashlib.sha256()\n        with p.open('rb') as f:\n            for chunk in iter(lambda:f.read(1024*1024),b''): h.update(chunk)\n        digest=h.hexdigest(); size=st.st_size\n    else: kind='other'; digest=None; size=st.st_size\n    if kind \"'!= e.get('\"'kind'): mismatches.append({'path':rel,'issue':'kind','expected':e.get('kind'),'actual':kind})\n    if 'sha256' in e and digest \"'!= e['\"'sha256']: mismatches.append({'path':rel,'issue':'sha256','expected':e['sha256'],'actual':digest})\n    if 'size' in e and size \"'!= e['\"'size']: mismatches.append({'path':rel,'issue':'size','expected':e['size'],'actual':size})\nexempt=[]; integrity=[]\nfor m in mismatches:\n    if m['path'] in ('.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal') and m['issue'] in ('sha256','size'):\n        exempt.append(m)\n    else: integrity.append(m)\nresult={'capture_sha256':hashlib.sha256(open(os.environ['STAMPED_DELIVERY_MANIFEST'],'rb').read()).hexdigest(), 'expected_entries':len(expected),'actual_entries':len(actual),'mismatch_count':len(mismatches),'integrity_invalidating_mismatches':integrity,'operational_metadata_mismatches':exempt}\nout=pathlib.Path(os.environ['STAMPED_JUDGE_OUTPUT'])/'integrity-audit.json'; out.write_text(json.dumps(result,indent=2)+'\\\\n'); print(json.dumps(result,indent=2))\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit.py\" >\"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit.stdout.txt\" 2>\"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit.stderr.txt\"; printf '\"'audit exit=%s\\\\n' \\\"\"'$?\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit.stdout.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit.stderr.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
