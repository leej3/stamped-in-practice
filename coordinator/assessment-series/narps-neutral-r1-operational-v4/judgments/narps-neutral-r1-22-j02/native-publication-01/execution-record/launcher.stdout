{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'bash \"$STAMPED_JUDGE_OUTPUT/logs/final-validation.sh\"; python3 \"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit.py\" >\"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit-final-raw.stdout.txt\" 2>\"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit-final.stderr.txt\"; python3 - <<'\"'PY' >\\\"\"'$STAMPED_JUDGE_OUTPUT/logs/integrity-audit-final-classify.stdout.txt\" 2>\"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit-final-classify.stderr.txt\"\nimport json,os,pathlib,stat\nout=pathlib.Path(os.environ['\"'STAMPED_JUDGE_OUTPUT']); target=pathlib.Path(os.environ['STAMPED_JUDGE_TARGET']); p=out/'integrity-audit.json'; d=json.loads(p.read_text())\nfor m in list(d.get('integrity_invalidating_mismatches',[])):\n rel=m['path']\n if rel in ('.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'):\n  q=target/rel\n  try: regular=stat.S_ISREG(q.lstat().st_mode)\n  except FileNotFoundError: regular=False\n  if regular:\n   d['integrity_invalidating_mismatches'].remove(m); d.setdefault('operational_metadata_mismatches',[]).append(m)\nd['integrity_invalidating_count']=len(d['integrity_invalidating_mismatches']); p.write_text(json.dumps(d,indent=2)+'\\\\n'); print(json.dumps(d,indent=2))\nPY\nprintf '%s\\\\n' 'bash logs/final-validation.sh; python3 logs/integrity-audit.py; classify regular annex keys database files' >\\\"\"'$STAMPED_JUDGE_OUTPUT/logs/final-assessment-checks.command.txt\"\nprintf '\"'%s\\\\n' '--- RESPONSE ---'; cat \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/response-validate-final.stdout.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/response-validate-final.stderr.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/response-validate-final.exit.txt\"\nprintf '\"'%s\\\\n' '--- SCIENTIFIC ---'; cat \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/scientific-validate-final.stdout.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/scientific-validate-final.stderr.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/scientific-validate-final.exit.txt\"\nprintf '\"'%s\\\\n' '--- INTEGRITY ---'; cat \\\"\"'$STAMPED_JUDGE_OUTPUT/logs/integrity-audit-final-classify.stdout.txt\"; cat \"$STAMPED_JUDGE_OUTPUT/logs/integrity-audit-final-classify.stderr.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
