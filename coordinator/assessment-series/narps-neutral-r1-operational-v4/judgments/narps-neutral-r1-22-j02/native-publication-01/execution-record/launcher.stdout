     \"annex_key\": \"MD5E-s1797041--fe43c7de7c84d8f43b58e4aa086b53ba.nii.gz\",\n        \"bytes\": 1797041,\n        \"git_blob\": \"b631000896ccbd898c6815bd7fd3cc37d5c63397\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-115_hypo1_cope.nii.gz\",\n        \"sha256\": \"5046f7c2fa1c5d1be6237d38f631beca13df8a3a8ded11121082838a533a44bf\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1741472--1b6b2c3638000fc53dd7fb8dbb61acf7.nii.gz\",\n        \"bytes\": 1741472,\n        \"git_blob\": \"893b02820b0ab583d89f48cb0d79d3379214db3f\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-117_hypo1_cope.nii.gz\",\n        \"sha256\": \"711159acfa23c45ab82903f658cafe0fa539f39e077e451f6b0728fdb359445f\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1752220--b816d25a8c2c7bff1aa1edad085b28a8.nii.gz\",\n        \"bytes\": 1752220,\n        \"git_blob\": \"a982444d0e8863ef8ae92b6cca5241220a6f2567\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-119_hypo1_cope.nii.gz\",\n        \"sha256\": \"01738a10e34e46c5ea1a4a192b9484595ee352d62375095b76726347455aabd7\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1766758--e3eb3d7581b6d2fe23cad501f55633b1.nii.gz\",\n        \"bytes\": 1766758,\n        \"git_blob\": \"d54f02fb894923015ce51e6396f85790a2d5337c\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-121_hypo1_cope.nii.gz\",\n        \"sha256\": \"94357665b89cfa1b9157e71aab10f78b49585a790a4a01d9e4693698e185d892\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"annex_key\": \"MD5E-s1745649--b676063de1663e99a46507e0ceb79fad.nii.gz\",\n        \"bytes\": 1745649,\n        \"git_blob\": \"8595d8b8005c7e26b27b3005c58c8e7d96659ec5\",\n        \"mode\": \"120000\",\n        \"path\": \"input/data/sub-123_hypo1_cope.nii.gz\",\n        \"sha256\": \"1219377e08c306753c1e382d431b1e7a55c7143cdc5f800fb65e92fa7e72f888\",\n        \"source_mode\": \"120000\"\n      },\n      {\n        \"bytes\": 1706,\n        \"git_blob\": \"ffec3809a59a904eb1110bf8823d494112a0413e\",\n        \"mode\": \"100644\",\n        \"path\": \"input/participants.tsv\",\n        \"sha256\": \"faca815bcb042144bdb8dcff915f45de0d27650f60416ed76a5a72557341abbf\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 19843,\n        \"git_blob\": \"1d3637a98c93a1bdd00da5f988eda0c7fae3d5d7\",\n        \"mode\": \"100644\",\n        \"path\": \"input/sources.json\",\n        \"sha256\": \"919be9b4278c31f7e39ae3d02fcf159eb4ae222a2fb96c90df7c3a92e5fb19cd\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 1483,\n        \"git_blob\": \"8dd89ecab97a46f4862d68bb9ca6fd455fd171ca\",\n        \"mode\": \"100644\",\n        \"path\": \"input/study-task.md\",\n        \"sha256\": \"e92bf2e0c0db4cc49688cce9f9dfff8a236fc4ec151c09961719f49f31310cc8\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 1342,\n        \"git_blob\": \"08d82cf379f81ada98a79bf2e6d837ce08af0bb3\",\n        \"mode\": \"100644\",\n        \"path\": \"input/upstream-methods.md\",\n        \"sha256\": \"508d832c8787ed8303c3de101c2c76f40a3aa5dec53e6993dc2a49c4b7bcf90b\",\n        \"source_mode\": \"100644\"\n      },\n      {\n        \"bytes\": 2362,\n        \"mode\": \"100644\",\n        \"path\": \".codex/hooks.json\",\n        \"sha256\": \"d0ed5dd1cf5d2d269abfdb6c00161b406d0233b7a4bf1ff72f288405b4959b10\"\n      },\n      {\n        \"bytes\": 310,\n        \"mode\": \"100644\",\n        \"path\": \".entire/settings.local.json\",\n        \"sha256\": \"b8d01a092e151ab8c251ff67b17f16cba06e3550932513174b727816c52ac185\"\n      },\n      {\n        \"bytes\": 58,\n        \"mode\": \"100644\",\n        \"path\": \".entire/.gitignore\",\n        \"sha256\": \"e0d32a3775837a6a1df279f0e6b0e04c02cf3b472781a406aa4586c8ffe02e64\"\n      }\n    ]\n  },\n  \"worker\": {\n    \"pid\": 59608,\n    \"returncode\": 0,\n    \"stop_reason\": \"exited\",\n    \"stopped_at\": \"2026-10-16T06:59:04.511404+00:00\",\n    \"timed_out\": false\n  }\n}\n\n\n### STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR /Users/johnlee/.local/share/wt-utils/worktrees/73e0/stamped-in-practice/scripts/scientific_judgment.py\n\"\"\"Validate an explicit scientific judgment without interpreting its prose.\"\"\"\nimport argparse\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator\n\n\nADEQUACY = (\"supported\", \"qualified\", \"not supported\", \"unable to assess\")\nSHA256 = {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}\nTEXT = {\"type\": \"string\", \"minLength\": 1}\n\n\ndef object_schema(properties):\n    return {\"type\": \"object\", \"properties\": properties,\n            \"required\": list(properties), \"additionalProperties\": False}\n\n\nEXCERPT = object_schema({\n    \"quote\": TEXT,\n    \"start_line\": {\"type\": \"integer\", \"minimum\": 1},\n    \"end_line\": {\"type\": \"integer\", \"minimum\": 1},\n})\nSCHEMA = object_schema({\n    \"schema_version\": {\"const\": 1, \"type\": \"integer\"},\n    \"delivery_capture_sha256\": SHA256,\n    \"scientific_adequacy\": {\"enum\": list(ADEQUACY)},\n    \"report\": object_schema({\"path\": TEXT, \"sha256\": SHA256}),\n    \"adequacy_evidence\": EXCERPT,\n    \"hypothesis_conclusion\": {\"anyOf\": [EXCERPT, {\"type\": \"null\"}]},\n})\nSCHEMA[\"$schema\"] = \"https://json-schema.org/draft/2020-12/schema\"\n\n\ndef digest(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef parse_record(data):\n    def unique_pairs(pairs):\n        result = {}\n        for key, value in pairs:\n            if key in result:\n                raise ValueError(\"Duplicate JSON key: \" + key)\n            result[key] = value\n        return result\n\n    def invalid_constant(value):\n        raise ValueError(\"Nonfinite JSON value: \" + value)\n\n    value = json.loads(data, object_pairs_hook=unique_pairs,\n                       parse_constant=invalid_constant)\n    errors = list(Draft202012Validator(SCHEMA).iter_errors(value))\n    if errors:\n        raise ValueError(\"Invalid scientific judgment: \" + \"; \".join(\n            f\"{'/'.join(map(str, error.absolute_path)) or '(root)'}: {error.message}\"\n            for error in errors))\n    return value\n\n\ndef workspace_file(workspace, relative):\n    path = Path(relative)\n    if path.is_absolute() or \"..\" in path.parts:\n        raise ValueError(\"Judgment artifacts must use paths inside the judge workspace\")\n    current = workspace\n    for part in path.parts:\n        current = current / part\n        if current.is_symlink():\n            raise ValueError(\"Judgment artifacts must not use symlinks\")\n    if not current.is_file():\n        raise ValueError(\"Judgment artifact is not a regular file: \" + str(path))\n    return current\n\n\ndef validate_excerpt(excerpt, report):\n    \"\"\"Bind a literal text quote to one-based physical report lines.\"\"\"\n    lines = report.splitlines()\n    start, end = excerpt[\"start_line\"], excerpt[\"end_line\"]\n    if type(start) is not int or type(end) is not int:\n        raise ValueError(\"Excerpt line numbers must use JSON integer notation\")\n    if not 1 <= start <= end <= len(lines):\n        raise ValueError(\"Excerpt line range is outside the report\")\n    context = \"\\n\".join(lines[start - 1:end])\n    if excerpt[\"quote\"] not in context:\n        raise ValueError(\"Excerpt quote does not occur in its cited report lines\")\n\n\ndef validate_record(record_path, workspace, capture_sha256):\n    \"\"\"Return aggregation fields bound to the record, report and original capture.\n\n    The judge's explicit category is authoritative. Neither the category nor a\n    hypothesis conclusion is inferred from the narrative. Older assessment\n    versions retain their existing extraction procedure.\n    \"\"\"\n    workspace = Path(workspace).resolve(strict=True)\n    path = Path(record_path)\n    if path.is_absolute():\n        try:\n            path = path.relative_to(workspace)\n        except ValueError as error:\n            raise ValueError(\"Scientific record is outside the judge workspace\") from error\n    path = workspace_file(workspace, path)\n    raw = path.read_bytes()\n    record = parse_record(raw)\n    if record[\"delivery_capture_sha256\"] != capture_sha256:\n        raise ValueError(\"Scientific judgment names a different original delivery capture\")\n    report_path = workspace_file(workspace, record[\"report\"][\"path\"])\n    report_raw = report_path.read_bytes()\n    if digest(report_raw) != record[\"report\"][\"sha256\"]:\n        raise ValueError(\"Scientific report hash differs from the explicit judgment\")\n    report = report_raw.decode(\"utf-8\")\n    validate_excerpt(record[\"adequacy_evidence\"], report)\n    conclusion = record[\"hypothesis_conclusion\"]\n    if conclusion is not None:\n        validate_excerpt(conclusion, report)\n    fields = {\n        \"structured_scientific\": {\"path\": str(path), \"sha256\": digest(raw)},\n        \"scientific_report\": {\"path\": str(report_path), \"sha256\": digest(report_raw)},\n        \"adequacy\": {\"extraction_status\": \"explicit\",\n                     \"category\": record[\"scientific_adequacy\"],\n                     \"excerpt\": record[\"adequacy_evidence\"]},\n    }\n    if conclusion is not None:\n        fields[\"conclusion\"] = conclusion\n    return fields\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n    subparsers.add_parser(\"schema\", help=\"Print the exact required record schema\")\n    check = subparsers.add_parser(\"validate\", help=\"Validate a judge-authored record\")\n    check.add_argument(\"record\", type=Path)\n    check.add_argument(\"--workspace\", type=Path, default=Path.cwd())\n    identity = check.add_mutually_exclusive_group(required=True)\n    identity.add_argument(\"--delivery-manifest\", type=Path)\n    identity.add_argument(\"--capture-sha256\")\n    args = parser.parse_args()\n    if args.command == \"schema\":\n        result = SCHEMA\n    else:\n        capture = (digest(args.delivery_manifest.read_bytes()) if args.delivery_manifest\n                   else args.capture_sha256)\n        result = validate_record(args.record, args.workspace, capture)\n    print(json.dumps(result, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/analyze.py\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/atlas_cache/aal_3v2/AAL3/gin_clusters_plabels.m\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/atlas_cache/aal_3v2/AAL3/AAL3v1_1mm.nii\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/atlas_cache/aal_3v2/AAL3/AAL3v1.xml\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/atlas_cache/aal_3v2/AAL3/ROI_MNI_V7_1mm.xml\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-22-j02/operational/content/workspace/atlas_cache/aal_3v2/AAL3/AAL3v1.nii.gz\n/Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operationa