nbase=[os.environ['STAMPED_ASSESSMENT_PYTHON'],os.environ['STAMPED_ASSESSMENT_RUNNER'],'response','set',os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'response.json')]\nsubprocess.run(base+['--item','should/006','--status','unmet','--reason','No supplied environment specification exists to reconstitute and test.','--source','probe:ci-present+judgement','--evidence','probes.json=CI probe leaves this not-checked pending equivalent evidence','--evidence','REPORT.md=No environment specification or repeat reconstitution record is described','--flag','probe-overridden'],check=True)\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response table response.json > item-table.md\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport os,json,hashlib\nout=Path(os.environ['STAMPED_JUDGE_OUTPUT']); p=out/'assessment-report.md'; txt=p.read_text(); table=(out/'item-table.md').read_text()\nstart=txt.index('| item | principles | status | source | evidence | reason |'); end=txt.index('\\\\n\\\\n## Flagged items',start)\ntxt=txt[:start]+table.rstrip()+txt[end:]; p.write_text(txt)\nlines=txt.splitlines(); j=json.load(open(out/'scientific-judgment.json')); j['report']['sha256']=hashlib.sha256(txt.encode()).hexdigest()\nfor field in ['adequacy_evidence','hypothesis_conclusion']:\n q=j[field]['quote']; n=next(i for i,x in enumerate(lines,1) if x==q); j[field]['start_line']=j[field]['end_line']=n\n(out/'scientific-judgment.json').write_text(json.dumps(j,indent=2)+'\\\\n')\nPY\n\"","aggregated_output":"✔ The default environment has been installed.\nstamped-checklist:should/006 = unmet\n✔ The default environment has been installed.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY'\nimport json,os\nfrom pathlib import Path\np=Path(os.environ['STAMPED_JUDGE_OUTPUT'])/'replay-record.json'; j=json.load(open(p))\nj['frozen_execution_limit_seconds']=7200\nj['frozen_maximum_attempts']=1\nj['helper_prefetch_limit_gb']=5.0\nj['adapter_input_retrieval']='none; captured inputs only'\nj['planned_comparison_rule']='Compare generated statistical map arrays and numeric summary/CSV values with rtol=1e-6 and atol=1e-7 (float32 output precision near zero); check map labels, dimensions and affine exactly. Treat timestamps, logs, prose and figure rendering/formatting as non-scientific differences. No comparison was performed.'\np.write_text(json.dumps(j,indent=2)+'\\\\n')\nPY\npython3 - <<'PY'\nimport json,os,subprocess\nfrom pathlib import Path\nout=Path(os.environ['STAMPED_JUDGE_OUTPUT']); py=os.environ['STAMPED_ASSESSMENT_PYTHON']; runner=os.environ['STAMPED_ASSESSMENT_RUNNER']\ncommands=[\n ('response-validation-final',[py,runner,'validate','response.json']),\n ('scientific-validation-final',[py,os.environ['STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR'],'validate','scientific-judgment.json','--workspace',str(out),'--delivery-manifest',os.environ['STAMPED_DELIVERY_MANIFEST']]),\n]\nrecords=json.load(open(out/'assessment-commands.json'))['commands']\nfor name,cmd in commands:\n p=subprocess.run(cmd,cwd=out,capture_output=True,text=True)\n (out/f'{name}.stdout.txt').write_text(p.stdout); (out/f'{name}.stderr.txt').write_text(p.stderr)\n records.append({'name':name,'argv':cmd,'cwd':str(out),'returncode':p.returncode,'stdout':f'{name}.stdout.txt','stderr':f'{name}.stderr.txt','generated_artifact':None})\n if p.returncode: raise SystemExit(f'{name} failed')\n(out/'assessment-commands.json').write_text(json.dumps({'schema_version':1,'commands':records,'replay_command_attempts':0,'notes':'The frozen runner check, probes and final validations are retained with separate stdout/stderr. The scientific replay was not attempted because worker-supplied prerequisites were insufficient.'},indent=2)+'\\\\n')\nprint('final validations passed')\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
