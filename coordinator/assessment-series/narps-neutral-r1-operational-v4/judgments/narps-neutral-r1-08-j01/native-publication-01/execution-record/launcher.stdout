{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY'\nimport subprocess,os\nbase=[os.environ['STAMPED_ASSESSMENT_PYTHON'],os.environ['STAMPED_ASSESSMENT_RUNNER'],'response','set',os.path.join(os.environ['STAMPED_JUDGE_OUTPUT'],'response.json')]\nreceipt=os.environ['STAMPED_WORKER_STOP_RECEIPT']\nitems=[\n('must/005','unmet','The annex-managed input maps were supplied; the worker’s own analysis and results were not tracked.','probe:large-in-annex+judgement','input/data/sub-001_hypo1_cope.nii.gz=One of 54 supplied annex pointers; coordinator-provided state',True),\n('must/006','unmet','No run record links the generated results to an exact software environment.','probe:derived-have-records+judgement','results/summary.json=Records analysis settings but not package versions or environment identity',True),\n('must/008','met','The complete delivery names analysis.py as the group workflow starting point.','probe:entry-point+judgement','REPORT.md=Names analysis.py and gives workspace-root execution guidance',True),\n('must/009','met','The delivered workflow derives its root from its location and uses relative paths.','probe:no-abs-paths+judgement','analysis.py=ROOT is Path(__file__).resolve().parent; all data/output paths derive from ROOT',False),\n]\nfor item,status,reason,source,evidence,override in items:\n a=base+['--item',item,'--status',status,'--reason',reason,'--source',source,'--evidence',evidence,'--evidence',receipt+'=Worker-stop receipt identifies the initial supplied-file set and complete stop inventory']\n if override: a += ['--flag','probe-overridden']\n subprocess.run(a,check=True,stdout=subprocess.DEVNULL)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
