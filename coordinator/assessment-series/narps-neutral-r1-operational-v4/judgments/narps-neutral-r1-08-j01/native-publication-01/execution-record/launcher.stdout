{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/opt/homebrew/bin/bash -lc '\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response table response.json > item-table.md; python3 - <<'\"'PY'\nfrom pathlib import Path\nimport os,json,hashlib\nout=Path(os.environ['STAMPED_JUDGE_OUTPUT']); p=out/'assessment-report.md'; txt=p.read_text()\ntxt=txt.replace('MUST: 5 met / 0 partial / 12 unmet / 0 not-checked (17 total).','MUST: 4 met / 0 partial / 13 unmet / 0 not-checked (17 total).')\ntxt=txt.replace('All 54 participant maps and metadata are present; the maps are annex-managed within the captured root. This was part of the supplied initial state, not evidence that the worker created the data-versioning setup','All 54 participant maps and metadata are present; the maps are annex-managed within the captured root. This was supplied initial state, not worker data-versioning credit')\ntxt=txt.replace('''- No probe disagreement was overridden. Probe results are retained in probes.json; artifact and worker-stop judgments are recorded separately in response.json.''','''- must/005, must/006 and must/008 override probes that saw only tracked paths: the complete worker-stop delivery contains supplied annex data and untracked analysis artifacts. The annex state was coordinator-supplied, while analysis.py and its products exist but are not tracked. Probe output and reasons are retained in probes.json and response.json.''')\n# Replace the table with the current validated response table.\nstart=txt.index('| item | principles | status | source | evidence | reason |')\nend=txt.index('\\\\n\\\\n## Flagged items',start)\ntxt=txt[:start]+(out/'item-table.md').read_text().rstrip()+txt[end:]\np.write_text(txt)\nlines=txt.splitlines()\nscient=json.load(open(out/'scientific-judgment.json'))\nscient['report']['sha256']=hashlib.sha256(txt.encode()).hexdigest()\nfor field in ['adequacy_evidence','hypothesis_conclusion']:\n q=scient[field]['quote']; n=next(i for i,line in enumerate(lines,1) if line==q); scient[field]['start_line']=n; scient[field]['end_line']=n\n(out/'scientific-judgment.json').write_text(json.dumps(scient,indent=2)+'\\\\n')\nprint('counts revised; report lines',len(lines),'citation lines',scient['adequacy_evidence']['start_line'],scient['hypothesis_conclusion']['start_line'])\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
