a256\": \"982f6aa64656d893c8a2fff91daee1cee503c1e58b34af505e44e323b5427876\",\n        \"resolver_sha256\": \"7b99c2dbe34bd90cbd5cf2ac54525e7fbf855f081b0c451733755cbfefc55960\",\n        \"trust_sync_sha256\": \"04d802a48c5638be4a6b397c97cd77d6885e9432ac3387a199fece3a3366f7fe\"\n      },\n      \"thread_environment\": {\n        \"MKL_NUM_THREADS\": \"1\",\n        \"NUMEXPR_NUM_THREADS\": \"1\",\n        \"OMP_NUM_THREADS\": \"1\",\n        \"OPENBLAS_NUM_THREADS\": \"1\"\n      }\n    }\n  },\n  \"settings\": {\n    \"judge\": {\n      \"capture_execution\": true,\n      \"effort\": \"high\",\n      \"model\": \"gpt-6-luna\",\n      \"review_seconds\": 5400,\n      \"seconds\": 0\n    },\n    \"research\": {\n      \"capture_execution\": true,\n      \"effort\": \"high\",\n      \"model\": \"gpt-6-luna\",\n      \"review_seconds\": 5400,\n      \"seconds\": 0\n    }\n  },\n  \"starting_environment\": {\n    \"commit\": \"719a729d565a7886d906d227a8f1936020a75a9b\",\n    \"repository\": \"origin\",\n    \"sha256\": {\n      \"pixi.lock\": \"f8fff1394fbeaa2ab1c4993fceb0dd6463fe0c08c81fcda397f3e752a72c4249\",\n      \"pixi.toml\": \"c3d25ec5d2893105ac23ed186c22f1b515848ef79517a474d1ab10b17945f350\"\n    }\n  },\n  \"status\": \"sealed\",\n  \"study\": {\n    \"commit\": \"221074f0ab291f0d2a0d919a2dd02e52a584f6b1\",\n    \"guidance_dependencies\": [],\n    \"guidance_files\": {\n      \"coordinator-guidance/judging.md\": \"bef28d7fd1fdf75275f9902123881cc28bb97b401354d1aa8c323d5683dad559\"\n    },\n    \"guidance_objects\": {\n      \"coordinator-guidance/judging.md\": {\n        \"git_blob\": \"3612920b88f22717d8132fb47a0bfb035d0789a8\",\n        \"mode\": \"100644\",\n        \"sha256\": \"bef28d7fd1fdf75275f9902123881cc28bb97b401354d1aa8c323d5683dad559\",\n        \"size\": 1527\n      }\n    },\n    \"input_tree\": \"a484f41db2095ef116f08d359f9b95ad41981698\",\n    \"path\": \"studies/narps\",\n    \"reference\": null,\n    \"rubric\": \"coordinator-guidance/judging.md\",\n    \"task_sha256\": \"e92bf2e0c0db4cc49688cce9f9dfff8a236fc4ec151c09961719f49f31310cc8\"\n  },\n  \"version\": 4\n}\n\n STAMPED_DELIVERY_MANIFEST path= /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-08-j01/canonical/manifest.json\n{}\n\n STAMPED_OPERATIONAL_MANIFEST path= /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/targets/narps-neutral-r1-08-j01/operational/manifest.json\n{}\n\n STAMPED_WORKER_STOP_RECEIPT path= /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-08-j01/attempt-01/worker-end-state.json\n{\n  \"schema_version\": 2,\n  \"worker\": {\n    \"pid\": 17817,\n    \"returncode\": 0,\n    \"stop_reason\": \"exited\",\n    \"stopped_at\": \"2026-10-16T06:30:33.211283+00:00\",\n    \"timed_out\": false\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$STAMPED_JUDGE_TARGET/REPORT.md\"; cat \"$STAMPED_JUDGE_TARGET/input/upstream-methods.md\"; cat \"$STAMPED_JUDGE_TARGET/analysis.py\"; cat /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-08-j01/attempt-01/frozen-inputs/coordinator-guidance/judging.md; \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" probes --help; \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response --help; \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" fresh-rerun --help; python3 - <<'\"'PY'\nimport json,os\nfor k in ['STAMPED_DELIVERY_MANIFEST','STAMPED_OPERATIONAL_MANIFEST']:\n j=json.load(open(os.environ[k])); print(k, {a:j.get(a) for a in ('delivery_capture_sha256','capture_sha256','head','reference_limits','target')})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/bash -lc 'cat \"$STAMPED_JUDGE_TARGET/REPORT.md\"; cat \"$STAMPED_JUDGE_TARGET/input/upstream-methods.md\"; cat \"$STAMPED_JUDGE_TARGET/analysis.py\"; cat /Users/johnlee/.local/state/stamped-in-practice/narps-neutral-v1/assessment-series/narps-neutral-r1-operational-v4/judgments/narps-neutral-r1-08-j01/attempt-01/frozen-inputs/coordinator-guidance/judging.md; \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" probes --help; \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" response --help; \"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" fresh-rerun --help; python3 - <<'\"'PY'\nimport json,os\nfor k in ['STAMPED_DELIVERY_MANIFEST','STAMPED_OPERATIONAL_MANIFEST']:\n j=json.load(open(os.environ[k])); print(k, {a:j.get(a) for a in ('delivery_capture_sha256','capture_sha256','head','reference_limits','target')})\nPY\"","aggregated_output":"# Potential gain and brain activity in the NARPS equal-indifference group\n\n## Question and result\n\nWe tested whether the participant-level gain effect was positive in the equal-indifference group (54 participants). The whole-brain one-sided test found 23 voxels significant by family-wise-error (FWE) corrected max-T permutation inference (peak *t*(53) = 6.62, MNI [−26, −102, −3.6], FWE *p* = .00090). This peak is far posterior and outside vmPFC. In the prespecified vmPFC proxy, the average effect was −0.0057 (95% *t* interval [−0.0323, 0.0210]); the directional one-sample test gave *t*(53) = −0.43, *p* = .664. No voxel in the proxy survived whole-brain FWE correction; the proxy's largest positive *t* was 2.12 (whole-brain FWE *p* = 1.00). Thus, these maps do not support the predicted positive vmPFC response, despite evidence for positive effects elsewhere in the brain.\n\n![Mean participant gain-effect estimates](figures/group_mean_effect.png)\n\n![Whole-brain family-wise corrected positive voxels at the peak location](figures/whole_brain_fwe.png)\n\n![Participant-level vmPFC proxy estimates and 95% interval for the mean](figures/vmPFC_participants.png)\n\n## Methods\n\nAll 54 supplied unthresholded AO86 participant contrast estimates were included; no participants were excluded. We verified map count, participant IDs, dimensions, affine, and finite values. The input grid is MNI152NLin2009cAsym, 97 × 115 × 81, with 2 × 2 × 2.4 mm voxels. The analysis mask was the standard MNI152 2-mm brain mask resampled to that grid, restricted to voxels nonzero in at least 95% of participants (190,657 voxels). The supplied maps had 97.4–99.8% nonzero coverage within the standard brain mask.\n\nAt each voxel, we fit an equal-weight one-sample group model to the 54 participant effects and used the positive direction specified by the hypothesis. Whole-brain FWE was controlled with the permutation distribution of the maximum positive *t* statistic across the analysis mask from 10,000 random participant-level sign flips (seed 8601; plus-one *p* estimate). This provides a whole-brain correction while preserving the spatial dependence among voxels. Its validity assumes participant effects are exchangeable and approximately symmetric under the null. This is a random-effects style group test based on between-participant dispersion; participant-specific first-level variance maps were unavailable, so precision-weighted mixed-effects inference was not possible.\n\nBecause vmPFC is not a single sharply bounded anatomical label, we defined an explicit, independent anatomical proxy as a 12-mm-radius sphere centered at MNI [0, 40, −12], a conventional medial valuation-region coordinate near vmPFC peaks in coordinate-based valuation meta-analysis ([Bartra et al., 2013](https://pmc.ncbi.nlm.nih.gov/articles/PMC3756836/)). The sphere was intersected with the whole-brain analysis mask (762 voxels). The region-average effect and its *t*-based 95% confidence interval summarize the group estimate. The ROI is descriptive; the confirmatory decision is based on whole-brain corrected inference, as in the original NARPS instructions. The original instructions specify the positive vmPFC gain hypothesis and whole-brain corrected evaluation ([NARPS analysis instructions, Hypothesis 1](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf)).\n\n## Interpretation and limitations\n\nThe maps are participant contrast parameter estimates, not standardized *t* or *z* statistics. Per the fixed upstream model, the gain modulator was mean-centered and variance-normalized before HRF convolution; therefore the coefficient is not an effect per monetary unit. It estimates the modeled gain-related response conditional on the upstream choices, including response-time event durations and a separate gain model rather than a joint gain-and-loss model. The group's potential-gain range was twice its potential-loss range. We did not rerun preprocessing or participant models.\n\nThe null vmPFC result means this group-level test did not provide evidence for a positive vmPFC gain effect at the chosen inferential resolution. The interval still includes modest positive and negative mean effects; this is not evidence that the true effect is exactly zero or that vmPFC is insensitive to gain. The anatomical proxy is an operational choice and other vmPFC definitions could yield different estimates. The whole-brain corrected posterior finding does not establish a vmPFC effect and should not be substituted for the hypothesized location. Finally, unmodeled first-level uncertainty, upstream model misspecification, and the modest sample size limit sensitivity and interpretation; these observational task coefficients do not establish that monetary gains causally produce neural activity.\n\n## Reproducibility files\n\n- `analysis.py`: complete group workflow; run with the supplied Python environment from the workspace root.\n- `results/summary.json`: analysis settings and main numerical results.\n- `results/participant_qc_and_roi.csv`: per-participant brain-mask and ROI summaries.\n- `results/group_mean_effect.nii.gz`, `results/t_statistic.nii.gz`, `results/p_uncorrected_one_sided.nii.gz`, `results/p_fwe_maxT.nii.gz`: unthresholded group statistical maps; voxels outside the analysis mask are NaN.\n- `figures/`: generated figures.\n\nThe original instructions PDF was intermittently unavailable to direct retrieval during this run; the linked source and the supplied task brief both identify whole-brain correction as the required standard.\n# Fixed upstream analysis\n\nEach map is one participant's unthresholded gain-effect estimate from NARPS team AO86, averaged across four runs.\nThe 54 participants comprise the complete equal-indifference group in OpenNeuro ds001734 version 1.0.4.\nThese are effect estimates, not standardized test statistics or group results.\nMaps are reported in MNI152NLin2009cAsym space.\n\nAO86 used fMRIPrep outputs and nistats participant models.\nTheir reported gain regressor was mean-centered and variance-normalized before HRF convolution; its coefficients must not be interpreted as change per currency unit.\nResponse trials used response-time durations, with separate response-choice and gain modulators.\nNonresponse trials, motion terms, flagged volumes and drift terms were also modeled; runs were combined within participant.\nGain and loss used separate models, so the supplied gain effect is conditional on that modeling choice.\n\nThe reported upstream choices are fixed for this task.\nParticipant variance maps and a complete executable upstream pipeline are not supplied; account for these limits when choosing and interpreting group inference.\n`participants.tsv` retains the source group, age and gender columns.\n`sources.json` identifies each original image, its retrieved-byte checksum, the pinned cohort table and the original methods report.\n#!/usr/bin/env python3\n\"\"\"Group analysis of NARPS AO86 participant gain-effect maps.\n\nRun from the project root with the supplied Python environment.  The input\nmaps are participant-level effect estimates, not t/z maps.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport numpy as np\nimport pandas as pd\nimport nibabel as nib\nfrom nilearn import datasets, image, plotting\nfrom scipy import stats\nimport matplotlib.pyplot as plt\n\nROOT = Path(__file__).resolve().parent\nIN = ROOT / \"input\"\nOUT = ROOT / \"results\"\nFIG = ROOT / \"figures\"\nOUT.mkdir(exist_ok=True)\nFIG.mkdir(exist_ok=True)\nSEED = 8601\nN_PERM = 10000\n\nparticipants = pd.read_csv(IN / \"participants.tsv\", sep=\"\\t\")\npaths = [IN / \"data\" / f\"{pid}_hypo1_cope.nii.gz\" for pid in participants.participant_id]\nassert len(participants) == 54 and all(p.exists() for p in paths)\nimgs = [nib.load(str(p)) for p in paths]\nref = imgs[0]\nassert all(img.shape == ref.shape and np.allclose(img.affine, ref.affine) for img in imgs)\narr = np.stack([img.get_fdata(dtype=np.float32) for img in imgs])\nassert np.isfinite(arr).all()\n\n# Use a standard MNI152 brain mask resampled to the supplied MNI152NLin2009cAsym\n# grid, intersected with voxels represented in at least 95% of participant maps.\ntemplate_mask = datasets.load_mni152_brain_mask(resolution=2)\nbrain = image.resample_to_img(template_mask, ref, interpolation=\"nearest\").get_fdata() > 0\ncoverage = np.mean(arr != 0, axis=0)\nmask = brain & (coverage >= 0.95)\nassert mask.sum() > 10000\nX = arr[:, mask].astype(np.float64)\nn, v = X.shape\n\n# One-sample group model, equal participant weights. Direction was prespecified\n# as positive; sign-flip max-T controls family-wise error over all tested voxels.\nmean = X.mean(axis=0)\nsd = X.std(axis=0, ddof=1)\nt_obs = mean / (sd / np.sqrt(n))\ndf = n - 1\np_unc = stats.t.sf(t_obs, df)\n\nrng = np.random.default_rng(SEED)\nmax_null = np.empty(N_PERM, dtype=np.float64)\nbatch = 20\nfor start in range(0, N_PERM, batch):\n    b = min(batch, N_PERM - start)\n    signs = rng.choice(np.array([-1.0, 1.0]), size=(b, n))\n    sums = signs @ X\n    means = sums / n\n    # Under sign flips, the sample SD is calculated from signed observations.\n    sq = np.sum(X * X, axis=0)[None, :]\n    variances = np.maximum((sq - n * means * means) / (n - 1), 1e-20)\n    t_perm = means / np.sqrt(variances / n)\n    max_null[start:start+b] = np.max(t_perm, axis=1)\n\np_fwe = (1 + N_PERM - np.searchsorted(np.sort(max_null), t_obs, side=\"left\")) / (N_PERM + 1)\n\n# Operational anatomical vmPFC proxy: 12 mm sphere centered at MNI [0, 40, -12].\n# This is a descriptive prespecified ROI estimate; whole-brain max-T is the\n# confirmatory decision rule.\nijk = np.indices(ref.shape).reshape(3, -1).T\nxyz = nib.affines.apply_affine(ref.affine, ijk)\nroi_volume = ((xyz[:, 0]**2 + (xyz[:, 1]-40)**2 + (xyz[:, 2]+12)**2) <= 12**2).reshape(ref.shape)\nroi = roi_volume & mask\nroi_data = arr[:, roi]\nroi_subj = roi_data.mean(axis=1)\nroi_mean = float(roi_subj.mean())\nroi_sd = float(roi_subj.std(ddof=1))\nroi_se = roi_sd / np.sqrt(n)\nroi_ci = stats.t.interval(0.95, df, loc=roi_mean, scale=roi_se)\nroi_t = roi_mean / roi_se\nroi_p = float(stats.t.sf(roi_t, df))\nroi_mask_flat = roi[mask]\nroi_peak_local = int(np.argmax(t_obs[roi_mask_flat]))\nroi_voxel_indices = np.flatnonzero(roi_mask_flat)\nroi_peak_index = int(roi_voxel_indices[roi_peak_local])\nroi_peak_xyz = nib.affines.apply_affine(ref.affine, np.argwhere(mask)[roi_peak_index])\n\n# Subject-level summary and map QC.\nsubj = pd.DataFrame({\n    \"participant_id\": participants.participant_id,\n    \"mean_effect_in_brain_mask\": arr[:, mask].mean(axis=1),\n    \"mean_effect_in_vmPFC_sphere\": roi_subj,\n    \"nonzero_brain_fraction\": (arr[:, brain] != 0).mean(axis=1),\n})\nsubj.to_csv(OUT / \"participant_qc_and_roi.csv\", index=False)\nqc = {\n    \"n_participants\": n, \"n_excluded\": 0, \"n_voxels_tested\": int(v),\n    \"n_brain_template_voxels\": int(brain.sum()),\n    \"n_common_coverage_voxels\": int(mask.sum()),\n    \"map_shape\": list(ref.shape), \"voxel_sizes_mm\": list(map(float, ref.header.get_zooms()[:3])),\n    \"map_value_min\": float(arr.min()), \"map_value_max\": float(arr.max()),\n    \"map_value_mean\": float(arr.mean()),\n    \"nonzero_brain_fraction_min\": float(subj.nonzero_brain_fraction.min()),\n    \"nonzero_brain_fraction_max\": float(subj.nonzero_brain_fraction.max()),\n    \"permutation_draws\": N_PERM, \"random_seed\": SEED,\n    \"test\": \"one-sided positive one-sample t; sign-flip max-T FWE across brain mask\",\n    \"mask_rule\": \"MNI152 2mm brain mask resampled to input; nonzero in >=95% participants\",\n    \"roi_rule\": \"12-mm sphere centered MNI [0, 40, -12], intersected with tested mask\",\n}\n\n# Peak and corrected extent.\nidx_sig = np.flatnonzero(p_fwe < .05)\npeak = int(np.argmax(t_obs))\npeak_ijk = np.argwhere(mask)[peak]\npeak_xyz = nib.affines.apply_affine(ref.affine, peak_ijk)\npeak_result = {\n    \"peak_t\": float(t_obs[peak]), \"peak_p_uncorrected_one_sided\": float(p_unc[peak]),\n    \"peak_p_fwe\": float(p_fwe[peak]), \"peak_mni_mm\": [float(x) for x in peak_xyz],\n    \"positive_voxels_p_fwe_lt_0_05\": int(len(idx_sig)),\n    \"roi_voxels\": int(roi.sum()), \"roi_mean_effect\": roi_mean,\n    \"roi_sd_across_participants\": roi_sd, \"roi_ci95\": [float(roi_ci[0]), float(roi_ci[1])],\n    \"roi_t\": float(roi_t), \"roi_df\": int(df), \"roi_p_uncorrected_one_sided\": roi_p,\n    \"roi_peak_t\": float(t_obs[roi_peak_index]),\n    \"roi_peak_p_fwe_whole_brain\": float(p_fwe[roi_peak_index]),\n    \"roi_peak_mni_mm\": [float(x) for x in roi_peak_xyz],\n    \"roi_voxels_p_fwe_lt_0_05\": int(np.sum(p_fwe[roi_mask_flat] < .05)),\n}\nwith open(OUT / \"summary.json\", \"w\") as f:\n    json.dump({\"qc\": qc, \"results\": peak_result}, f, indent=2)\n\n# Save statistical maps.\ndef full_map(vals, fill=np.nan):\n    out = np.full(ref.shape, fill, dtype=np.float32)\n    out[mask] = vals.astype(np.float32)\n    return nib.Nifti1Image(out, ref.affine, ref.header)\n\nfor name, vals in [(\"group_mean_effect\", mean), (\"t_statistic\", t_obs),\n                   (\"p_uncorrected_one_sided\", p_unc), (\"p_fwe_maxT\", p_fwe)]:\n    nib.save(full_map(vals), OUT / f\"{name}.nii.gz\")\n\n# Figure 1: unthresholded group mean effect and whole-brain corrected findings.\nmean_img = full_map(mean)\nvlim = float(np.nanpercentile(np.abs(mean), 98))\ndisplay = plotting.plot_stat_map(full_map(mean, fill=0), display_mode=\"z\", cut_coords=[-12, -6, 0, 6],\n                       threshold=None, cmap=\"cold_hot\", colorbar=True,\n                       title=\"Mean participant gain-effect estimate\", vmax=vlim)\ndisplay.savefig(FIG / \"group_mean_effect.png\", dpi=180)\ndisplay.close()\nsig_t = np.where(p_fwe < .05, t_obs, np.nan)\ndisplay = plotting.plot_stat_map(full_map(sig_t, fill=0),\n                       display_mode=\"ortho\", cut_coords=tuple(peak_xyz),\n                       threshold=0, cmap=\"hot\", colorbar=True,\n                       title=\"Positive voxels: whole-brain max-T FWE p < .05\")\ndisplay.savefig(FIG / \"whole_brain_fwe.png\", dpi=180)\ndisplay.close()\n\n# Figure 2: participant-level ROI effects with group mean/CI.\nfig, ax = plt.subplots(figsize=(7, 4.5))\nax.scatter(np.arange(n), roi_subj, color=\"#315a7d\", s=24, alpha=.8)\nax.axhline(0, color=\"0.4\", linewidth=1)\nax.axhline(roi_mean, color=\"#bd4b36\", linewidth=2, label=f\"Mean = {roi_mean:.4g}\")\nax.fill_between([-1, n], roi_ci[0], roi_ci[1], color=\"#bd4b36\", alpha=.14,\n                label=\"95% t interval for mean\")\nax.set(xlim=(-1, n), xlabel=\"Participant (listed in participant_qc_and_roi.csv order)\",\n       ylabel=\"Mean effect estimate in vmPFC sphere\",\n       title=\"Participant effects in the prespecified vmPFC proxy\")\nax.legend(frameon=False)\nfig.tight_layout()\nfig.savefig(FIG / \"vmPFC_participants.png\", dpi=180)\nplt.close(fig)\n\nprint(json.dumps({\"qc\": qc, \"results\": peak_result}, indent=2))\n# Scientific assessment context\n\nAssess the original NARPS Hypothesis 1: a positive parametric effect of potential gain in vmPFC for the equal-indifference group.\nThe original [analysis instructions](https://www.narps.info/files/narps_instructions_for_analysis_teams.pdf) require whole-brain-corrected inference.\nThe scientific task is in `input/study-task.md`.\n\nWorkers receive 54 participant gain-effect maps from team AO86 and the corresponding cohort metadata.\nPreprocessing and participant modeling are fixed; evaluate group inference conditional on those inputs.\nJudge whether the analysis handles the intended participants, image geometry, quality, gain scaling, uncertainty and anatomical interpretation appropriately.\nThe maps represent independent participants; runs have already been combined within each person.\nEvaluate exclusions, uncertainty and multiple-comparison correction against the actual method.\nDefensible approaches can reach different conclusions; matching a prior team's answer is not the criterion.\nKeep scientific validity separate from the frozen STAMPED assessment.\nCheck how image coverage and missing observations enter the analysis; whether spatial alignment, vmPFC definition, group-model assumptions and whole-brain correction support the claimed inference; and whether quality checks, uncertainty and figures make those decisions inspectable.\nDo not require a particular mask, atlas, model or numerical result.\nParticipant variance maps are absent; judge methods against the supplied data.\n✔ The default environment has been installed.\nusage: run_probes.py [-h] [-o OUTPUT] [--response RESPONSE]\n                     [--only {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--skip {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]]\n                     [--check-remote] [--allow GLOB [GLOB ...]]\n                     [--kind {dataset,component,study,skill}] [--overwrite]\n                     [--quiet]\n                     path\n\nRun the STAMPED probes over a checked-out research object.\n\n    run_probes.py <path> [-o probes.json] [--response response.json]\n                  [--only NAME ...] [--skip NAME ...] [--check-remote]\n                  [--kind dataset|component|study|skill]\n\nWrites the per-probe results, and optionally a response JSON (the format in\n``../stamped-conventions/references/response-format.md``) in which every item a\nprobe speaks to carries that probe's verdict and every other item is left\n``not-checked`` for the assessing session to judge.\nWithout a Git commit, ``-o`` retains a limitation receipt and exit code 2;\nno response draft is produced.\n\nThe probes never modify the object.  Nothing here replaces the judgement items:\na response straight out of this script is a draft, not an assessment.\n\npositional arguments:\n  path                  checked-out object to probe\n\noptions:\n  -h, --help            show this help message and exit\n  -o, --output OUTPUT   write the probe results here\n  --response RESPONSE   also write a draft response JSON here\n  --only {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]\n                        run just these probes\n  --skip {ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} [{ci-present,clone-weight,derived-have-records,entry-point,env-spec-tracked,inputs-untouched,large-in-annex,license-declared,modules-separated,no-abs-paths,platform-assumptions,run-env-linked,subdatasets-resolvable,tree-clean} ...]\n  --check-remote        contact submodule urls (network)\n  --allow GLOB [GLOB ...]\n                        paths no-abs-paths may skip, for files that genuinely\n                        have to carry a host path\n  --kind {dataset,component,study,skill}\n  --overwrite           replace an existing --response file instead of keeping\n                        its judged answers\n  --quiet\n✔ The default environment has been installed.\nusage: encode_response.py [-h]\n                          {items,validate,encode,decode,template,set,stamp,table} ...\n\nSTAMPED checklist responses: read the items, validate, encode, decode.\n\nThe vendored checklist in ``../checklist/`` is the only item source, and this\nscript is the only writer of a checklist-app URL.  See\n``../references/response-format.md`` for the response JSON and\n``../references/verdicts.md`` for the statuses.\n\nSubcommands\n-----------\nitems      list the pinned items (id, level, principle codes, text)\nset        answer one item in a response JSON, in place (what every run was\n           otherwise writing a merge script for)\ntable      the per-item markdown table response-format.md section 4 asks for\nstamp      fill harness, model, scope and kind; optionally hash a retained capture\nvalidate   check a response JSON against the pin and the app's constraints\nencode     response JSON -> checklist-app URL\ndecode     checklist-app URL -> response JSON (how a filled web form becomes\n           reference answers for calibration)\ntemplate   emit a response JSON skeleton with every item not-checked\n\nExit codes: 0 ok, 1 validation failed, 2 usage.\n\npositional arguments:\n  {items,validate,encode,decode,template,set,stamp,table}\n    items               list the pinned items\n    validate            check a response JSON\n    encode              response JSON -> URL\n    decode              URL -> response JSON\n    template            emit an all-not-checked response JSON\n    set                 answer one item in a response JSON, in place\n    stamp               fill harness, model, scope, kind and capture identity\n    table               print the per-item markdown table\n\noptions:\n  -h, --help            show this help message and exit\n✔ The default environment has been installed.\nusage: assessment.py [-h] --path PATH --entry ENTRY\n                     --outputs OUTPUTS [OUTPUTS ...] --workdir WORKDIR\n                     -o OUTPUT [--rtol RTOL] [--timeout TIMEOUT]\n                     [--max-get-gb MAX_GET_GB] [--in-container IN_CONTAINER]\n\nReplay documented outputs from a verified complete copy, never from HEAD.\n\noptions:\n  -h, --help            show this help message and exit\n  --path PATH\n  --entry ENTRY\n  --outputs OUTPUTS [OUTPUTS ...]\n  --workdir WORKDIR\n  -o, --output OUTPUT\n  --rtol RTOL\n  --timeout TIMEOUT\n  --max-get-gb MAX_GET_GB\n  --in-container IN_CONTAINER\nSTAMPED_DELIVERY_MANIFEST {'delivery_capture_sha256': None, 'capture_sha256': None, 'head': None, 'reference_limits': None, 'target': None}\nSTAMPED_OPERATIONAL_MANIFEST {'delivery_capture_sha256': None, 'capture_sha256': None, 'head': None, 'reference_limits': None, 'target': None}\n","exit_code":0,"status":"completed"}}
