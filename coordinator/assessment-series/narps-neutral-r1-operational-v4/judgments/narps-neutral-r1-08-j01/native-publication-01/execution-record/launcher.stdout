n      \"git_blob\": \"bd31939be6f91f9b7e4a2dfd9451288dab750fb1\",\n      \"mode\": \"120000\",\n      \"path\": \"input/data/sub-009_hypo1_cope.nii.gz\",\n      \"sha256\": \"33af129d8ba13cd4b6175089706c531471be1e0bd7ccd43ece10751c8cc3254c\",\n      \"source_mode\": \"120000\"\n    },\n    {\n      \"annex_key\": \"MD5E-s1828116--a08c26694622d29085d0ff477e29a87b.nii.gz\",\n      \"bytes\": 1828116,\n      \"git_blob\": \"923ba12454af9382d8df4efcd77a6c048b797edb\",\n      \"mode\": \"120000\",\n      \"path\": \"input/data/sub-011_hypo1_cope.nii.gz\",\n      \"sha256\": \"6f74dd449eefa6eff40ec00eb046ec7e8bb13c0b7c2ac1874155a9c166692352\",\n      \"source_mode\": \"120000\"\n    },\n    {\n      \"annex_key\": \"MD5E-s1760573--53bb0262f6b247c292c82ae02c9ac689.nii.gz\",\n      \"bytes\": 1760573,\n      \"git_blob\": \"5f90449dd485d490155712888fe08924680a7e37\",\n      \"mode\": \"120000\",\n      \"path\": \"input/data/sub-013_hypo1_cope.nii.gz\",\n      \"sha256\": \"bfa79b82f931d81d6387e82b8413f1f889a06f36275ba510554669c84a3c026f\",\n      \"source_mode\": \"120000\"\n    },\n    {\n      \"annex_key\": \"MD5E-s1805181--e17002345578911b778f67d3b8239fe7.nii.gz\",\n      \"bytes\": 1805181,\n      \"git_blob\": \"954e8d8f830a3e23a93baed7093bc88ce91dd054\",\n      \"mode\": \"120000\",\n      \"path\": \"input/data/sub-015_hypo1_cope.nii.gz\",\n      \"sha256\": \"5d98f6d74823516768659967f95ef43728584eab024c58af30987783515d7694\",\n      \"source_mode\": \"120000\"\n    },\n    {\n      \"annex_key\": \"MD5E-s1791857--94f1e4aa88173d0b274894166e19de7e.nii.gz\",\n      \"bytes\": 1791857,\n      \"git_blob\": \"9e45bb85100959d7f7b6384b927c33cbca8616d4\",\n      \"mode\": \"120000\",\n      \"path\": \"input/dat\n{\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex post-tool-use'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SessionEnd\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex session-end'\",\n            \"timeout\": 3\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then printf \\\"%s\\\\n\\\" \\\"{\\\\\\\"systemMessage\\\\\\\":\\\\\\\"Entire CLI is enabled but not installed or not on PATH. Installation guide: https://docs.entire.io/cli/installation#installation-methods\\\\\\\"}\\\"; exit 0; fi; exec entire hooks codex session-start'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex stop'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SubagentStart\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex subagent-start'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SubagentStop\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex subagent-stop'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex user-prompt-submit'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ]\n  }\n}\ntotal 16\ndrwxr-x---@  7 johnlee  staff  224 Oct 16 07:50 .\ndrwxr-xr-x@ 10 johnlee  staff  320 Oct 16 07:50 ..\n-rw-r--r--@  1 johnlee  staff   58 Oct 16 07:50 .gitignore\ndrwxr-x---@  3 johnlee  staff   96 Oct 16 07:50 logs\ndrwxr-x---@  3 johnlee  staff   96 Oct 16 07:50 metadata\n-rw-r--r--@  1 johnlee  staff  310 Oct 16 07:50 settings.local.json\ndrwxr-x---@  2 johnlee  staff   64 Oct 16 07:50 tmp\n{\n  \"enabled\": true,\n  \"strategy_options\": {\n    \"checkpoint_remote\": {\n      \"provider\": \"github\",\n      \"repo\": \"leej3/stamped-in-practice\"\n    },\n    \"push_sessions\": false\n  },\n  \"absolute_git_hook_path\": true,\n  \"telemetry\": false,\n  \"checkpoints\": {\n    \"primary\": {\n      \"type\": \"git-refs\"\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
