{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY'\nimport hashlib,json,os\nfrom pathlib import Path\nm=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nroot=Path(os.environ['STAMPED_JUDGE_TARGET'])\nchanges=[]; mismatches=[]; present=set()\nfor e in m['entries']:\n rel=e['path'].removeprefix('content/workspace/'); p=root/rel; present.add(rel)\n if e['kind']=='directory':\n  if not p.is_dir(): mismatches.append((rel,'missing/non-dir'))\n elif e['kind']=='symlink':\n  if not p.is_symlink(): mismatches.append((rel,'not-symlink'))\n  elif os.readlink(p)\"'!=e.get('\"'target'): mismatches.append((rel,'link-target'))\n elif e['kind']=='file':\n  if not p.is_file(): mismatches.append((rel,'missing/non-file'))\n  else:\n   h=hashlib.sha256(p.read_bytes()).hexdigest()\n   if h\"'!=e['\"'sha256']:\n    allowed=rel in {'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'}\n    (changes if allowed else mismatches).append((rel,h))\nextra=[]\nfor p in root.rglob('*'):\n rel=p.relative_to(root).as_posix()\n if rel not in present: extra.append(rel)\nprint('allowed metadata changes',changes)\nprint('other mismatches',mismatches)\nprint('unmanifested paths',extra[:30], 'count',len(extra))\nPY\ncat \\\"\"'$STAMPED_JUDGE_TARGET/.git/HEAD\"; rg --files -g '\"'README*' -g 'Makefile' -g '*requirements*' -g 'pyproject.toml' -g 'environment.yml' -g 'Dockerfile' \\\"\"'$STAMPED_JUDGE_TARGET\" '","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY'\nimport hashlib,json,os\nfrom pathlib import Path\nm=json.load(open(os.environ['STAMPED_DELIVERY_MANIFEST']))\nroot=Path(os.environ['STAMPED_JUDGE_TARGET'])\nchanges=[]; mismatches=[]; present=set()\nfor e in m['entries']:\n rel=e['path'].removeprefix('content/workspace/'); p=root/rel; present.add(rel)\n if e['kind']=='directory':\n  if not p.is_dir(): mismatches.append((rel,'missing/non-dir'))\n elif e['kind']=='symlink':\n  if not p.is_symlink(): mismatches.append((rel,'not-symlink'))\n  elif os.readlink(p)\"'!=e.get('\"'target'): mismatches.append((rel,'link-target'))\n elif e['kind']=='file':\n  if not p.is_file(): mismatches.append((rel,'missing/non-file'))\n  else:\n   h=hashlib.sha256(p.read_bytes()).hexdigest()\n   if h\"'!=e['\"'sha256']:\n    allowed=rel in {'.git/annex/keysdb/db','.git/annex/keysdb/db-shm','.git/annex/keysdb/db-wal'}\n    (changes if allowed else mismatches).append((rel,h))\nextra=[]\nfor p in root.rglob('*'):\n rel=p.relative_to(root).as_posix()\n if rel not in present: extra.append(rel)\nprint('allowed metadata changes',changes)\nprint('other mismatches',mismatches)\nprint('unmanifested paths',extra[:30], 'count',len(extra))\nPY\ncat \\\"\"'$STAMPED_JUDGE_TARGET/.git/HEAD\"; rg --files -g '\"'README*' -g 'Makefile' -g '*requirements*' -g 'pyproject.toml' -g 'environment.yml' -g 'Dockerfile' \\\"\"'$STAMPED_JUDGE_TARGET\" '","aggregated_output":"allowed metadata changes [('.git/annex/keysdb/db', '233c0be3e02857e0fbf47b00b8a94de3e9126529bee41b2491286aef7372be80')]\nother mismatches [('content/workspace', 'missing/non-dir'), ('input/data/sub-001_hypo1_cope.nii.gz', 'link-target'), ('input/data/sub-003_hypo1_cope.nii.gz', 'link-target'), ('input/data/sub-005_hypo1_cope.nii.gz', 'link-target'), ('input/data/sub-009_hypo1_cope.nii.gz', 'link-target'), ('input/data/sub-011_hypo1_cope.nii.gz', 'link-target'), ('inp