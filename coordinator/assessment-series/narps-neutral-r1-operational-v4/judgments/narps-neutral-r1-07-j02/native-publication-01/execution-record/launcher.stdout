{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"{ printf 'COMMAND: python integrity compare (corrected manifest key: link_target); operational workspace only\\\\n'; \\\"\"'$STAMPED_ASSESSMENT_PYTHON\" - <<'\"'PY'\nimport hashlib,json,os,stat\nfrom pathlib import Path\nm=json.load(open(os.environ[\\\"STAMPED_OPERATIONAL_MANIFEST\\\"]))\nroot=Path(os.environ[\\\"STAMPED_JUDGE_TARGET\\\"]); changes=[]; checked=0\nfor e in m[\\\"entries\\\"]:\n p=e[\\\"path\\\"]\n if not p.startswith(\\\"content/workspace/\\\"): continue\n rel=p[len(\\\"content/workspace/\\\"):]; q=root/rel\n try: st=q.lstat()\n except FileNotFoundError:\n  changes.append({\\\"path\\\":rel,\\\"change\\\":\\\"missing\\\"}); continue\n checked+=1; kind=e.get(\\\"kind\\\")\n if kind==\\\"file\\\":\n  if not stat.S_ISREG(st.st_mode): changes.append({\\\"path\\\":rel,\\\"change\\\":\\\"kind\\\",\\\"expected\\\":kind})\n  else:\n   h=hashlib.sha256(q.read_bytes()).hexdigest()\n   if h\"'!=e.get(\"sha256\"): changes.append({\"path\":rel,\"change\":\"sha256\",\"expected\":e.get(\"sha256\"),\"observed\":h})\n elif kind==\"symlink\":\n  t=os.readlink(q) if stat.S_ISLNK(st.st_mode) else None\n  if t!=e.get(\"link_target\"): changes.append({\"path\":rel,\"change\":\"link_target\",\"expected\":e.get(\"link_target\"),\"observed\":t})\n elif kind==\"directory\" and not stat.S_ISDIR(st.st_mode): changes.append({\"path\":rel,\"change\":\"kind\",\"expected\":kind})\n if kind in (\"file\",\"symlink\",\"directory\") and stat.S_IMODE(st.st_mode)!=e.get(\"mode\"):\n  changes.append({\"path\":rel,\"change\":\"mode\",\"expected\":e.get(\"mode\"),\"observed\":stat.S_IMODE(st.st_mode)})\nallowed={\".git/annex/keysdb/db\",\".git/annex/keysdb/db-shm\",\".git/annex/keysdb/db-wal\"}\nresult={\"checked_manifest_entries\":checked,\"change_count\":len(changes),\"changes\":changes,\n \"classified_operational_metadata_only\":bool(changes) and all(x[\"path\"] in allowed for x in changes),\n \"metadata_logical_equivalence\":\"not established\"}\n(Path(os.environ[\"STAMPED_JUDGE_OUTPUT\"])/\"integrity-comparison.json\").write_text(json.dumps(result,indent=2)+\"'\"\\\\n\\\")\nprint(json.dumps(result,indent=2))\nPY\n} > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/integrity-compare-corrected.txt\" 2>&1\ncat \"$STAMPED_JUDGE_OUTPUT/integrity-comparison.json\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
