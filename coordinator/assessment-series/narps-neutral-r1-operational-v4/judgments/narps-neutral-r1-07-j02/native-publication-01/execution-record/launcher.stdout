{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"{ printf 'COMMAND: frozen scientific judgment validator validate scientific-judgment.json --workspace output --delivery-manifest canonical manifest\\\\n'; \\\"\"'$STAMPED_ASSESSMENT_PYTHON\" - <<'\"'PY'\nimport hashlib,json,os\nfrom pathlib import Path\nroot=Path(os.environ[\\\"STAMPED_JUDGE_OUTPUT\\\"]); report=root/\\\"assessment-report.md\\\"\nlines=report.read_text().splitlines()\ndef excerpt(s):\n hits=[i for i,x in enumerate(lines,1) if s in x]\n if len(hits)\"'!=1: raise SystemExit(f\"expected one exact line for {s!r}, got {hits}\")\n return {\"quote\":s,\"start_line\":hits[0],\"end_line\":hits[0]}\nadequacy=\"**Scientific adequacy: supported.**\"\nhyp=\"We found no support for a positive gain effect in vmPFC in the equal-indifference group under whole-brain familywise correction.\"\nrecord={\"schema_version\":1,\n \"delivery_capture_sha256\":\"a870dc3c816f624dcd1ecd9e513fe56b76cf182e109a2f95963749235a4df8d7\",\n \"scientific_adequacy\":\"supported\",\n \"report\":{\"path\":\"assessment-report.md\",\"sha256\":hashlib.sha256(report.read_bytes()).hexdigest()},\n \"adequacy_evidence\":excerpt(adequacy),\n \"hypothesis_conclusion\":excerpt(hyp)}\n(root/\"scientific-judgment.json\").write_text(json.dumps(record,indent=2)+\"'\"\\\\n\\\")\nPY\n\\\"\"'$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_SCIENTIFIC_JUDGMENT_VALIDATOR\" validate scientific-judgment.json --workspace \"$STAMPED_JUDGE_OUTPUT\" --delivery-manifest \"$STAMPED_DELIVERY_MANIFEST\"; } > \"$STAMPED_JUDGE_OUTPUT/commands/scientific-validation.txt\" 2>&1\ncat \"$STAMPED_JUDGE_OUTPUT/commands/scientific-validation.txt\"\ncat \"$STAMPED_JUDGE_OUTPUT/scientific-judgment.json\"\n\"$STAMPED_ASSESSMENT_PYTHON\" \"$STAMPED_ASSESSMENT_RUNNER\" validate \"$STAMPED_JUDGE_OUTPUT/response.json\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
