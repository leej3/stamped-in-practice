{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"{ printf 'COMMAND: complete operational path-set and byte comparison against initial operational manifest\\\\n'; \\\"\"'$STAMPED_ASSESSMENT_PYTHON\" - <<'\"'PY'\nimport hashlib,json,os,stat\nfrom pathlib import Path\nm=json.load(open(os.environ[\\\"STAMPED_OPERATIONAL_MANIFEST\\\"]))\nroot=Path(os.environ[\\\"STAMPED_JUDGE_TARGET\\\"])\nentries={}\nfor e in m[\\\"entries\\\"]:\n p=e[\\\"path\\\"]\n if p.startswith(\\\"content/workspace/\\\"): entries[p[len(\\\"content/workspace/\\\"):]]=e\nactual=set()\nfor q in root.rglob(\\\"*\\\"):\n rel=q.relative_to(root).as_posix()\n actual.add(rel)\nmissing=sorted(set(entries)-actual); extra=sorted(actual-set(entries)); changes=[]\nfor rel,e in entries.items():\n q=root/rel\n if not q.exists() and not q.is_symlink(): continue\n st=q.lstat(); kind=e[\\\"kind\\\"]\n if kind==\\\"file\\\":\n  if not stat.S_ISREG(st.st_mode): changes.append({\\\"path\\\":rel,\\\"change\\\":\\\"kind\\\"})\n  else:\n   h=hashlib.sha256(q.read_bytes()).hexdigest()\n   if h\"'!=e[\"sha256\"]: changes.append({\"path\":rel,\"change\":\"sha256\",\"expected\":e[\"sha256\"],\"observed\":h})\n elif kind==\"symlink\":\n  t=os.readlink(q) if stat.S_ISLNK(st.st_mode) else None\n  if t!=e[\"link_target\"]: changes.append({\"path\":rel,\"change\":\"link_target\",\"expected\":e[\"link_target\"],\"observed\":t})\n elif kind==\"directory\" and not stat.S_ISDIR(st.st_mode): changes.append({\"path\":rel,\"change\":\"kind\"})\n if stat.S_IMODE(st.st_mode)!=e[\"mode\"]: changes.append({\"path\":rel,\"change\":\"mode\"})\nallowed={\".git/annex/keysdb/db\",\".git/annex/keysdb/db-shm\",\".git/annex/keysdb/db-wal\"}\nresult={\"expected_paths\":len(entries),\"actual_paths\":len(actual),\"missing\":missing,\"extra\":extra,\"changes\":changes,\n \"only_classified_metadata_changed\":not missing and not extra and bool(changes) and all(x[\"path\"] in allowed for x in changes),\n \"logical_database_equivalence\":\"not established\"}\n(Path(os.environ[\"STAMPED_JUDGE_OUTPUT\"])/\"integrity-comparison.json\").write_text(json.dumps(result,indent=2)+\"'\"\\\\n\\\")\nprint(json.dumps(result,indent=2))\nPY\n} > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/integrity-compare-final.txt\" 2>&1\ncat \"$STAMPED_JUDGE_OUTPUT/integrity-comparison.json\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
