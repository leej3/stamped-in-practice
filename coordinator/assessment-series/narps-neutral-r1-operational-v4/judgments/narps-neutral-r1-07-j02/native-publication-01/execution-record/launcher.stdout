{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"{ printf 'COMMAND: python integrity compare against operational manifest (operational workspace only)\\\\n'; \\\"\"'$STAMPED_ASSESSMENT_PYTHON\" - <<'\"'PY'\nimport hashlib, json, os, stat\nfrom pathlib import Path\nmanifest=json.load(open(os.environ[\\\"STAMPED_OPERATIONAL_MANIFEST\\\"]))\nroot=Path(os.environ[\\\"STAMPED_JUDGE_TARGET\\\"])\nchanges=[]; checked=0\nfor e in manifest[\\\"entries\\\"]:\n    p=e[\\\"path\\\"]\n    prefix=\\\"content/workspace/\\\"\n    if not p.startswith(prefix): continue\n    rel=p[len(prefix):]; path=root/rel\n    try: st=path.lstat()\n    except FileNotFoundError:\n        changes.append({\\\"path\\\":rel,\\\"change\\\":\\\"missing\\\"}); continue\n    checked+=1\n    kind=e.get(\\\"kind\\\")\n    if kind==\\\"file\\\" and stat.S_ISREG(st.st_mode):\n        h=hashlib.sha256(path.read_bytes()).hexdigest()\n        if h\"'!=e.get(\"sha256\"): changes.append({\"path\":rel,\"change\":\"sha256\",\"expected\":e.get(\"sha256\"),\"observed\":h})\n    elif kind==\"symlink\" and stat.S_ISLNK(st.st_mode):\n        target=os.readlink(path)\n        if target!=e.get(\"target\"): changes.append({\"path\":rel,\"change\":\"symlink-target\",\"expected\":e.get(\"target\"),\"observed\":target})\n    elif kind==\"directory\" and not stat.S_ISDIR(st.st_mode):\n        changes.append({\"path\":rel,\"change\":\"kind\",\"expected\":\"directory\",\"observed\":stat.S_IFMT(st.st_mode)})\n    if kind in (\"file\",\"directory\",\"symlink\") and stat.S_IMODE(st.st_mode)!=e.get(\"mode\"):\n        changes.append({\"path\":rel,\"change\":\"mode\",\"expected\":e.get(\"mode\"),\"observed\":stat.S_IMODE(st.st_mode)})\nresult={\"checked_manifest_entries\":checked,\"change_count\":len(changes),\"changes\":changes,\n        \"classified_operational_metadata_only\":bool(changes) and all(x[\"path\"] in {\".git/annex/keysdb/db\",\".git/annex/keysdb/db-shm\",\".git/annex/keysdb/db-wal\"} for x in changes)}\nout=Path(os.environ[\"STAMPED_JUDGE_OUTPUT\"])/\"integrity-comparison.json\"\nout.write_text(json.dumps(result,indent=2)+\"'\"\\\\n\\\")\nprint(json.dumps(result,indent=2))\nPY\n} > \\\"\"'$STAMPED_JUDGE_OUTPUT/commands/integrity-compare.txt\" 2>&1\ncat \"$STAMPED_JUDGE_OUTPUT/integrity-comparison.json\"\n\"$STAMPED_ASSESSMENT_PYTHON\" - <<'\"'PY'\nimport json, hashlib, os\np=os.environ[\\\"STAMPED_DELIVERY_MANIFEST\\\"]\nprint(\\\"canonical_manifest_sha256\\\",hashlib.sha256(open(p,\\\"rb\\\").read()).hexdigest())\nd=json.load(open(p)); print(\\\"original_head\\\",d[\\\"head_commit\\\"],\\\"capture_status\\\",d[\\\"capture_status\\\"])\nfor e in d[\\\"entries\\\"]:\n  if e.get(\\\"path\\\",\\\"\\\").startswith(\\\"content/workspace/\\\") and any(e[\\\"path\\\"].endswith(x) for x in [\\\"scientific-report.md\\\",\\\"research-protocol.md\\\",\\\"README.md\\\",\\\"analysis/analyze.py\\\",\\\"results/primary_v2_template_mask/summary.json\\\",\\\"input/sources.json\\\",\\\"input/upstream-methods.md\\\",\\\"input/study-task.md\\\"]): print(e[\\\"path\\\"],e.get(\\\"sha256\\\"))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
